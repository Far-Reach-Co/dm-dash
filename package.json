{
  "name": "dm_dash",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "scripts": {
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:tools": "npm run build:server",
    "build:client": "rollup --config rollup.config.mjs",
    "build:client:watch": "rollup --config rollup.config.mjs --watch",
    "start": "node ./dist/server.js",
    "dev": "bash ./scripts/dev/start_dev.sh",
    "dev:server": "node --watch --watch-path=dist ./dist/server.js",
    "dev:tsc": "tsc -p tsconfig.json --watch",
    "dev:client": "npm run build:client:watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:css": "stylelint \"public/css/base/variables.css\" \"public/css/components/{dashboard.css,dashboard-core.css,dashboard-settings.css,dashboard-wyrld.css,pack-primitives.css,sidebar.css,sidebar-packs.css,upload-queue.css}\" \"public/css/features/{info.css,info-base.css,info-srd-core.css,info-srd-advanced.css,library.css,library-packs.css,vtt.css}\"",
    "lint:css:all": "stylelint \"public/css/**/*.css\"",
    "lint": "npm run typecheck",
    "test": "node --test",
    "check": "npm run lint && npm run test",
    "ops:preflight": "bash ./ops/preflight.sh",
    "ops:deploy": "bash ./ops/deploy.sh",
    "ops:deploy:no-restart": "DM_DASH_RESTART_SERVICES=0 bash ./ops/deploy.sh",
    "ops:rollback": "bash ./ops/rollback.sh",
    "ops:cleanup-remote": "bash ./ops/cleanup_remote.sh",
    "migrate:up": "bash ./scripts/ops/run_with_env.sh node-pg-migrate up",
    "migrate:down": "bash ./scripts/ops/run_with_env.sh node-pg-migrate down",
    "migrate:redo": "bash ./scripts/ops/run_with_env.sh node-pg-migrate redo",
    "migrate:create": "node-pg-migrate create",
    "sitemap": "tsx src/tools/generate-sitemap.ts",
    "sitemap:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/generate-sitemap.js",
    "indexnow:all": "bash ./scripts/ops/run_with_env.sh tsx src/tools/submitIndexNow.ts",
    "indexnow:all:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/submitIndexNow.js",
    "gsc:product-surface": "bash ./scripts/ops/run_with_env.sh tsx src/tools/reportProductSurfaceFromGsc.ts",
    "gsc:product-surface:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/reportProductSurfaceFromGsc.js",
    "srd:download": "tsx src/tools/download-5e-srd.ts",
    "srd:download:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/download-5e-srd.js",
    "srd:spell-class-index": "tsx src/tools/generateSpellClassLevelIndex.ts",
    "srd:spell-class-index:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/generateSpellClassLevelIndex.js",
    "srd:popular-pages:update": "bash ./scripts/ops/run_with_env.sh tsx src/tools/updateSrdPopularPagesFromGsc.ts",
    "srd:popular-pages:update:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/updateSrdPopularPagesFromGsc.js",
    "stripe:catalog:live": "npm run build:server && bash ./scripts/ops/run_with_env.sh node ./dist/tools/setupStripeLiveCatalog.js",
    "srd:hotspots": "bash ./scripts/ops/run_with_env.sh tsx src/tools/reportSrdQuestionHotspots.ts",
    "srd:hotspots:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/reportSrdQuestionHotspots.js",
    "email:product-update": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/sendProductUpdateEmail.js",
    "email:monthly-report": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/sendMonthlyLogReportEmail.js",
    "email:monthly-report:force": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/sendMonthlyLogReportEmail.js --force",
    "email:srd-daily-report": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/sendDailySrdIntentReportEmail.js",
    "email:srd-daily-report:force": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/sendDailySrdIntentReportEmail.js --force",
    "backup:db": "bash ./scripts/ops/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js",
    "backup:db:once": "bash ./scripts/ops/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js --once",
    "backup:db:once:full": "bash ./scripts/ops/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js --once --full",
    "backup:db:restore-check": "bash ./scripts/ops/run_with_env.sh node ./dist/lib/db_backups/restoreCheck.js",
    "prod:backup:db:once": "npm run backup:db:once",
    "prod:backup:db:once:full": "npm run backup:db:once:full",
    "prod:backup:db:restore-check": "npm run backup:db:restore-check",
    "prod:email:monthly-report": "npm run email:monthly-report",
    "prod:email:monthly-report:force": "npm run email:monthly-report:force",
    "guest-sandbox:import-images": "bash ./scripts/ops/run_with_env.sh tsx src/tools/import-guest-sandbox-images.ts",
    "guest-sandbox:import-images:dry": "bash ./scripts/ops/run_with_env.sh tsx src/tools/import-guest-sandbox-images.ts --dry-run",
    "guest-sandbox:import-images:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/import-guest-sandbox-images.js",
    "guest-sandbox:import-images:dry:prod": "bash ./scripts/ops/run_with_env.sh node ./dist/tools/import-guest-sandbox-images.js --dry-run"
  },
  "author": "Julian Ranieri",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/cloudfront-signer": "^3.993.0",
    "@mistralai/mistralai": "^1.14.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.1",
    "compression": "^1.8.1",
    "connect-pg-simple": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "discord-interactions": "^3.4.0",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^2.0.2",
    "node-fetch": "^2.3.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^8.0.1",
    "pg": "^8.8.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "redis": "^4.7.1",
    "sharp": "^0.32.1",
    "sitemap": "^9.0.0",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.1.4",
    "@types/node-fetch": "^2.6.4",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.6.6",
    "@types/uuid": "^9.0.1",
    "@types/validator": "^13.9.0",
    "dotenv-cli": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "rollup": "^3.28.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
