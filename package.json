{
  "name": "dm_dash",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "nodemon -q ./dist/server.js",
    "migrate:up": "bash ./scripts/run_with_env.sh node-pg-migrate up",
    "migrate:down": "bash ./scripts/run_with_env.sh node-pg-migrate down",
    "migrate:redo": "bash ./scripts/run_with_env.sh node-pg-migrate redo",
    "migrate:create": "node-pg-migrate create",
    "sitemap": "tsx tools/generate-sitemap.ts",
    "backfill:equipment-desc": "bash ./scripts/run_with_env.sh tsx tools/backfill-equipment-descriptions.ts",
    "srd:download": "tsx tools/download-5e-srd.ts",
    "email:product-update": "bash ./scripts/run_with_env.sh node ./dist/tools/sendProductUpdateEmail.js",
    "backup:db": "bash ./scripts/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js",
    "backup:db:once": "bash ./scripts/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js --once",
    "backup:db:once:full": "bash ./scripts/run_with_env.sh node ./dist/lib/db_backups/pgBackup.js --once --full",
    "backup:db:restore-check": "bash ./scripts/run_with_env.sh node ./dist/lib/db_backups/restoreCheck.js",
    "prod:backup:db:once": "npm run backup:db:once",
    "prod:backup:db:once:full": "npm run backup:db:once:full",
    "prod:backup:db:restore-check": "npm run backup:db:restore-check",
    "guest-sandbox:import-images": "bash ./scripts/run_with_env.sh tsx tools/import-guest-sandbox-images.ts",
    "guest-sandbox:import-images:dry": "bash ./scripts/run_with_env.sh tsx tools/import-guest-sandbox-images.ts --dry-run"
  },
  "author": "Julian Ranieri",
  "license": "ISC",
  "dependencies": {
    "@mistralai/mistralai": "^1.14.0",
    "@rollup/plugin-terser": "^0.4.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "^2.1299.0",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.1",
    "compression": "^1.8.1",
    "connect-pg-simple": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "discord-interactions": "^3.4.0",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.3.1",
    "node-pg-migrate": "^6.2.2",
    "nodemailer": "^6.9.0",
    "nodemon": "^2.0.20",
    "pg": "^8.8.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "pm2": "^6.0.14",
    "redis": "^4.7.1",
    "sharp": "^0.32.1",
    "sitemap": "^9.0.0",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.7",
    "@types/express-validator": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.1.4",
    "@types/node-fetch": "^2.6.4",
    "@types/nodemailer": "^6.4.7",
    "@types/pg": "^8.6.6",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^9.0.1",
    "@types/validator": "^13.9.0",
    "dotenv-cli": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "rollup": "^3.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
