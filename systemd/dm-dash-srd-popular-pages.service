[Unit]
Description=dm-dash weekly SRD popular pages sync
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/dm-dash
Environment=NODE_ENV=production
EnvironmentFile=/root/dm-dash/.env
ExecStart=/root/.nvm/versions/node/v24.13.0/bin/node /root/dm-dash/dist/tools/updateSrdPopularPagesFromGsc.js
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
