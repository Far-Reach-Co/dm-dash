SERVER_ENV=dev
PORT=4000
SECRET_KEY=replace_with_random_secret
PUBLIC_BASE_URL=http://localhost:4000

REDIS_URL=redis://localhost:6379

# Prefer DATABASE_URL; PG_* values are fallback when DATABASE_URL is unset.
DATABASE_URL=postgres://username:password@localhost:5432/database_name
PG_SSL=
PG_SSL_REJECT_UNAUTHORIZED=
PG_USER=
PG_HOST=
PG_DB=
PG_PW=
PG_PORT=5432

MAIL_USERNAME=
MAIL_PASSWORD=
# Optional comma-separated override for internal affiliate commission alerts.
# Defaults to farreachco@gmail.com when unset.
AFFILIATE_COMMISSION_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_DOMAIN=
CLOUDFRONT_KEY_ID=

DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=
DB_BACKUP_INTERVAL_MS=86400000
DB_BACKUP_ALERT_EMAIL=ops@example.com
DB_BACKUP_MODE=data-only

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_PRICE_LOOKUP_PRO_USER_MONTHLY=pro_user_monthly
STRIPE_PRICE_LOOKUP_PRO_USER_YEARLY=pro_user_yearly
STRIPE_PRICE_LOOKUP_PRO_WYRLD_MONTHLY=pro_wyrld_monthly
STRIPE_PRICE_LOOKUP_PRO_WYRLD_YEARLY=pro_wyrld_yearly
# Optional direct IDs (override lookup resolution)
STRIPE_PRICE_ID_PRO_USER_MONTHLY=
STRIPE_PRICE_ID_PRO_USER_YEARLY=
STRIPE_PRICE_ID_PRO_WYRLD_MONTHLY=
STRIPE_PRICE_ID_PRO_WYRLD_YEARLY=
MISTRAL_API_KEY=

BOT_APP_ID=
BOT_PUBLIC_KEY=
DISCORD_TOKEN=

GUEST_SANDBOX_BUCKET=wyrld
GUEST_SANDBOX_FOLDER=images
