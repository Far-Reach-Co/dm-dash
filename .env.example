SERVER_ENV=dev
PORT=4000
SECRET_KEY=replace_with_random_secret
PUBLIC_BASE_URL=http://localhost:4000

REDIS_URL=redis://localhost:6379

# Prefer DATABASE_URL; PG_* values are fallback when DATABASE_URL is unset.
DATABASE_URL=postgres://username:password@localhost:5432/database_name
PG_SSL=
PG_SSL_REJECT_UNAUTHORIZED=
PG_USER=
PG_HOST=
PG_DB=
PG_PW=
PG_PORT=5432

MAIL_USERNAME=
MAIL_PASSWORD=
# Optional comma-separated override for internal affiliate commission alerts.
# In prod, defaults to farreachco@gmail.com when unset.
# In dev, defaults to no recipients when unset.
# Set to off/none/disabled to force-disable.
AFFILIATE_COMMISSION_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLOUDFRONT_DISTRIBUTION_DOMAIN=
CLOUDFRONT_KEY_ID=

DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=
DB_BACKUP_INTERVAL_MS=86400000
DB_BACKUP_ALERT_EMAIL=ops@example.com
DB_BACKUP_MODE=data-only

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional separate signing secret for a Connected Accounts webhook endpoint.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Optional: default country when creating Stripe Connect Express accounts.
STRIPE_CONNECT_ACCOUNT_COUNTRY=US
STRIPE_PRICE_LOOKUP_PRO_USER_MONTHLY=pro_user_monthly
STRIPE_PRICE_LOOKUP_PRO_USER_YEARLY=pro_user_yearly
STRIPE_PRICE_LOOKUP_PRO_WYRLD_MONTHLY=pro_wyrld_monthly
STRIPE_PRICE_LOOKUP_PRO_WYRLD_YEARLY=pro_wyrld_yearly
# Optional direct IDs (override lookup resolution)
STRIPE_PRICE_ID_PRO_USER_MONTHLY=
STRIPE_PRICE_ID_PRO_USER_YEARLY=
STRIPE_PRICE_ID_PRO_WYRLD_MONTHLY=
STRIPE_PRICE_ID_PRO_WYRLD_YEARLY=
# Coupon ID applied automatically when an affiliate code is used at checkout.
# Configure this coupon in Stripe as the desired buyer discount (e.g. 20%).
STRIPE_AFFILIATE_DISCOUNT_COUPON_ID=
MISTRAL_API_KEY=

# Optional: Google Search Console sync for SRD Popular Pages.
# Set GSC_SITE_URL to either a URL property (ex: https://farreachco.com/)
# or a domain property (ex: sc-domain:farreachco.com).
GSC_SITE_URL=
# OAuth client credentials + refresh token with Search Console read scope.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# Optional: IndexNow bulk sitemap submission.
# Set INDEXNOW_KEY, then run `npm run indexnow:all:prod`.
INDEXNOW_KEY=
# Optional override; defaults to https://farreachco.com.
INDEXNOW_SITE_URL=
# Optional path template for the public key file. `{key}` is replaced automatically.
INDEXNOW_KEY_PATH=/{key}.txt
# Optional endpoint override; defaults to https://api.indexnow.org/indexnow.
INDEXNOW_ENDPOINT=

BOT_APP_ID=
BOT_PUBLIC_KEY=
DISCORD_TOKEN=

GUEST_SANDBOX_BUCKET=wyrld
GUEST_SANDBOX_FOLDER=images
