<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fast Virtual Tabletop, Campaign Hub, and Tabletop Radio | Far Reach Co.</title>
  <meta name="description" content="Run tabletop RPG sessions in your browser with maps, tokens, and dice. Add shared music, flexible D&amp;D 5E sheets, and a home for your campaign." />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/" />
  <meta property="og:title" content="Fast Virtual Tabletop, Campaign Hub, and Tabletop Radio | Far Reach Co." />
  <meta property="og:description" content="Run tabletop RPG sessions in your browser with maps, tokens, and dice. Add shared music, flexible D&amp;D 5E sheets, and a home for your campaign." />
  <meta property="og:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Fast Virtual Tabletop, Campaign Hub, and Tabletop Radio | Far Reach Co." />
  <meta name="twitter:description" content="Run tabletop RPG sessions in your browser with maps, tokens, and dice. Add shared music, flexible D&amp;D 5E sheets, and a home for your campaign." />
  <meta name="twitter:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Far Reach Co.",
      "url": "https://farreachco.com",
      "description": "Browser-based tabletop RPG tools with maps, tokens, dice, shared music, D&D 5E character sheets, and campaign homes in Wyrlds",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Invite-link Virtual Tabletop (VTT) with no-signup player joining",
        "D&D 5E Character Sheet Management",
        "Persistent Campaign Management and World Building Tools (Wyrlds)",
        "Complete D&D 5E SRD Reference Material (1340+ monsters, spells, classes, equipment)",
        "Records System for lore and notes",
        "Calendar System",
        "Asset Management for tokens and maps",
        "Far Reach Radio tabletop audio streaming",
        "Discord Bot Integration"
      ],
      "author": {
        "@type": "Organization",
        "name": "Far Reach Co."
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Tabletop RPG players, Dungeon Masters, Game Masters"
      }
    }
  </script>

  <link rel="stylesheet" href="./style.css" />
  <link rel="stylesheet" href="/css/features/landing.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
</head>
<%- include('./partials/google') %>

<body class="landing-page">
  <%- include('./partials/nav') %>

  <main class="landing-main">
    <section class="landing-section landing-hero">
      <div class="landing-container landing-hero__content">

        <img class="landing-hero__logo animate-scale-on-scroll" src="/assets/landing/mainlogo.webp" alt="Far Reach Co Logo" />
        <h1 class="animate-on-scroll">Less setup. More adventure.</h1>
        <p class="landing-hero__lead animate-on-scroll">
          Run your next tabletop session with maps, tokens, and dice in your browser. Share a link and your players can join without creating an account.
        </p>
        <div class="landing-hero__links animate-on-scroll">
          <a class="landing-btn landing-btn--subtle" href="/vtt/guest/start">Try the tabletop</a>
          <a href="#tools">Explore the tools</a>
        </div>
        <p><small>No account needed to try the sandbox.</small></p>
      </div>
    </section>

    <section id="tools" class="landing-section landing-vtt">
      <div class="landing-container">
        <div class="landing-title-block animate-on-scroll">
          <h2>Bring your next encounter to life</h2>
          <p>Set out a battle map, place your tokens, and bring the group together. Draw on the scene, control what players can see, and roll dice without leaving the tabletop.</p>
          <p>From a last-minute one-shot to your weekly game, keep the action moving with tools that leave room for your imagination.</p>
        </div>

        <div class="vtt-showcase animate-scale-on-scroll">
          <div class="vtt-showcase__frame">
            <div class="vtt-showcase__toolbar">
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
            </div>
            <img class="vtt-showcase__img" src="/assets/landing/vtt_screenshot.png" alt="Far Reach Co. Virtual Tabletop — tokens, maps, dice rolls, and asset management" loading="lazy" />
          </div>
        </div>

        <a class="landing-btn" href="/simple-virtual-tabletop-no-player-accounts">Explore the virtual tabletop</a>
        <div class="landing-hero__links animate-on-scroll" style="margin-top: 10px;">
          <a href="/vtt-guide">Read the VTT guide</a>
        </div>
      </div>
    </section>

    <section class="landing-section landing-character">
      <div class="landing-container landing-character__grid">
        <div class="landing-character__copy animate-left-on-scroll">
          <img class="landing-character__dice" src="/assets/landing/dice.svg" alt="" />
          <h2>Your character, ready for whatever happens</h2>
          <p>
            Keep spells, attacks, equipment, and notes close at hand. Edit your D&amp;D 5E sheet during play, fill in SRD details automatically, and let calculated attack bonuses follow your changing stats.</p>
          <p>There’s room for homebrew—and whatever your party does next.
          </p>
          <a class="landing-btn landing-btn--subtle" href="/dnd-5e-character-sheets">Explore character sheets</a>
        </div>
        <img class="landing-character__art animate-right-on-scroll" src="/assets/landing/character.png" alt="D&D character artwork" loading="lazy" />
      </div>
    </section>

    <section class="landing-section landing-radio">
      <div class="landing-container">
        <div class="landing-radio__card animate-on-scroll">
          <div class="landing-radio__icon" aria-hidden="true">
            <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
              <circle cx="40" cy="40" r="36" stroke="var(--orange2)" stroke-width="1.5" opacity="0.25" />
              <circle cx="40" cy="40" r="26" stroke="var(--blue6)" stroke-width="1" opacity="0.35" />
              <circle cx="40" cy="40" r="16" stroke="var(--orange3)" stroke-width="1.5" opacity="0.5" />
              <circle cx="40" cy="40" r="5" fill="var(--orange2)" />
              <path d="M52 28a18 18 0 0 1 0 24" stroke="var(--orange3)" stroke-width="2" stroke-linecap="round" />
              <path d="M56 22a26 26 0 0 1 0 36" stroke="var(--blue6)" stroke-width="1.5" stroke-linecap="round" />
              <path d="M60 16a34 34 0 0 1 0 48" stroke="var(--orange2)" stroke-width="1" stroke-linecap="round" />
            </svg>
          </div>
          <p class="landing-kicker">Far Reach Radio</p>
          <h2>Set the scene. Share the soundtrack.</h2>
          <p>
            A quiet tavern. An unfamiliar road. Something moving in the dark.</p>
          <p>Choose a playlist and share one listener link. Far Reach Radio keeps your group’s music in sync, with no player accounts or Discord bot setup required.
          </p>
          <div class="landing-radio__links">
            <a class="landing-btn landing-btn--subtle" href="/radio">Explore Far Reach Radio</a>
            <a class="landing-btn landing-btn--subtle" href="https://radio.farreachco.com" target="_blank" rel="noopener">Open Radio</a>
          </div>
        </div>
      </div>
    </section>

    <section class="landing-section landing-quest">
      <div class="landing-container landing-quest__grid">
        <div class="landing-quest__media animate-left-on-scroll">
          <img class="landing-quest__scroll" src="/assets/landing/scroll_dice.webp" alt="Far Reach Co. visual style artwork" loading="lazy" />
        </div>

        <div class="landing-quest__copy animate-right-on-scroll">
          <h2>Give your campaign a home</h2>
          <p>
            Keep the adventure together between sessions.</p>
          <p>A Wyrld brings your campaign’s maps, notes, character sheets, calendars, and discussions into one shared space. Invite your group and return to the same campaign home each week.
          </p>
          <a class="landing-btn landing-btn--subtle" href="/wyrlds">Explore Wyrlds</a>
        </div>
      </div>
    </section>
    <section class="landing-section">
      <div class="landing-container landing-title-block">
        <h2>Your next session starts here</h2>
        <p>Open the sandbox and try the tabletop for yourself.</p>
        <a class="landing-btn" href="/vtt/guest/start">Try the tabletop</a>
        <p><small>No signup required.</small></p>
      </div>
    </section>
  </main>

  <%- include('./partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var els = document.querySelectorAll('.animate-on-scroll, .animate-scale-on-scroll, .animate-left-on-scroll, .animate-right-on-scroll');
      if (!els.length) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15
      });
      els.forEach(function(el) {
        observer.observe(el);
      });
    });
  </script>
</body>

</html>
