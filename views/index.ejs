<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. - Virtual Tabletop & D&D 5E Tools</title>
  <meta name="description" content="Free collaborative virtual tabletop and campaign management platform. Features include platform-agnostic VTT, D&D 5E character sheets, world building tools, complete SRD reference, and Discord integration. Play TTRPGs online with friends!" />
  <meta name="keywords" content="virtual tabletop, VTT, D&D 5E, character sheet, campaign management, 5e SRD, tabletop RPG, online TTRPG, dungeons and dragons, game master tools" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/" />
  <meta property="og:title" content="Far Reach Co. - Virtual Tabletop & D&D 5E Tools" />
  <meta property="og:description" content="Free collaborative virtual tabletop and campaign management platform. Platform-agnostic VTT, D&D 5E character sheets, and complete SRD reference." />
  <meta property="og:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Far Reach Co. - Virtual Tabletop & D&D 5E Tools" />
  <meta name="twitter:description" content="Free collaborative virtual tabletop and campaign management platform. Platform-agnostic VTT, D&D 5E character sheets, and complete SRD reference." />
  <meta name="twitter:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Far Reach Co.",
      "url": "https://farreachco.com",
      "description": "Free collaborative virtual tabletop and campaign management platform for tabletop RPGs with dedicated D&D 5E support",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Platform-agnostic Virtual Tabletop (VTT) with real-time collaboration",
        "D&D 5E Character Sheet Management",
        "Campaign Management and World Building Tools (Wyrlds)",
        "Complete D&D 5E SRD Reference Material (1340+ monsters, spells, classes, equipment)",
        "Records System for lore and notes",
        "Calendar and Clock System",
        "Asset Management for tokens and maps",
        "Discord Bot Integration"
      ],
      "author": {
        "@type": "Organization",
        "name": "Far Reach Co."
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Tabletop RPG players, Dungeon Masters, Game Masters"
      }
    }
  </script>

  <link rel="stylesheet" href="./style.css" />
  <link rel="stylesheet" href="/css/features/landing.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
</head>
<%- include('./partials/google') %>

<body class="landing-page">
  <%- include('./partials/nav') %>

  <main class="landing-main">
    <section class="landing-section landing-hero">
      <div class="landing-container landing-hero__content">
        <p class="landing-kicker animate-on-scroll">Built for storytellers, GMs, and players</p>
        <img class="landing-hero__logo animate-scale-on-scroll" src="/assets/landing/mainlogo.webp" alt="Far Reach Co Logo" />
        <p class="landing-hero__lead animate-on-scroll">
          Run your campaign from one polished workspace. Build worlds, manage D&D 5E sheets, and play on a real-time virtual tabletop that keeps your group focused on the story.
        </p>
        <div class="landing-hero__links animate-on-scroll">
          <a href="/what-is-frc">What is Far Reach Co?</a>
          <a href="/whats-new">Latest updates and feature highlights</a>
        </div>
        <img class="landing-hero__cta animate-on-scroll" src="/assets/landing/peli_signup.webp" alt="Create your free account" onclick="window.location = '/register'" />
      </div>
    </section>

    <section class="landing-section landing-vtt">
      <div class="landing-container">
        <div class="landing-title-block animate-on-scroll">
          <h1>Virtual Tabletop</h1>
          <p>Fast setup, focused play surface, and tools that stay out of the way when your session is live.</p>
        </div>

        <div class="vtt-showcase animate-scale-on-scroll">
          <div class="vtt-showcase__frame">
            <div class="vtt-showcase__toolbar">
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
            </div>
            <img class="vtt-showcase__img" src="/assets/landing/vtt_screenshot.png" alt="Far Reach Co. Virtual Tabletop — tokens, maps, dice rolls, and asset management" loading="lazy" />
          </div>
        </div>

        <a class="landing-btn" href="/vtt/guest/start">Try VTT Sandbox (No Signup)</a>
      </div>
    </section>

    <section class="landing-section landing-character">
      <div class="landing-container landing-character__grid">
        <div class="landing-character__copy animate-left-on-scroll">
          <img class="landing-character__dice" src="/assets/landing/dice.svg" alt="" />
          <h1>Character Sheets</h1>
          <p>
            Keep classes, spells, inventory, and combat details organized in a sheet designed for quick play decisions. Built for D&D 5E, optimized for real campaigns.
          </p>
        </div>
        <img class="landing-character__art animate-right-on-scroll" src="/assets/landing/character.png" alt="D&D character artwork" loading="lazy" />
      </div>
    </section>

    <section class="landing-section landing-quest">
      <div class="landing-container landing-quest__grid">
        <div class="landing-quest__media animate-left-on-scroll">
          <img class="landing-quest__scroll" src="/assets/landing/scroll_dice.webp" alt="Far Reach Co. visual style artwork" loading="lazy" />
        </div>

        <div class="landing-quest__copy animate-right-on-scroll">
          <h1>Our Personal Quest</h1>
          <p>
            We build for reliability, clarity, and momentum at the table. The mission is simple: remove friction so game masters and players can spend more time creating unforgettable adventures together.
          </p>
          <a class="landing-btn landing-btn--subtle" href="/about-us">Read More About Us</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('./partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var els = document.querySelectorAll('.animate-on-scroll, .animate-scale-on-scroll, .animate-left-on-scroll, .animate-right-on-scroll');
      if (!els.length) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15
      });
      els.forEach(function(el) {
        observer.observe(el);
      });
    });
  </script>
</body>

</html>
