  <meta name="keywords" content="virtual tabletop without accounts, no signup VTT, fast virtual tabletop setup, persistent campaign tabletop, online D&D no sign up, invite link tabletop RPG, GM focused virtual tabletop, tabletop audio streaming, RPG session music" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/" />
  <meta property="og:title" content="Fast Virtual Tabletop for GMs | Far Reach Co." />
  <meta property="og:description" content="Fast, GM-focused virtual tabletop with invite-link joining, persistent campaign management in Wyrlds, and synced tabletop audio streaming." />
  <meta property="og:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Fast Virtual Tabletop for GMs | Far Reach Co." />
  <meta name="twitter:description" content="Fast, GM-focused virtual tabletop with invite-link joining, persistent campaign management in Wyrlds, and synced tabletop audio streaming." />
  <meta name="twitter:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Far Reach Co.",
      "url": "https://farreachco.com",
      "description": "GM-focused virtual tabletop with no-signup player joins, persistent campaign management, and synced tabletop audio streaming",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Invite-link Virtual Tabletop (VTT) with no-signup player joining",
        "D&D 5E Character Sheet Management",
        "Persistent Campaign Management and World Building Tools (Wyrlds)",
        "Complete D&D 5E SRD Reference Material (1340+ monsters, spells, classes, equipment)",
        "Records System for lore and notes",
        "Calendar System",
        "Asset Management for tokens and maps",
        "Far Reach Radio tabletop audio streaming",
        "Discord Bot Integration"
      ],
      "author": {
        "@type": "Organization",
        "name": "Far Reach Co."
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Tabletop RPG players, Dungeon Masters, Game Masters"
      }
    }
  </script>

  <link rel="stylesheet" href="./style.css" />
  <link rel="stylesheet" href="/css/features/landing.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
</head>
<%- include('./partials/google') %>

<body class="landing-page">
  <%- include('./partials/nav') %>

  <main class="landing-main">
    <section class="landing-section landing-hero">
      <div class="landing-container landing-hero__content">
        <p class="landing-kicker animate-on-scroll">Built for storytellers, GMs, and players</p>
        <img class="landing-hero__logo animate-scale-on-scroll" src="/assets/landing/mainlogo.webp" alt="Far Reach Co Logo" />
        <p class="landing-hero__lead animate-on-scroll">
          Start playing online in minutes with a virtual tabletop your players can join by link, no account required. When your group goes long-term, move into persistent Wyrlds for campaign management.
        </p>
        <div class="landing-hero__links animate-on-scroll">
          <a href="/what-is-frc">Virtual tabletop without accounts: how it works</a>
          <a href="/radio">Tabletop audio streaming with Far Reach Radio</a>
        </div>
        <img class="landing-hero__cta animate-on-scroll" src="/assets/landing/peli_signup.webp" alt="Create your free account" onclick="window.location = '/register'" />
      </div>
    </section>

    <section class="landing-section landing-vtt">
      <div class="landing-container">
        <div class="landing-title-block animate-on-scroll">
          <h1>Fast Virtual Tabletop for GMs</h1>
          <p>Start playing D&amp;D online in minutes. Share one invite link and players can join instantly without signup.</p>
        </div>

        <div class="vtt-showcase animate-scale-on-scroll">
          <div class="vtt-showcase__frame">
            <div class="vtt-showcase__toolbar">
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
              <span class="vtt-showcase__dot"></span>
            </div>
            <img class="vtt-showcase__img" src="/assets/landing/vtt_screenshot.png" alt="Far Reach Co. Virtual Tabletop — tokens, maps, dice rolls, and asset management" loading="lazy" />
          </div>
        </div>

        <a class="landing-btn" href="/vtt/guest/start">Try No-Signup VTT Sandbox</a>
      </div>
    </section>

    <section class="landing-section landing-character">
      <div class="landing-container landing-character__grid">
        <div class="landing-character__copy animate-left-on-scroll">
          <img class="landing-character__dice" src="/assets/landing/dice.svg" alt="" />
          <h1>D&amp;D 5E Character Sheets for Persistent Campaigns</h1>
          <p>
            Keep classes, spells, inventory, and combat details organized in a sheet designed for quick play decisions. Built for D&D 5E, optimized for real campaigns.
          </p>
        </div>
        <img class="landing-character__art animate-right-on-scroll" src="/assets/landing/character.png" alt="D&D character artwork" loading="lazy" />
      </div>
    </section>

    <section class="landing-section landing-radio">
      <div class="landing-container">
        <div class="landing-radio__card animate-on-scroll">
          <div class="landing-radio__icon" aria-hidden="true">
            <svg viewBox="0 0 80 80" width="80" height="80" fill="none">
              <circle cx="40" cy="40" r="36" stroke="var(--orange2)" stroke-width="1.5" opacity="0.25" />
              <circle cx="40" cy="40" r="26" stroke="var(--blue6)" stroke-width="1" opacity="0.35" />
              <circle cx="40" cy="40" r="16" stroke="var(--orange3)" stroke-width="1.5" opacity="0.5" />
              <circle cx="40" cy="40" r="5" fill="var(--orange2)" />
              <path d="M52 28a18 18 0 0 1 0 24" stroke="var(--orange3)" stroke-width="2" stroke-linecap="round" />
              <path d="M56 22a26 26 0 0 1 0 36" stroke="var(--blue6)" stroke-width="1.5" stroke-linecap="round" />
              <path d="M60 16a34 34 0 0 1 0 48" stroke="var(--orange2)" stroke-width="1" stroke-linecap="round" />
            </svg>
          </div>
          <p class="landing-kicker">Far Reach Radio</p>
          <h1>Synced Tabletop Audio Streaming</h1>
          <p>
            Set session mood without Discord bots or audio setup friction. Start a channel, pick a playlist, and share one listener link so your players hear RPG ambience in sync.
          </p>
          <div class="landing-radio__links">
            <a class="landing-btn landing-btn--subtle" href="/radio">Explore Far Reach Radio</a>
            <a class="landing-btn landing-btn--subtle" href="https://radio.farreachco.com" target="_blank" rel="noopener">Open Radio App</a>
          </div>
        </div>
      </div>
    </section>

    <section class="landing-section landing-quest">
      <div class="landing-container landing-quest__grid">
        <div class="landing-quest__media animate-left-on-scroll">
          <img class="landing-quest__scroll" src="/assets/landing/scroll_dice.webp" alt="Far Reach Co. visual style artwork" loading="lazy" />
        </div>

        <div class="landing-quest__copy animate-right-on-scroll">
          <h1>GM-Focused Campaign Hub</h1>
          <p>
            Run one-shots quickly, then scale into persistent campaign play. Far Reach Co combines lightweight virtual tabletop sessions, synced tabletop audio via Far Reach Radio, and organized Wyrld-based campaign records, resources, and discussion.
          </p>
          <a class="landing-btn landing-btn--subtle" href="/about-us">Read More About Us</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('./partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var els = document.querySelectorAll('.animate-on-scroll, .animate-scale-on-scroll, .animate-left-on-scroll, .animate-right-on-scroll');
      if (!els.length) return;
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.15
      });
      els.forEach(function(el) {
        observer.observe(el);
      });
    });
  </script>
</body>

</html>
