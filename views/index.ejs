<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. - Virtual Tabletop & D&D 5E Tools</title>
  <meta name="description" content="Free collaborative virtual tabletop and campaign management platform. Features include platform-agnostic VTT, D&D 5E character sheets, world building tools, complete SRD reference, and Discord integration. Play TTRPGs online with friends!" />
  <meta name="keywords" content="virtual tabletop, VTT, D&D 5E, character sheet, campaign management, 5e SRD, tabletop RPG, online TTRPG, dungeons and dragons, game master tools" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/" />
  <meta property="og:title" content="Far Reach Co. - Virtual Tabletop & D&D 5E Tools" />
  <meta property="og:description" content="Free collaborative virtual tabletop and campaign management platform. Platform-agnostic VTT, D&D 5E character sheets, and complete SRD reference." />
  <meta property="og:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Far Reach Co. - Virtual Tabletop & D&D 5E Tools" />
  <meta name="twitter:description" content="Free collaborative virtual tabletop and campaign management platform. Platform-agnostic VTT, D&D 5E character sheets, and complete SRD reference." />
  <meta name="twitter:image" content="https://farreachco.com/assets/landing/mainlogo.webp" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Far Reach Co.",
      "url": "https://farreachco.com",
      "description": "Free collaborative virtual tabletop and campaign management platform for tabletop RPGs with dedicated D&D 5E support",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Platform-agnostic Virtual Tabletop (VTT) with real-time collaboration",
        "D&D 5E Character Sheet Management",
        "Campaign Management and World Building Tools (Wyrlds)",
        "Complete D&D 5E SRD Reference Material (1340+ monsters, spells, classes, equipment)",
        "Records System for lore and notes",
        "Calendar and Clock System",
        "Asset Management for tokens and maps",
        "Discord Bot Integration"
      ],
      "author": {
        "@type": "Organization",
        "name": "Far Reach Co."
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Tabletop RPG players, Dungeon Masters, Game Masters"
      }
    }
  </script>

  <link rel="stylesheet" href="./style.css" />
  <link rel="stylesheet" href="/css/features/landing.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>

  <!-- HERO -->
  <section class="section hero">
    <div class="hero-background">
      <img class="logo" src="/assets/landing/mainlogo.webp" alt="Far Reach Co Logo" />
    </div>

    <p>
      <b>Unleash your creativity with friends!</b> Far Reach Co. offers an
      engaging, collaborative, roleplaying experience. Assemble your group to
      conquer fearsome beasts, embark on thrilling adventures, and weave
      fantastical tales brimming with excitement and imagination.
    </p>

    <p class="text-center mb-3">
      <a href="/what-is-frc" style="font-size: 1.1em;">
        <b>What is Far Reach Co? →</b>
      </a>
    </p>

    <img class="cta-signup" src="/assets/landing/peli_signup.webp" alt="Sign up" onclick="window.location = '/register'" />
  </section>

  <!-- WORLD MAP -->
  <section class="section world-map">
    <div class="map-small">
      <img class="scroll-icon" src="/assets/landing/scroll.svg" alt="" />
      <h1>Virtual Table Top</h1>
      <p>
        Take your team on an adventure by using our virtual tabletop system.
        Our service is fast and simple and allows you to keep everything
        organized and accessible without cluttering up the screen for your
        players!
      </p>
    </div>

    <img class="map-large" src="/assets/landing/large_map_bg.webp" alt="" />
  </section>

  <!-- CHARACTERS -->
  <section class="section characters">
    <div class="content">
      <img class="dice-icon" src="/assets/landing/dice.svg" alt="" />
      <h1>Character Sheets</h1>
      <p>
        Manage your D&D 5E character sheet with a fresh and intuitive
        approach.
      </p>

      <div class="d-flex align-items-center justify-content-center">
        <img class="me-2" src="/assets/discord_icon.webp" width="30" height="30" alt="Discord" />
        <h2>Join us on Discord</h2>
      </div>

      <a href="https://discord.gg/Yzw3xZysxe">
        https://discord.gg/Yzw3xZysxe
      </a>
    </div>

    <img class="character-image" src="/assets/landing/character.png" alt="" />
  </section>

  <!-- FEATURE / QUEST -->
  <section class="section feature-scroll">
    <div class="media">
      <img class="scroll-image" src="/assets/landing/scroll_dice.webp" alt="" />
    </div>

    <div class="content">
      <h1>Our Personal Quest</h1>
      <br />
      <p>
        We do whatever it takes to ensure a quality experience by keeping
        things accessible and responsive. Players can jump into a game with
        one simple click. Our goal is to cultivate a community of inspired
        creators able to run exciting and fulfilling adventures with the
        innovations we provide.
      </p>

      <b>
        <a class="about-btn" href="/about-us">
          Read More About Us
        </a>
      </b>
    </div>
  </section>

  <%- include('./partials/footer') %>
</body>


</html>