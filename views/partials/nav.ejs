<%
  const navLinks = typeof auth !== 'undefined'
    ? [
        { href: '/resources', label: 'Resources' },
        { href: '/pricing', label: 'Pricing' },
        { href: '/dash', label: 'Dashboard' },
        { href: '/wyrlds/public', label: 'Public Wyrlds' },
        { href: '/account', label: 'Account' },
      ]
    : [
        { href: '/resources', label: 'Resources' },
        { href: '/pricing', label: 'Pricing' },
        { href: '/wyrlds/public', label: 'Public Wyrlds' },
        { href: '/login', label: 'Login' },
      ];
%>
<script src="/lib/customUi.js"></script>
<div id="nav-links-container-mobile">
  <% navLinks.forEach((link) => { %>
    <a class="top-nav-btn" href="<%= link.href %>"><%= link.label %></a>
  <% }) %>
</div>
<nav>
  <a id="frlogo-container" class="d-flex align-items-center" href="/index">
    <img height="35px" src="/assets/frlogo.webp" alt="" />
  </a>
  <img src="/assets/hamburger.svg" height="32" width="32" id="nav-ham" alt="" />
  <div id="nav-links-container" class="d-flex">
    <% navLinks.forEach((link) => { %>
      <a class="top-nav-btn" href="<%= link.href %>"><%= link.label %></a>
    <% }) %>
  </div>
</nav>
<script>
  if (window.location.pathname == "/index" || window.location.pathname == "/") {
    const elem = document.getElementById("frlogo-container");
    document.getElementById("frlogo-container").remove();
  }
</script>
