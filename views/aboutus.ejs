  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="About Us - Far Reach Co." />
  <meta name="twitter:description" content="Built by friends who wanted a VTT that stayed out of the way. Simple tools, fast performance, focused on the story." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "name": "About Far Reach Co.",
      "description": "Far Reach Co. was created by a group of friends - musicians, artists, developers, and teachers - who wanted a virtual tabletop that prioritized simplicity, speed, and immersion over feature bloat.",
      "url": "https://farreachco.com/about-us",
      "mainEntity": {
        "@type": "Organization",
        "name": "Far Reach Co.",
        "description": "A small team building virtual tabletop tools that prioritize simplicity, speed, and keeping players immersed in their games. Created by musicians, artists, developers, and teachers who play together despite living across the country.",
        "foundingDate": "2023",
        "knowsAbout": ["Virtual Tabletop Development", "D&D 5E", "Campaign Management", "Tabletop RPG Tools", "User Experience Design"],
        "slogan": "Tools that get out of your way so you can focus on the story"
      }
    }
