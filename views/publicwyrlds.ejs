<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Find Online Campaigns Looking for Players | Public Wyrlds</title>
  <meta name="description" content="Browse online D&amp;D and tabletop RPG campaigns looking for players. Search Public Wyrlds, review join modes, and request to join games that match your style." />
  <link rel="canonical" href="https://farreachco.com/wyrlds/public" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/wyrlds/public" />
  <meta property="og:title" content="Find Online Campaigns Looking for Players" />
  <meta property="og:description" content="Browse Public Wyrlds to find online D&amp;D campaigns, request to join groups, and connect with DMs recruiting players." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta property="og:image" content="https://farreachco.com/assets/landing/vtt_screenshot.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Find Online Campaigns Looking for Players" />
  <meta name="twitter:description" content="Browse Public Wyrlds to find online D&amp;D campaigns, request to join groups, and connect with DMs recruiting players." />
  <meta name="twitter:image" content="https://farreachco.com/assets/landing/vtt_screenshot.png" />

  <% const directorySchemaJson = JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Public Wyrld Directory",
      url: "https://farreachco.com/wyrlds/public",
      description:
        "Directory of public online tabletop RPG campaigns where players can browse listings and request to join.",
      mainEntity: {
        "@type": "ItemList",
        itemListElement: projects.slice(0, 12).map((project, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: project.title,
          url: `https://farreachco.com${project.publicPath || (`/wyrlds/public/${project.id}`)}`,
        })),
      },
    }).replace(/</g, "\\u003c"); %>
  <script type="application/ld+json"><%- directorySchemaJson %></script>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="mt-5 px-2 dashboard-shell">
    <main class="dashboard-main" style="width: 100%;">
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h1>Find Online Campaigns Looking for Players</h1>
          <a href="<%= isAuthenticated ? '/dash/wyrlds' : '/index' %>"><%= isAuthenticated ? 'Back to My Wyrlds' : 'Back to Home' %></a>
        </div>
        <small class="d-block mt-1"><strong>Public Wyrld Directory:</strong> browse campaign listings, check join settings, and request to join groups that match your play style.</small>
        <small>
          A <strong>Wyrld</strong> is a persistent campaign hub for one ongoing game.
        </small>
        <small class="d-block mt-1">Joining is always controlled by the campaign owner.</small>
        <small class="d-block mt-1">
          Listings with a <strong>Pro</strong> tag are run on Pro Wyrlds.
        </small>
        <small class="d-block mt-1">
          Running a campaign and looking for players? <a href="<%= isAuthenticated ? '/newwyrld' : '/register' %>">Create a public listing</a> and follow the
          <a href="/public-wyrlds-admin-guide">host setup guide</a>.
        </small>
        <small class="d-block mt-1">
          <a href="/play-dungeons-and-dragons-online">How to find and join D&amp;D games online</a>
          |
          <a href="/public-wyrlds-guide">What are Public Wyrlds?</a>
          |
          <a href="/public-wyrlds-admin-guide">How to set up Public Discovery</a>
        </small>
        <hr />

        <form method="GET" action="/wyrlds/public" class="settings-form-row">
          <input type="text" name="q" class="settings-input" placeholder="Search online D&amp;D campaigns by title" value="<%= query %>" />
          <button class="modal-form-button" type="submit">Search</button>
        </form>

        <div class="dash-detail-row mt-2" style="display:block;">
          <div class="dash-detail-title">Start Here</div>
          <small class="d-block mt-1"><strong>Players:</strong> open a listing, read the featured record, then request to join if spots are open.</small>
          <small class="d-block mt-1"><strong>Hosts:</strong> create your Wyrld, enable public listing, and publish a clear onboarding record to attract better-fit players.</small>
          <small class="d-block mt-1">
            <a href="/play-dungeons-and-dragons-online">Full player flow</a>
            |
            <a href="/public-wyrlds-admin-guide">Full host flow</a>
          </small>
        </div>

        <% if (!projects.length) { %>
        <small>No public wyrlds found.</small>
        <% } else { %>
        <div class="dashboard-list mt-3">
          <% projects.forEach(function(project) { %>
          <div class="dash-detail-row" style="display:block; cursor: default;">
            <div class="dashboard-card-header">
              <div class="dash-detail-title">
                <a href="<%= project.publicPath || ('/wyrlds/public/' + project.id) %>"><%= project.title %></a>
                <% if (project.is_pro) { %>
                <span class="record-badge record-badge-wyrld" style="margin-left:6px;">Pro</span>
                <% } %>
              </div>
              <div class="dash-detail-meta">Owner: <%= project.owner_username %></div>
            </div>

            <% if (project.description) { %>
            <small class="d-block mt-1">
              <%= project.description.length > 220 ? project.description.slice(0, 220) + '...' : project.description %>
            </small>
            <% } %>

            <% if (project.featured_record_title) { %>
            <div class="mt-2 public-wyrld-featured">
              <small><strong>Featured Record:</strong></small>
              <a class="dash-inline-action" href="/record?id=<%= project.featured_record_id %>&project_id=<%= project.id %>"><%= project.featured_record_title %></a>
            </div>
            <% } %>

            <div class="dash-detail-meta mt-2">
              Join mode: <%= project.public_join_mode === 'request' ? 'Request to Join' : 'Invite Only' %>
              <% if (project.public_join_capacity) { %>
              - Members: <%= project.member_count %> / <%= project.public_join_capacity %>
              <% } else { %>
              - Members: <%= project.member_count %> (no capacity limit)
              <% } %>
            </div>

            <div class="settings-form-row mt-2">
              <a class="dash-inline-action" href="<%= project.publicPath || ('/wyrlds/public/' + project.id) %>">View Wyrld Page</a>
              <% if (project.isOwner || project.isMember) { %>
              <a class="label-btn" href="/wyrld?id=<%= project.id %>">Open Wyrld</a>
              <% } else if (!isAuthenticated && project.public_join_mode === 'request' && !project.isFull) { %>
              <a class="modal-form-button" href="<%= loginHref %>">Login to Request Join</a>
              <% } else if (project.hasPendingRequest) { %>
              <button class="modal-form-button" type="button" disabled>Request Pending</button>
              <% if (project.pendingRequestId) { %>
              <button class="btn-red" type="button" onclick="cancelJoinRequest(<%= project.pendingRequestId %>)">Cancel Request</button>
              <% } %>
              <% } else if (project.public_join_mode === 'request' && !project.isFull) { %>
              <button class="modal-form-button" type="button" onclick="requestJoin(<%= project.id %>)">Request to Join</button>
              <% } else if (project.public_join_mode === 'request' && project.isFull) { %>
              <button class="modal-form-button" type="button" disabled>At Capacity</button>
              <% } else { %>
              <button class="modal-form-button" type="button" disabled>Invite Only</button>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
    </main>
  </div>
</body>
<script>
  async function requestJoin(projectId) {
    const message = window.prompt("Optional intro message for the DM:", "") || "";
    const res = await fetch(`/api/request_project_join/${projectId}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        message
      }),
    });
    const data = await res.json().catch(function() {
      return null;
    });
    if (!res.ok || (data && data.error)) {
      window.customAlertError((data && data.error && data.error.message) || "Unable to request join.");
      return;
    }
    window.location.reload();
  }

  async function cancelJoinRequest(requestId) {
    const res = await fetch(`/api/cancel_project_join_request/${requestId}`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({}),
    });
    const data = await res.json().catch(function() {
      return null;
    });
    if (!res.ok || (data && data.error)) {
      window.customAlertError((data && data.error && data.error.message) || "Unable to cancel request.");
      return;
    }
    window.location.reload();
  }
</script>

</html>
