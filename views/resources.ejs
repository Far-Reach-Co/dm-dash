<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Resources - Free D&D Assets & SRD | Far Reach Co.</title>
  <meta name="description" content="Free D&D resources including character sheet PDFs, token and map packs, D&D 5E SRD reference, Aethrend campaign setting, Discord bots, and VTT tutorials. Everything you need to run your tabletop RPG campaigns." />
  <meta name="keywords" content="D&D resources, free tokens, free maps, D&D character sheets, 5e SRD, Aethrend, Discord bot, VTT tutorials, D&D assets" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/resources" />
  <meta property="og:title" content="Resources - Free D&D Assets & SRD | Far Reach Co." />
  <meta property="og:description" content="Free D&D resources: character sheets, tokens, maps, complete 5E SRD reference, Aethrend campaign setting, and Discord bots." />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Resources - Free D&D Assets & SRD | Far Reach Co." />
  <meta name="twitter:description" content="Free D&D resources: character sheets, tokens, maps, complete 5E SRD reference, Aethrend campaign setting, and Discord bots." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Far Reach Co. Resources",
      "description": "Free resources for D&D and tabletop RPG players including character sheets, tokens, maps, and SRD reference material",
      "url": "https://farreachco.com/resources",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [{
            "@type": "CreativeWork",
            "name": "D&D 5E SRD Reference",
            "description": "Complete System Reference Document for D&D 5E including spells, monsters, classes, equipment, and more"
          },
          {
            "@type": "CreativeWork",
            "name": "Free Character Sheets",
            "description": "Printable D&D 5E character sheet PDFs in multiple formats"
          },
          {
            "@type": "CreativeWork",
            "name": "Free Token and Map Pack",
            "description": "Downloadable starter pack of VTT tokens and maps for tabletop gaming"
          },
          {
            "@type": "CreativeWork",
            "name": "Aethrend Campaign Setting",
            "description": "Original D&D 5E campaign setting with pre-release content"
          },
          {
            "@type": "SoftwareApplication",
            "name": "Aether Discord Bot",
            "description": "Discord bot for integrating with Far Reach Co. character sheets"
          }
        ]
      }
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <div class="intro">
      <h1 class="text-center">Resources</h1>
    </div>
    <br>
    <article id="srd" class="resource-article">
      <div class="resource-image">
        <img src="/assets/landing/dice.svg" alt="D&D 5E SRD">
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Dungeons & Dragons 5E SRD Compendium</h2>
          <small>- V5.1</small>
        </div>
        <div class="indent">
          <p>
            We currently provide an online utility to engage with the content
            from Dungeons & Dragons System Reference Document. This resource is
            design to be used as a quick reference guide, not an exhaustive
            reproduction of the original.
          </p>
          <a href="/dnd/5e/srd/contents" class="resource-link">
            <span>Browse SRD Contents</span>
          </a>
        </div>
      </div>
    </article>
    <article id="tutorials" class="resource-article">
      <div class="resource-image">
        <svg viewBox="0 0 24 24" width="80" height="80" fill="#FF0000">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Tutorials</h2>
          <small>- In Progress</small>
        </div>
        <div class="indent">
          <p>
            On our YouTube channel you can find tutorials on how to use our online tools including the virtual table-top system. (These are still in-production so expect more content soon!)
          </p>
          <a href="https://www.youtube.com/playlist?list=PLbXvAcAjBp22C6lKdWlSd32I_6US4O2wa" target="_blank" rel="noopener" class="resource-link external-link">
            <span>Watch on YouTube</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
            </svg>
          </a>
        </div>
      </div>
    </article>
    <article id="free-assets" class="resource-article">
      <div class="resource-image">
        <img src="/assets/character_knight.png" alt="Free Token and Map Images">
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Free Token and Map Images</h2>
          <small>- V4</small>
        </div>
        <div class="indent">
          <p>
            We have a starter pack of free image assets for use on the virtual table top. We hope these help you get started on your adventures! Inside you will find character tokens and maps.
          </p>
          <a href="https://wyrld.s3.us-east-1.amazonaws.com/free-images/FreeTokens_v4.zip" class="resource-link download-link" onclick="return confirm('Download FreeTokens_v4.zip (~15MB)?')">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
            </svg>
            <span>Download ZIP</span>
            <small>~15MB</small>
          </a>
        </div>
      </div>
    </article>
    <article id="character-sheets" class="resource-article">
      <div class="resource-image">
        <svg viewBox="0 0 24 24" width="70" height="70" fill="var(--light-gray)">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" />
          <path d="M8 12h8v2H8zm0 4h8v2H8zm0-8h3v2H8z" />
        </svg>
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Offline 5e Character Sheets</h2>
          <small>- PDFs</small>
        </div>
        <div class="indent">
          <p>
            Although we provide online character sheets, we also wanted to share
            with you our custom designs. If you like to play with pencil and
            paper, try our version of the 5e character sheet.
          </p>
          <div class="download-list">
            <a href="/assets/resources/character_sheets/CharSheetPeli_v01.pdf" download class="resource-link download-link" onclick="return confirm('Download CharSheetPeli_v01.pdf?')">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              <span>Color PDF with Peli</span>
            </a>
            <a href="/assets/resources/character_sheets/CharSheetNOPeli_v02.pdf" download class="resource-link download-link" onclick="return confirm('Download CharSheetNOPeli_v02.pdf?')">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              <span>Color PDF without Peli</span>
            </a>
            <a href="/assets/resources/character_sheets/CharSheetNOPeliNOBkgd_v03.pdf" download class="resource-link download-link" onclick="return confirm('Download CharSheetNOPeliNOBkgd_v03.pdf?')">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              <span>Printer-friendly (no background)</span>
            </a>
          </div>
        </div>
      </div>
    </article>
    <article id="aether-bot" class="resource-article">
      <div class="resource-image">
        <img src="/assets/token_dragon_purple1.png" alt="Aether Discord Bot">
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Aether Discord Bot</h2>
          <small>- Platform specific</small>
        </div>
        <div class="indent">
          <p>
            This bot is designed to integrate with the FRC character sheet
            system. It provides an interface to register your sheets and view
            different resources from those sheets within a discord channel. We
            intend to include more functionality to allow users to update
            specific resources as needed, please stay up to date by joining us
            on discord.
          </p>
          <a href="/aether-bot" class="resource-link">
            <span>View Documentation</span>
          </a>
        </div>
      </div>
    </article>
    <article id="5e-bot" class="resource-article">
      <div class="resource-image">
        <img src="/assets/token_dragon_green.webp" alt="5e Discord Bot">
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>5e Discord Bot</h2>
          <small>- Non-platform specific </small>
        </div>
        <div class="indent">
          <p>
            We have developed a discord bot specifically for helping run smooth
            D&D games on discord. You can use the bot to roll dice, search for
            Official D&D 5e resources from the SRD, and handle inititative
            tracking!
          </p>
          <a href="https://5ebot.com" target="_blank" rel="noopener" class="resource-link external-link">
            <span>Visit 5ebot.com</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" />
            </svg>
          </a>
        </div>
      </div>
    </article>
    <article id="aethrend" class="resource-article">
      <div class="resource-image">
        <img src="/assets/resources/aethrend/Aethrend_Background_SkySailor_p1_v1.jpeg" alt="Aethrend Campaign Setting">
      </div>
      <div class="resource-content">
        <div class="inline-div">
          <h2>Aethrend</h2>
          <small>- Campaign Setting</small>
        </div>
        <div class="indent">
          <p>
            We are currently working on a D&D 5e campaign setting and will be
            releasing that for sale here on our site. For now you can find our
            pre-released free content to use in your games.
          </p>
          <a href="/preaethrend" class="resource-link">
            <span>Browse Pre-Release Content</span>
          </a>
        </div>
      </div>
    </article>
  </div>
  <%- include('./partials/footer') %>
</body>

</html>