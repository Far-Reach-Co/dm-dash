<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Create Table</title>
  <link rel="stylesheet" href="/style.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
  <script src="/components/renderTierLimitWarning.js" type="module"></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container page-form p-3">
    <h1>Create Virtual Table</h1>
    <form hx-post="/api/add_table_view_by_user">
      <fieldset>
        <div class="input-container">
          <label for="title">Title</label>
          <input id="title" name="title" placeholder="Table Title" required />
        </div>
        <button type="submit">Create</button>
      </fieldset>
    </form>
  </div>
</body>
<script>
  document.body.addEventListener("htmx:responseError", function (event) {
    var errorText = JSON.parse(event.detail.xhr.responseText).error.message;
    if (errorText === "USER_IS_NOT_PRO") {
      renderTierLimitWarning(
        'You have reached the table limit (10) for this account. Please subscribe to our "Pro User" package to increase the limit.'
      );
    }
  });
</script>

</html>
