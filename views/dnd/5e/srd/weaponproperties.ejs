<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Weapon Properties Reference | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E weapon properties reference including Ammunition, Finesse, Heavy, Light, Loading, Range, Reach, Thrown, Two-Handed, and Versatile with full descriptions and effects." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/weapon-properties" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/weapon-properties" />
  <meta property="og:title" content="D&D 5E Weapon Properties Reference" />
  <meta property="og:description" content="Complete D&D 5E weapon properties reference with full descriptions." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Weapon Properties Reference",
      "url": "https://farreachco.com/dnd/5e/srd/weapon-properties",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Weapon Properties",
            "item": "https://farreachco.com/dnd/5e/srd/weapon-properties"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Weapon Properties',
      srdPageSummary: 'Quick-reference descriptions of every D&D 5E SRD weapon property and how each one works.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Weapon Properties</span>
    </div>
    <hr />
    <h2>Weapon Properties</h2>
    <ul>
      <% data.forEach(function(prop){ %>
      <li>
        <a href="#<%= prop.index %>"><%= prop.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(prop){ %>
    <div class="inline-div" id="<%= prop.index %>">
      <h3><%= prop.name %></h3>
      <div class="indent">
        <% prop.desc.forEach((str, index) => { %>
        <p><%= str %></p>
        <% }) %>
        <br />
      </div>
    </div>
    <br>
    <% }); %>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
