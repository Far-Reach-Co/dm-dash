<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Equipment & Magic Items - Complete Reference | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E equipment reference with <%= equipmentData.length %> items and <%= magicItemsData.length %> magic items. Weapons, armor, adventuring gear, tools, and magical treasures." />
  <meta name="keywords" content="D&D 5E equipment, weapons, armor, magic items, adventuring gear, tools, equipment stats, weapon properties, D&D items" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/equipment" />
  <meta property="og:title" content="D&D 5E Equipment & Magic Items - Complete Reference" />
  <meta property="og:description" content="Complete D&D 5E equipment reference with <%= equipmentData.length %> items and <%= magicItemsData.length %> magic items." />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Equipment & Magic Items - Complete Reference" />
  <meta name="twitter:description" content="Complete D&D 5E equipment reference with <%= equipmentData.length %> items and <%= magicItemsData.length %> magic items." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "D&D 5E Equipment Reference",
    "description": "Complete equipment and magic items reference for D&D 5th Edition",
    "url": "https://farreachco.com/dnd/5e/srd/equipment",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://farreachco.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "D&D 5E SRD",
          "item": "https://farreachco.com/dnd/5e/srd/contents"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Equipment",
          "item": "https://farreachco.com/dnd/5e/srd/equipment"
        }
      ]
    }
  }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="inline-div">
      <small>
        <a href="/dnd/5e/srd/contents">Contents</a> ->
        <div class="text-green">Equipment</div>
      </small>
    </div>
    <hr />
    <h2>Equipment</h2>
    <p>Browse our complete collection of <%= equipmentData.length %> equipment items from the D&D 5E SRD. Click any item to view full details including cost, weight, and properties.</p>
    <ul style="column-count: 3; column-gap: 20px;">
      <% equipmentData.sort((a, b) => a.name.localeCompare(b.name)).forEach(item => { %>
      <li>
        <a href="/dnd/5e/srd/equipment/<%= item.index %>"><%= item.name %></a>
      </li>
      <% }); %>
    </ul>

    <hr />
    <h2>Magic Items</h2>
    <p>Browse our complete collection of <%= magicItemsData.length %> magic items from the D&D 5E SRD. Click any item to view full details including rarity and magical properties.</p>
    <ul style="column-count: 3; column-gap: 20px;">
      <% magicItemsData.sort((a, b) => a.name.localeCompare(b.name)).forEach(item => { %>
      <li>
        <a href="/dnd/5e/srd/magic-items/<%= item.index %>"><%= item.name %></a>
      </li>
      <% }); %>
    </ul>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
