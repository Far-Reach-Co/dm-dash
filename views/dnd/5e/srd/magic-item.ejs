<% if (typeof srdEdition !== 'undefined' && srdEdition === '2024') { %>
<%- include('partials/edition-page') %>
<% } else { %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <%
    const category = item.equipment_category?.name || 'Magic Item';
    const rarity = item.rarity?.name || 'Unknown';
    const typeAttunementLine = item.desc && item.desc.length ? item.desc[0] : '';
    const requiresAttunement = typeAttunementLine.toLowerCase().includes('attunement');
    const descBody = item.desc && item.desc.length > 1 ? item.desc[1] : (item.desc && item.desc.length ? item.desc[0] : '');
    const firstRuleSentence = String(descBody || '').split(/(?<=[.!?])\s+/)[0] || `${item.name} has a full SRD rules entry on this page.`;
    const variantNames = item.variants && item.variants.length
      ? item.variants.map((variant) => variant.name)
      : [];

    const pageTitle = variantNames.length
      ? `${item.name} 5e Magic Item: Variants, Attunement, and Rules`
      : `${item.name} 5e Magic Item: Rarity, Attunement, and Rules`;
    const metaDesc = `${item.name} in D&D 5e: ${rarity} ${category}.${variantNames.length ? ` Variants: ${variantNames.join(', ')}.` : ''}${requiresAttunement ? ' Requires attunement.' : ''} ${firstRuleSentence}`.substring(0, 160);
    const summaryText = `${item.name} is a ${rarity.toLowerCase()} ${category.toLowerCase()} in D&D 5e.${variantNames.length ? ` Known variants include ${variantNames.join(', ')}.` : ''}${requiresAttunement ? ' It requires attunement.' : ' It does not require attunement.'}`;
  %>

  <title><%= pageTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= metaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/magic-items/<%= item.index %>" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/magic-items/<%= item.index %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= metaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= metaDesc %>" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "name": "<%= pageTitle %>",
      "headline": "<%= item.name %>",
      "description": "<%= metaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/magic-items/<%= item.index %>",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Equipment",
            "item": "https://farreachco.com/dnd/5e/srd/equipment"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "<%= item.name %>",
            "item": "https://farreachco.com/dnd/5e/srd/magic-items/<%= item.index %>"
          }
        ]
      },
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition",
        "gamePlatform": "Tabletop"
      }
    }
  </script>


  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: pageTitle,
      srdPageSummary: summaryText
    }) %>
    <br />
    <!-- Breadcrumb -->
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/equipment">Equipment</a>
      <span class="separator">→</span>
      <span class="current"><%= item.name %></span>
    </div>
    <hr />

    <!-- Item Header -->
    <h2><%= item.name %></h2>
    <div class="inline-div">
      <i><%= category %></i>
      <i class="text-purple">- <%= rarity %></i>
    </div>

    <hr class="w-75" />

    <!-- Description -->
    <div class="magic-item-description">
      <% if (item.desc && item.desc.length) { %>
        <% item.desc.forEach((paragraph, idx) => { %>
          <% if (idx === 0) { %>
          <p><i><%= paragraph %></i></p>
          <% } else { %>
          <p><%= paragraph %></p>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <% if (item.variants && item.variants.length) { %>
    <hr class="w-75" />
    <b>Variants:</b>
    <ul>
      <% item.variants.forEach(variant => { %>
      <li>
        <a href="/dnd/5e/srd/magic-items/<%= variant.index %>"><%= variant.name %></a>
      </li>
      <% }) %>
    </ul>
    <% } %>


    <div class="srd-back-link">
      <a href="/dnd/5e/srd/equipment">&larr; Back to Equipment List</a>
    </div>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>

<% } %>
