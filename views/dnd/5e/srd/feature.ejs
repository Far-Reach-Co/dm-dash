<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const featureOwner = feature.subclass ? `${feature.subclass.name} ${feature.class.name}` : feature.class.name;
    const firstParagraph = Array.isArray(feature.desc) && feature.desc.length ? String(feature.desc[0]) : '';
    const firstSentence = firstParagraph.split(/(?<=[.!?])\s+/)[0] || `${feature.name} has full SRD rules text on this page.`;
    const featureTitle = `${feature.name} 5e: ${featureOwner} Feature`;
    const featureMetaDesc = `${feature.name} in D&D 5e: ${featureOwner}${feature.level ? ` level ${feature.level}` : ''} feature. ${firstSentence}`.substring(0, 160);
    const featureSummary = `${feature.name} is a ${featureOwner} feature${feature.level ? ` gained at level ${feature.level}` : ''} in D&D 5e. ${firstSentence}`;
    const faqs = [
      {
        q: `What does ${feature.name} do in D&D 5e?`,
        a: firstSentence
      },
      {
        q: `What level do you get ${feature.name} in D&D 5e?`,
        a: feature.level
          ? `You gain ${feature.name} at level ${feature.level}${feature.subclass ? ` as part of the ${feature.subclass.name}` : ''} ${feature.class.name} progression.`
          : `${feature.name} is a ${feature.class.name} feature in D&D 5e. See the class progression for when it becomes available.`
      },
      {
        q: `Is ${feature.name} a ${feature.class.name} feature in D&D 5e?`,
        a: feature.subclass
          ? `Yes. ${feature.name} is part of the ${feature.subclass.name} subclass for the ${feature.class.name} in D&D 5e.`
          : `Yes. ${feature.name} is a ${feature.class.name} class feature in D&D 5e.`
      }
    ];
  %>
  <title><%= featureTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= featureMetaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/features/<%= feature.index %>" />

  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/features/<%= feature.index %>" />
  <meta property="og:title" content="<%= featureTitle %>" />
  <meta property="og:description" content="<%= featureMetaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= featureTitle %>" />
  <meta name="twitter:description" content="<%= featureMetaDesc %>" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= feature.name %>",
      "name": "<%= featureTitle %>",
      "description": "<%= featureMetaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/features/<%= feature.index %>"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": <%- JSON.stringify(faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))) %>
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: featureTitle,
      srdPageSummary: featureSummary
    }) %>
    <br />

    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/features">Features</a>
      <span class="separator">→</span>
      <span class="current"><%= feature.name %></span>
    </div>
    <hr />

    <h2><%= feature.name %></h2>

    <div class="inline-div">
      <b>Class:</b>
      <a href="/dnd/5e/srd/classes/<%= feature.class.index %>"><%= feature.class.name %></a>
    </div>
    <% if (feature.subclass) { %>
      <div class="inline-div">
        <b>Subclass:</b>
        <span><%= feature.subclass.name %></span>
      </div>
    <% } %>
    <% if (feature.level) { %>
      <div class="inline-div">
        <b>Level:</b>
        <span><%= feature.level %></span>
      </div>
    <% } %>

    <hr class="w-75" />

    <% (feature.desc || []).forEach((paragraph) => { %>
      <p><%= paragraph %></p>
    <% }) %>

    <hr class="w-75" />
    <section class="srd-faq">
      <p class="srd-faq-label">Frequently Asked Questions</p>
      <% faqs.forEach((faq) => { %>
        <details>
          <summary><%= faq.q %></summary>
          <p><%= faq.a %></p>
        </details>
      <% }) %>
    </section>

    <% if (feature.parent) { %>
      <hr class="w-75" />
      <div class="inline-div">
        <b>Parent Feature:</b>
        <a href="/dnd/5e/srd/features/<%= feature.parent.index %>"><%= feature.parent.name %></a>
      </div>
    <% } %>

    <div class="srd-prev-next">
      <% if (previousFeature) { %>
        <a href="/dnd/5e/srd/features/<%= previousFeature.index %>">&larr; <%= previousFeature.name %></a>
      <% } else { %>
        <span></span>
      <% } %>
      <% if (nextFeature) { %>
        <a href="/dnd/5e/srd/features/<%= nextFeature.index %>"><%= nextFeature.name %> &rarr;</a>
      <% } %>
    </div>

    <% if (subclassFeatures.length) { %>
      <div class="srd-see-also">
        <h3>More <%= feature.subclass.name %> Features</h3>
        <ul>
          <% subclassFeatures.forEach((item) => { %>
            <li><a href="/dnd/5e/srd/features/<%= item.index %>"><%= item.name %> (Lvl <%= item.level %>)</a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (relatedFeatures.length) { %>
      <div class="srd-see-also">
        <h3>More <%= feature.class.name %> Features</h3>
        <ul>
          <% relatedFeatures.forEach((item) => { %>
            <li><a href="/dnd/5e/srd/features/<%= item.index %>"><%= item.name %> (Lvl <%= item.level %>)</a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
