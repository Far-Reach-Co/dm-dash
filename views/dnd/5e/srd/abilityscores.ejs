<%- include('partials/edition-page') %>
<% } else { %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Ability Scores: Modifiers, Checks, and Skills | Far Reach Co.</title>
  <meta name="description" content="Learn the six D&D 5E ability scores: Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma, plus ability modifiers, ability checks, saving throws, and associated skills." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/ability-scores" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/ability-scores" />
  <meta property="og:title" content="D&D 5E Ability Scores: Modifiers, Checks, and Skills" />
  <meta property="og:description" content="Learn what each ability score does in D&D 5E, how modifiers work, and which skills use Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Ability Scores: Modifiers, Checks, and Skills" />
  <meta name="twitter:description" content="Learn what each D&D 5E ability score does, how modifiers are calculated, and how ability checks and skills use them." />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Ability Scores: Modifiers, Checks, and Skills",
      "url": "https://farreachco.com/dnd/5e/srd/ability-scores",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Ability Scores",
            "item": "https://farreachco.com/dnd/5e/srd/ability-scores"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E Ability Scores',
      srdPageSummary: 'Learn what each D&D 5E ability score does, how ability modifiers work, and which skills and checks use Strength, Dexterity, Constitution, Intelligence, Wisdom, and Charisma.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Ability Scores</span>
    </div>
    <hr />
    <h2>The Six Ability Scores in D&D 5E</h2>
    <p>The six D&D 5e ability scores are <strong>Strength</strong>, <strong>Dexterity</strong>, <strong>Constitution</strong>, <strong>Intelligence</strong>, <strong>Wisdom</strong>, and <strong>Charisma</strong>. These scores define what your character is naturally good at and feed into attack rolls, spellcasting, skills, saving throws, and class features.</p>
    <p>Each ability score also gives you an <strong>ability modifier</strong>. In D&D 5e, the modifier is calculated by subtracting 10 from the score, dividing by 2, and rounding down. That modifier is what you usually add to ability checks, skill checks, saving throws, and many attacks.</p>
    <div class="inline-div">
      <b>Ability Checks:</b>
      <div>An ability check is a d20 roll using one of these six modifiers. Skills like Stealth, Perception, and Athletics are ability checks tied to specific abilities.</div>
    </div>
    <div class="inline-div">
      <b>Saving Throws:</b>
      <div>Each ability also has a matching saving throw that helps resist spells, traps, poison, fear, grapples, and other threats.</div>
    </div>
    <ul>
      <% data.forEach(function(score){ %>
      <li>
        <a href="#<%= score.index %>"><%= score.full_name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(score){ %>
    <div class="inline-div" id="<%= score.index %>">
      <h3><%= score.full_name %></h3>
      <div class="text-bright-white">[<%= score.name %>]
        <br>
        <div class="indent">
          <% score.desc.forEach((str, index) => { %>
          <p><%= str %></p>
          <% }) %>
          <p><b>Ability checks using <%= score.full_name %>:</b> <%= score.skills.map((skill) => skill.name).join(', ') || 'None listed in the SRD skill set.' %></p>
          <br />
          <ul>
            <% score.skills.forEach(function(skill){ %>
            <li>
              <a href="/dnd/5e/srd/skills#<%= skill.index %>"><%= skill.name %></a>
            </li>
            <% }); %>
          </ul>
          <br />
        </div>
      </div>
    </div>
    <% }); %>

  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>

<% } %>
