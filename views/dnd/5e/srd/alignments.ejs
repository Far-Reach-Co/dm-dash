<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Alignments Reference | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E alignments reference including Lawful Good, Neutral Good, Chaotic Good, Lawful Neutral, True Neutral, Chaotic Neutral, Lawful Evil, Neutral Evil, and Chaotic Evil with descriptions." />
  <meta name="keywords" content="D&D 5E alignments, lawful good, chaotic good, neutral good, lawful evil, chaotic evil, true neutral, character alignment" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/alignments" />
  <meta property="og:title" content="D&D 5E Alignments Reference" />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Alignments Reference",
      "url": "https://farreachco.com/dnd/5e/srd/alignments",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Alignments",
            "item": "https://farreachco.com/dnd/5e/srd/alignments"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Alignments</span>
    </div>
    <hr />
    <h2>Alignments</h2>
    <ul>
      <% data.forEach(function(alignment){ %>
      <li>
        <a href="#<%= alignment.index %>"><%= alignment.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(alignment){ %>
    <div class="inline-div" id="<%= alignment.index %>">
      <h3><%= alignment.name %></h3>
      <div class="text-bright-white">
        [<%= alignment.abbreviation %>]
        </span>
        </span>
        <div class="indent">
          <p><%= alignment.desc %></p>
          <br />
          </span>
          <br />
          <% }); %>
          </span>
          <%- include('../../../partials/footer') %>
</body>

</html>