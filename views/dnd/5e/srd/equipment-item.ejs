<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <%
    const category = item.equipment_category?.name || 'Equipment';
    const subCategory = item.category_range || item.armor_category || item.gear_category?.name || '';
    const costStr = item.cost ? `${item.cost.quantity} ${item.cost.unit}` : '';
    const hasContents = Boolean(item.contents && item.contents.length);
    const isArmor = Boolean(item.armor_class);
    const isWeapon = Boolean(item.damage || item.properties?.length || item.weapon_category);
    const visibleContents = hasContents
      ? item.contents.slice(0, 6).map((c) => c.quantity > 1 ? `${c.quantity}x ${c.item.name}` : c.item.name)
      : [];

    // Build FAQ entries from available item data
    const faqs = [];
    if (item.contents && item.contents.length) {
      const contentList = item.contents.map(c => c.quantity > 1 ? `${c.quantity}x ${c.item.name}` : c.item.name).join(', ');
      faqs.push({
        q: `What is in the ${item.name} in D&D 5e?`,
        a: `The ${item.name} in D&D 5th Edition contains: ${contentList}.`
      });
    }
    if (item.cost) {
      faqs.push({
        q: `How much does the ${item.name} cost in D&D 5e?`,
        a: `The ${item.name} costs ${item.cost.quantity} ${item.cost.unit} in D&D 5th Edition.`
      });
    }
    if (item.weight) {
      faqs.push({
        q: `How much does the ${item.name} weigh in D&D 5e?`,
        a: `The ${item.name} weighs ${item.weight} pounds in D&D 5th Edition.`
      });
    }
    if (item.damage) {
      const twoHand = item.two_handed_damage ? ` When used two-handed, it deals ${item.two_handed_damage.damage_dice} ${item.two_handed_damage.damage_type.name} damage.` : '';
      faqs.push({
        q: `How much damage does the ${item.name} deal in D&D 5e?`,
        a: `The ${item.name} deals ${item.damage.damage_dice} ${item.damage.damage_type.name} damage in D&D 5th Edition.${twoHand}`
      });
    }
    if (item.range) {
      const longRange = item.range.long ? ` and a long range of ${item.range.long} feet` : '';
      faqs.push({
        q: `What is the range of the ${item.name} in D&D 5e?`,
        a: `The ${item.name} has a normal range of ${item.range.normal} feet${longRange} in D&D 5th Edition.`
      });
    }
    if (item.armor_class) {
      const armorType = item.armor_category || subCategory || category;
      const dexBonus = item.armor_class.dex_bonus ? ` + your Dexterity modifier${item.armor_class.max_bonus ? ` (max +${item.armor_class.max_bonus})` : ''}` : '';
      const strReq = item.str_minimum ? ` Requires Strength ${item.str_minimum}.` : '';
      const stealth = item.stealth_disadvantage ? ' Imposes disadvantage on Stealth checks.' : '';
      faqs.push({
        q: `What armor class does ${item.name} give in D&D 5e?`,
        a: `${item.name} provides AC ${item.armor_class.base}${dexBonus} in D&D 5th Edition. It is ${armorType} armor.${strReq}${stealth}`
      });
    }

    let pageTitle = `${item.name} 5e Equipment Stats`;
    if (hasContents) {
      pageTitle = `${item.name} 5e: Cost, Contents, and Weight`;
    } else if (isArmor) {
      pageTitle = `${item.name} 5e Armor Stats: AC, Cost, and Weight`;
    } else if (isWeapon) {
      pageTitle = `${item.name} 5e Weapon Stats: Damage, Cost, and Range`;
    }

    const descParts = [];
    if (hasContents) {
      const names = item.contents.slice(0, 4).map(c => c.item.name).join(', ');
      descParts.push(`Contains ${names}${item.contents.length > 4 ? ' & more' : ''}.`);
    }
    if (item.damage) descParts.push(`${item.damage.damage_dice} ${item.damage.damage_type.name} damage.`);
    if (item.armor_class) descParts.push(`AC ${item.armor_class.base}${item.armor_class.dex_bonus ? '+Dex' : ''}.`);
    if (item.range) descParts.push(`Range ${item.range.normal}/${item.range.long || item.range.normal} ft.`);
    if (costStr) descParts.push(`Cost: ${costStr}.`);
    if (item.weight) descParts.push(`Weight: ${item.weight} lb.`);
    const metaDesc = `${item.name} in D&D 5e: ${descParts.join(' ')} Full ${subCategory || category} stats, rules, and quick answers.`.substring(0, 160);

    const summaryParts = [];
    if (costStr) summaryParts.push(`costs ${costStr}`);
    if (hasContents) {
      summaryParts.push(`contains ${visibleContents.join(', ')}${item.contents.length > visibleContents.length ? ', and more' : ''}`);
    }
    if (item.weight) summaryParts.push(`weighs ${item.weight} lb.`);
    if (item.damage) summaryParts.push(`deals ${item.damage.damage_dice} ${item.damage.damage_type.name} damage`);
    if (item.armor_class) {
      summaryParts.push(`provides AC ${item.armor_class.base}${item.armor_class.dex_bonus ? ' + Dex' : ''}`);
    }
    if (item.range) {
      summaryParts.push(`has a range of ${item.range.normal}${item.range.long ? `/${item.range.long}` : ''} ft.`);
    }
    const summaryText = summaryParts.length
      ? `${item.name} in D&D 5e ${summaryParts.join(', ')}.`
      : `${item.name} is a D&D 5e ${subCategory || category.toLowerCase()} entry with SRD rules and stats.`;
  %>

  <title><%= pageTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= metaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/equipment/<%= item.index %>" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/equipment/<%= item.index %>" />
  <meta property="og:title" content="<%= pageTitle %>" />
  <meta property="og:description" content="<%= metaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= pageTitle %>" />
  <meta name="twitter:description" content="<%= metaDesc %>" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "name": "<%= pageTitle %>",
      "headline": "<%= item.name %>",
      "description": "<%= metaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/equipment/<%= item.index %>",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Equipment",
            "item": "https://farreachco.com/dnd/5e/srd/equipment"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "<%= item.name %>",
            "item": "https://farreachco.com/dnd/5e/srd/equipment/<%= item.index %>"
          }
        ]
      },
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition",
        "gamePlatform": "Tabletop"
      }
    }
  </script>

  <% if (faqs.length > 0) { %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": <%- JSON.stringify(faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))) %>
    }
  </script>
  <% } %>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: pageTitle,
      srdPageSummary: summaryText
    }) %>
    <br />
    <!-- Breadcrumb -->
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/equipment">Equipment</a>
      <span class="separator">→</span>
      <div class="text-green"><%= item.name %></div>
    </div>
    <hr />

    <!-- Item Header -->
    <h2><%= item.name %></h2>
    <div class="inline-div">
      <i><%= category %></i>
      <% if (subCategory) { %><i>- <%= subCategory %></i><% } %>
    </div>

    <hr class="w-75" />

    <!-- Item Stats -->
    <div class="equipment-stats">
      <% if (item.cost) { %>
      <div class="inline-div">
        <b>Cost:</b>
        <div><%= item.cost.quantity %> <%= item.cost.unit %></div>
      </div>
      <% } %>

      <% if (item.weight) { %>
      <div class="inline-div">
        <b>Weight:</b>
        <div><%= item.weight %> lb.</div>
      </div>
      <% } %>

      <% if (item.damage) { %>
      <div class="inline-div">
        <b>Damage:</b>
        <div><%= item.damage.damage_dice %> <a href="/dnd/5e/srd/damage-types#<%= item.damage.damage_type.index %>"><%= item.damage.damage_type.name %></a></div>
      </div>
      <% } %>

      <% if (item.two_handed_damage) { %>
      <div class="inline-div">
        <b>Two-Handed Damage:</b>
        <div><%= item.two_handed_damage.damage_dice %> <a href="/dnd/5e/srd/damage-types#<%= item.two_handed_damage.damage_type.index %>"><%= item.two_handed_damage.damage_type.name %></a></div>
      </div>
      <% } %>

      <% if (item.range) { %>
      <div class="inline-div">
        <b>Range:</b>
        <div>
          <%= item.range.normal %> ft.
          <% if (item.range.long) { %> / <%= item.range.long %> ft.<% } %>
        </div>
      </div>
      <% } %>

      <% if (item.throw_range) { %>
      <div class="inline-div">
        <b>Throw Range:</b>
        <div>
          <%= item.throw_range.normal %> ft.
          <% if (item.throw_range.long) { %> / <%= item.throw_range.long %> ft.<% } %>
        </div>
      </div>
      <% } %>

      <% if (item.armor_class) { %>
      <div class="inline-div">
        <b>Armor Class:</b>
        <div>
          <%= item.armor_class.base %>
          <% if (item.armor_class.dex_bonus) { %> + Dex<% if (item.armor_class.max_bonus) { %> (max <%= item.armor_class.max_bonus %>)<% } %><% } %>
        </div>
      </div>
      <% } %>

      <% if (item.str_minimum) { %>
      <div class="inline-div">
        <b>Strength Required:</b>
        <div><%= item.str_minimum %></div>
      </div>
      <% } %>

      <% if (item.stealth_disadvantage) { %>
      <div class="inline-div">
        <b>Stealth:</b>
        <div class="text-red">Disadvantage</div>
      </div>
      <% } %>

      <% if (item.properties && item.properties.length) { %>
      <div class="inline-div">
        <b>Properties:</b>
        <div>
          <% item.properties.forEach((prop, idx) => { %>
          <a href="/dnd/5e/srd/weapon-properties#<%= prop.index %>"><%= prop.name %></a><%= idx < item.properties.length - 1 ? ', ' : '' %>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (item.speed) { %>
      <div class="inline-div">
        <b>Speed:</b>
        <div><%= item.speed.quantity %> <%= item.speed.unit %></div>
      </div>
      <% } %>

      <% if (item.capacity) { %>
      <div class="inline-div">
        <b>Capacity:</b>
        <div><%= item.capacity %></div>
      </div>
      <% } %>
    </div>

    <% if (item.desc && item.desc.length) { %>
    <hr class="w-75" />
    <div class="equipment-description">
      <% item.desc.forEach(paragraph => { %>
      <p><%= paragraph %></p>
      <% }) %>
    </div>
    <% } %>

    <% if (item.contents && item.contents.length) { %>
    <hr class="w-75" />
    <b>Contents:</b>
    <ul>
      <% item.contents.forEach(content => { %>
      <li>
        <a href="/dnd/5e/srd/equipment/<%= content.item.index %>"><%= content.item.name %></a>
        <% if (content.quantity > 1) { %> (x<%= content.quantity %>)<% } %>
      </li>
      <% }) %>
    </ul>
    <% } %>

    <% if (faqs.length > 0) { %>
    <hr class="w-75" />
    <section class="srd-faq">
      <p class="srd-faq-label">Frequently Asked Questions</p>
      <% faqs.forEach(faq => { %>
      <details>
        <summary><%= faq.q %></summary>
        <p><%= faq.a %></p>
      </details>
      <% }) %>
    </section>
    <% } %>

    <div class="srd-back-link">
      <a href="/dnd/5e/srd/equipment">&larr; Back to Equipment List</a>
    </div>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
