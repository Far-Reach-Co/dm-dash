<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Monsters - 1340+ Creature Stat Blocks | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E monster reference with 1340+ creatures. Full stat blocks including AC, HP, abilities, actions, legendary actions, and spells. Perfect quick reference for DMs and players." />
  <meta name="keywords" content="D&D 5E monsters, monster stat blocks, creature reference, D&D bestiary, CR ratings, legendary monsters, D&D creatures, DM reference" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/monsters" />
  <meta property="og:title" content="D&D 5E Monsters - 1340+ Creature Stat Blocks" />
  <meta property="og:description" content="Complete D&D 5E monster reference with 1340+ creatures and full stat blocks. Quick reference for DMs." />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Monsters - 1340+ Creature Stat Blocks" />
  <meta name="twitter:description" content="Complete D&D 5E monster reference with 1340+ creatures and full stat blocks." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "D&D 5E Monsters Reference",
    "description": "Complete monster and creature reference for D&D 5th Edition with over 1340 stat blocks",
    "url": "https://farreachco.com/dnd/5e/srd/monsters",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://farreachco.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "D&D 5E SRD",
          "item": "https://farreachco.com/dnd/5e/srd/contents"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Monsters",
          "item": "https://farreachco.com/dnd/5e/srd/monsters"
        }
      ]
    },
    "about": {
      "@type": "Game",
      "name": "Dungeons & Dragons 5th Edition",
      "gamePlatform": "Tabletop"
    }
  }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="inline-div">
      <small>
        <a href="/dnd/5e/srd/contents">Contents</a> ->
        <div class="text-green">Monsters</div>
      </small>
    </div>
    <hr />
    <h2>Monsters</h2>
    <ul>
      <% data.forEach((mon) => { %>
      <li>
        <a href="#<%= mon.index %>"><%= mon.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <!-- how to make a monster -->
    <% data.forEach((mon) => { %>
    <% const spellsPageBase = '/dnd/5e/srd/spells#'; %>
    <div class="inline-div" id="<%= mon.index %>">
      <h2><%= mon.name %></h2>
      <div class="inline-div">
        <i><%= mon.size %>,</i>
        <i><%= mon.type %>,</i>
        <i><%= mon.alignment %></i>
      </div>
    </div>
    <div class=" indent">
      <!-- armor class -->
      <div class=" inline-div">
        <b>Armor Class</b>
        <div>
          <% if (mon.armor_class && mon.armor_class.length) { %>
          <% mon.armor_class.forEach((acEntry, acIndex) => { %>
          <span><%= acEntry.value %> (<%= acEntry.type %>)</span>
          <%= acIndex < mon.armor_class.length - 1 ? ', ' : '' %>
          <% }) %>
          <% } else { %>
          —
          <% } %>
        </div>
      </div>
      <!-- hitpoints------------------- -->
      <div class="inline-div">
        <b>Hit Points</b>
        <div> <%= mon.hit_points%></div>
        <i>(<%= mon.hit_points_roll%>) </i>
      </div>
      <!-- speeds------------------- -->
      <div class="inline-div">
        <b>Speed:</b>
        <div>
          <% 
            const speed = mon.speed || {};
            const order = ['walk','burrow','climb','swim','fly']; 
            const labels = { walk:'Walk ', burrow:'Burrow ', climb:'Climb ', swim:'Swim ', fly:'Fly ' };
          %>
          <% order.forEach(speedType => { 
            const speedValue = speed[speedType];
            if (speedValue) { 
          %>
          <div>
            <%= labels[speedType] %><%= speedValue + ',' %><%= (speedType === 'fly' && speed.hover) 
                  ? ' (hover)' 
                  : '' %>
          </div>
          <%   } }); %>
        </div>
      </div>
      <br>
      <!-- Ability scores------------------- -->
      <hr class="w-50" />
      <div class="inline-div">
        <b>STR</b>
        <div> <%= mon.strength%></div>
        <i>(<%= Math.floor((Number(mon.strength) - 10) / 2) %>)</i>
        <b>DEX</b>
        <div> <%= mon.dexterity%></div>
        <div> (<%= Math.floor((Number(mon.dexterity) - 10) / 2) %>)</div>
        <b>CON</b>
        <div> <%= mon.constitution%></div>
        <div> (<%= Math.floor((Number(mon.constitution) - 10) / 2) %>)</div>
      </div>
      <div class="inline-div">
        <b>INT</b>
        <div> <%= mon.intelligence%></div>
        <div> (<%= Math.floor((Number(mon.intelligence) - 10) / 2) %>)</div>
        <b>WIS</b>
        <div> <%= mon.wisdom%></div>
        <div> (<%= Math.floor((Number(mon.wisdom) - 10) / 2) %>)</div>
        <b>CHA</b>
        <div> <%= mon.charisma%></div>
        <div> (<%= Math.floor((Number(mon.charisma) - 10) / 2) %>)</div>
      </div>
      <hr class="w-50" />
      <br>
      <!-- Saves------------------- -->
      <div class="inline-div">
        <b>Saving Throws:</b>
        <%
          const savingThrowProfs = (mon.proficiencies || []).filter(prof => prof.proficiency.name.startsWith('Saving Throw: '));
        %>
        <% if (savingThrowProfs.length) { %>
        <% savingThrowProfs.forEach((prof, idx) => { %>
        <div><%= prof.proficiency.name.split(': ')[1] %> +<%= prof.value %></div><%= idx < savingThrowProfs.length - 1 ? ', ' : '' %>
        <% }) %>
        <% } else { %>—<% } %>
      </div>
      <!-- Skills v ------------------- -->
      <div class="inline-div">
        <b>Skills:</b>
        <%
          const skillProfs = (mon.proficiencies || []).filter(skill => skill.proficiency.name.startsWith('Skill: '));
        %>
        <% if (skillProfs.length) { %>
        <% skillProfs.forEach((prof, idx) => { %>
        <div><%= prof.proficiency.name.split(': ')[1] %> +<%= prof.value %></div><%= idx < skillProfs.length - 1 ? ', ' : '' %>
        <% }) %>
        <% } else { %>—<% } %>
      </div>
      <!-- Vulnerabilities etc ------------------- -->
      <div class="inline-div">
        <b>Damage Vulnerabilities:</b>
        <%= mon.damage_vulnerabilities && mon.damage_vulnerabilities.length
          ? mon.damage_vulnerabilities.join(', ')
          : '—' %>
      </div>
      <div class="inline-div">
        <b>Damage Resistances:</b>
        <%= mon.damage_resistances && mon.damage_resistances.length
          ? mon.damage_resistances.join(', ')
          : '—' %>
      </div>
      <div class="inline-div">
        <b>Damage Immunities:</b>
        <%= mon.damage_immunities && mon.damage_immunities.length
          ? mon.damage_immunities.join(', ')
          : '—' %>
      </div>
      <div class="inline-div">
        <b>Condition Immunities:</b>
        <%= mon.condition_immunities && mon.condition_immunities.length
          ? mon.condition_immunities.map(condition => condition.name).join(', ')
          : '—' %>
      </div>
      <!-- Senses ------------------- -->
      <div class="inline-div">
        <b>Senses:</b>
        <div>
          <%= mon.senses && Object.keys(mon.senses).length
              ? Object.keys(mon.senses)
                  .filter(function(senseName) {
                    return senseName !== 'passive_perception';
                  })
                  .map(function(senseName) {
                    return senseName + ' ' + String(mon.senses[senseName]);
                  })
                  .join(', ')
              : '—' %>
        </div>
      </div>
      <!-- passive perception ------------------- -->
      <div class="inline-div">
        <b>Passive Perception:</b>
        <div> <%= mon.senses.passive_perception%>
        </div>
      </div>
      <!-- Languages ------------------- -->
      <div class="inline-div">
        <b>Languages:</b> <%= mon.languages || "-" %>
      </div>
      <!-- CR------------------- -->
      <div>
        <%
        const crDisplay = cr => {
            const decimalCR = Number(cr);
            if (decimalCR === 0.125) return '1/8';
            if (decimalCR === 0.25)  return '1/4';
            if (decimalCR === 0.5)   return '1/2';
            return String(cr);
        };
      %>
        <div class="inline-div">
          <b>CR:</b>
          <div>
            <%= crDisplay (mon.challenge_rating)%> </div>
          <i>(<%= mon.xp %> XP)</i>
        </div>
      </div>
      <!-- Profs ------------------- -->
      <div class="inline-div">
        <b>Proficiency Bonus:</b> <%= mon.proficiency_bonus%>
      </div>
      <!-- Traits ------------------- -->
      <div>

        <div>
          <% if (mon.special_abilities && mon.special_abilities.length) { %>
          <% 
            const filteredTraits = mon.special_abilities.filter(
              specialAbility => !specialAbility.name.toLowerCase().includes('spellcasting')
            );
          %>
          <% if (filteredTraits.length) { %>
          <br>
          <h3>Traits:</h3>
          <ul>
            <% filteredTraits.forEach(specialAbility => { %>
            <li>
              <b><%= specialAbility.name %>.</b> <%= specialAbility.desc %>
            </li>
            <% }) %>
            <% } %>
            <% } %>
          </ul>
        </div>
      </div>
      <!-- spellcasting------------------- -->
      <div>
        <% if (mon.special_abilities && mon.special_abilities.length) { %>
        <%
        const spellcastingTraits = mon.special_abilities.filter(
        specialAbility => specialAbility.name.toLowerCase() === ('spellcasting')
        );
        %>
        <% if (spellcastingTraits.length) { %>
        <h3>Spellcasting:</h3>

        <% spellcastingTraits.forEach(specialAbility => { 
           const spellDetails = specialAbility.spellcasting;
        %>
        <div class="indent">
          <%= specialAbility.desc %>
        </div>
        <br>
        <% if (spellDetails) { %>
        <p>
          The <%= mon.name %> is a <%= spellDetails.level %>-level
          <%= spellDetails.ability && spellDetails.ability.name %> caster.
        </p>
        <div class="inline-div">
          <b>Spell Save DC</b>
          <div><%= spellDetails.dc %></div>
        </div>
        <div class="inline-div">
          <b>Spell Attack Modifier</b>
          <div>+<%= spellDetails.modifier %></div>
        </div>
        <!-- Spells Prepared-->
        <%
            const spells = Array.isArray(spellDetails.spells) ? spellDetails.spells : [];
            const slots  = spellDetails.slots || {};
            const cantrips = spells.filter(spell => Number(spell.level) === 0);
            const level1Spells = spells.filter(spell => Number(spell.level) === 1);
            const level1Slots  = Number(slots["1"]);
            %>
        <div class="inline-div">
          <b>Spells Prepared</b>
          <br>
          <div>
            <% if (cantrips.length) { %>
            <p>Cantrips</p><i>(at will)</i>
            <ul><% cantrips.forEach(spell => { %>
              <li>
                <a href="<%= spellsPageBase %><%= (spell.url || '').split('/').pop() %>" target="_blank" rel="noopener noreferrer"><%= spell.name %></a>
              </li><% }) %>
            </ul>
            <% } %>
            <!--leveled spells -->
            <%
              const preparedSpells = Array.isArray(spellDetails.spells) ? spellDetails.spells : [];
              const slotsByLevel   = spellDetails.slots || {};
              const levelSuffixMap = {1:'st', 2:'nd', 3:'rd', 4:'th', 5:'th', 6:'th', 7:'th', 8:'th', 9:'th'};
            %>
            <% for (let currentLevel = 1; currentLevel <= 9; currentLevel++) { 
                const spellsAtThisLevel = preparedSpells.filter(spellItem => Number(spellItem.level) === currentLevel);
                const slotCount = Number(slotsByLevel[String(currentLevel)]);
                const showSection = spellsAtThisLevel.length || Number.isFinite(slotCount);
                if (!showSection) continue;
              %>
            <p><%= currentLevel %><%= levelSuffixMap[currentLevel] %> level</p>
            <% if (Number.isFinite(slotCount)) { %>
            <i>(<%= slotCount %> <%= slotCount === 1 ? 'slot' : 'slots' %>)</i>
            <% } %>
            <ul>
              <% spellsAtThisLevel.forEach(spellItem => { %>
              <li>
                <a href="<%= spellsPageBase %><%= (spellItem.url || '').split('/').pop() %>" target="_blank" rel="noopener noreferrer"><%= spellItem.name %></a>
              </li>
              </li>
              <% }) %>
            </ul>
            <% } %>
          </div>
        </div>
        <% } %>
        <br>
        <% }) %>
        <% } %>
        <% } %>
      </div>
      <!-- Innate Spellcasting------------------- -->
      <div>
        <% if (mon.special_abilities && mon.special_abilities.length) { %>
        <%
        const spellcastingTraits = mon.special_abilities.filter(
        specialAbility => specialAbility.name.toLowerCase().includes('innate spellcasting')
        );
        %>
        <% if (spellcastingTraits.length) { %>
        <h3>Innate Spellcasting:</h3>

        <% spellcastingTraits.forEach(specialAbility => { 
           const spellDetails = specialAbility.spellcasting;
        %>
        <div class="indent">
          <%= specialAbility.desc %>
        </div>
        <br>
        <% if (spellDetails) { %>
        <% if (spellDetails.dc) { %>
        <div class="inline-div">
          <b>Spell Save DC</b>
          <div><%= spellDetails.dc %></div>
        </div>
        <% } %>

        <% if (spellDetails.modifier) { %>
        <div class="inline-div">
          <b>Spell Attack Modifier</b>
          <div><%= spellDetails.modifier %></div>
        </div>
        <% } %>
        <div class="inline-div">
          <b>Spells</b>
          <ul>
            <% spellDetails.spells.forEach((spellEntry) => { 
              const timesPerDay = (spellEntry.usage && typeof spellEntry.usage.times === 'number')
                ? spellEntry.usage.times
                : null;
            %>
            <li>
              <% if (timesPerDay && timesPerDay >= 1) {%>
              <%= timesPerDay %>/day:
              <% } else { %>
              <i>At will</i>
              <% } %>
              <a href="<%= spellsPageBase %><%= (spellEntry.url || '').split('/').pop() %>" target="_blank" rel="noopener noreferrer"><%= spellEntry.name %></a>
              <i>(lvl <%= spellEntry.level %>)</i>
            </li>
            <% }) %>
          </ul>
        </div>
        <% } %>
        <br>
        <% }) %>
        <% } %>
        <% } %>
      </div>
      <!-- Actions------------------- -->
      <div>
        <h3>Actions:</h3>
        <% if (mon.actions && mon.actions.length) { %>
        <ul>
          <% mon.actions.forEach(action => { %>
          <li>
            <p><b><%= action.name %> - </b><%= action.desc %></p>
          </li>
          <% }) %>
        </ul>

        <% } else { %>
        —
        <% } %>
      </div>
      <!-- Legendary Actions ------------------- -->
      <div>
        <% if (mon.legendary_actions && mon.legendary_actions.length) { %>
        <h3>Legendary Actions:</h3>
        <ul>
          <div>
            <p> The <%= mon.name %> can take 3 legendary actions, choosing from the options below. Only one legendary action option can be used at a time and only at the end of another creature’s turn. The <%= mon.name %> regains spent legendary actions at the start of its turn.</p>
            <% mon.legendary_actions.forEach(legAct => { %>
            <li>
              <b><%= legAct.name %>.</b> <%= legAct.desc %>
            </li>
            <% }) %>
          </div>
          <% } %>
        </ul>
      </div>

      <br />

    </div>
    <% }); %>
    <%- include('../../../partials/footer') %>
</body>

</html>