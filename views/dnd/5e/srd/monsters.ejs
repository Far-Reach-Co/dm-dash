<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Monsters - SRD Creature Stat Blocks | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E monster reference with <%= data.length %> SRD creatures. Full stat blocks including AC, HP, abilities, actions, and legendary actions." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/monsters" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/monsters" />
  <meta property="og:title" content="D&D 5E Monsters - SRD Creature Stat Blocks" />
  <meta property="og:description" content="Complete D&D 5E SRD monster reference with full stat blocks and quick lookup links." />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Monsters - SRD Creature Stat Blocks" />
  <meta name="twitter:description" content="Complete D&D 5E SRD monster reference with full stat blocks and quick lookup links." />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "D&D 5E Monsters Reference",
      "description": "Complete monster and creature reference for D&D 5th Edition",
      "url": "https://farreachco.com/dnd/5e/srd/monsters"
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Monsters',
      srdPageSummary: 'Browse the full D&D 5E SRD monster list with quick access to stat blocks, types, and challenge ratings.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Monsters</span>
    </div>
    <hr />

    <h2>Monsters</h2>
    <p>Browse our complete collection of <%= data.length %> monsters from the D&D 5E SRD. Click any monster to view its full stat block.</p>

    <h3>Browse Monster Index Pages</h3>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By Type</div>
      <div class="srd-filter-pills">
        <% monsterTypeOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/monsters/type/<%= opt.slug %>"><%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By Challenge Rating</div>
      <div class="srd-filter-pills">
        <% monsterCrOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/monsters/cr/<%= opt.slug %>">CR <%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By Condition Immunity</div>
      <div class="srd-filter-pills">
        <% monsterConditionImmunityOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/monsters/condition-immunity/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <hr />
    <ul class="srd-col-list-3">
      <% data.forEach((mon) => { %>
      <li>
        <a href="/dnd/5e/srd/monsters/<%= mon.index %>"><%= mon.name %></a>
      </li>
      <% }); %>
    </ul>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
