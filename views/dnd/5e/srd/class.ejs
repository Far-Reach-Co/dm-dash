<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const savingThrowNames = (classData.saving_throws || []).map((score) => score.name);
    const proficiencyNames = (classData.proficiencies || [])
      .map((prof) => String(prof.name || '').replace(/^Skill:\s*/, ''))
      .filter(Boolean);
    const spellListLabel = classSpellCount > 0 ? `${classSpellCount} class spells` : 'no spell list';
    const spellcastingAbilityLabel = classData.spellcasting?.spellcasting_ability?.name || null;
    const classTitle = classSpellCount > 0
      ? `${classData.name} 5e Class: Features, Hit Die, and Spell List`
      : `${classData.name} 5e Class: Features, Hit Die, and Proficiencies`;
    const classMetaDesc = `${classData.name} in D&D 5e: hit die d${classData.hit_die}, saving throws ${savingThrowNames.join(' and ')}.${classSpellCount > 0 ? ` Includes the ${classData.name.toLowerCase()} spell list with ${classSpellCount} SRD spells.` : ''} Full class features, proficiencies, and starting equipment.`.substring(0, 160);
    const classSummary = `${classData.name} is a D&D 5e class with a d${classData.hit_die} hit die and ${savingThrowNames.join(' and ')} saving throws.${classSpellCount > 0 ? ` This page also links the full ${classData.name.toLowerCase()} spell list.` : ''}`;
    const classFaqs = [
      {
        q: `What hit die does the ${classData.name} use in D&D 5e?`,
        a: `The ${classData.name} uses a d${classData.hit_die} hit die in D&D 5e.`
      },
      {
        q: `What saving throws does the ${classData.name} get in D&D 5e?`,
        a: savingThrowNames.length
          ? `The ${classData.name} is proficient in ${savingThrowNames.join(' and ')} saving throws in D&D 5e.`
          : `See the class details on this page for the ${classData.name}'s saving throw proficiencies in D&D 5e.`
      },
      {
        q: `What proficiencies does the ${classData.name} start with in D&D 5e?`,
        a: proficiencyNames.length
          ? `The ${classData.name} starts with proficiencies such as ${proficiencyNames.slice(0, 6).join(', ')}${proficiencyNames.length > 6 ? ', and more' : ''}.`
          : `See the starting proficiencies section on this page for the ${classData.name}'s SRD proficiencies.`
      }
    ];
    if (classSpellCount > 0) {
      classFaqs.push({
        q: `Does the ${classData.name} have spells in D&D 5e?`,
        a: `Yes. The ${classData.name} has a D&D 5e spell list, and this page links ${classSpellCount} SRD ${classData.name.toLowerCase()} spells.`
      });
    }
  %>
  <title><%= classTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= classMetaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/classes/<%= classData.index %>" />

  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/classes/<%= classData.index %>" />
  <meta property="og:title" content="<%= classTitle %>" />
  <meta property="og:description" content="<%= classMetaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= classTitle %>" />
  <meta name="twitter:description" content="<%= classMetaDesc %>" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= classData.name %>",
      "name": "<%= classTitle %>",
      "description": "<%= classMetaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/classes/<%= classData.index %>",
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": <%- JSON.stringify(classFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))) %>
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: `${classData.name} 5E Class`,
      srdPageSummary: classSummary
    }) %>
    <br />

    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/classes">Classes</a>
      <span class="separator">→</span>
      <span class="current"><%= classData.name %></span>
    </div>
    <hr />

    <h1><%= classData.name %></h1>
    <p><%= classSummary %></p>

    <div class="quick-links" aria-label="<%= classData.name %> page sections">
      <a href="#proficiencies">Proficiencies</a>
      <a href="#equipment">Equipment</a>
      <% if (classData.spellcasting) { %><a href="#spellcasting">Spellcasting</a><% } %>
      <a href="#core-features">Core Features</a>
      <% if (subclassFeatures.length) { %><a href="#subclass-features">Subclass Features</a><% } %>
    </div>

    <div class="inline-div">
      <b>Hit Die:</b>
      <span>d<%= classData.hit_die %></span>
    </div>

    <div class="inline-div">
      <b>Saving Throws:</b>
      <span>
        <% (classData.saving_throws || []).forEach((score, idx) => { %>
          <a href="/dnd/5e/srd/ability-scores#<%= String(score.index || '').toLowerCase() %>"><%= score.name %></a><%= idx < classData.saving_throws.length - 1 ? ', ' : '' %>
        <% }) %>
      </span>
    </div>

    <% if (classSpellCount > 0) { %>
      <div class="inline-div">
        <b>Class Spell List:</b>
        <a href="/dnd/5e/srd/spells/class/<%= classData.index %>"><%= classData.name %> Spells (<%= classSpellCount %>)</a>
      </div>
    <% } %>

    <div class="inline-div">
      <b>Related Pages:</b>
      <a href="/dnd/5e/srd/classes">Classes</a>,
      <a href="/dnd/5e/srd/features">Features</a>,
      <a href="/dnd/5e/srd/equipment">Equipment</a>,
      <a href="/dnd/5e/srd/skills">Skills</a>,
      <a href="/dnd/5e/srd/races">Races</a>,
      <a href="/dnd/5e/srd/backgrounds">Backgrounds</a>
    </div>

    <% if (classSpellCount > 0) { %>
      <div class="srd-filter-group">
        <div class="srd-filter-label"><%= classData.name %> Spell Browse</div>
        <div class="srd-filter-pills">
          <a href="/dnd/5e/srd/spells/class/<%= classData.index %>">All <%= classData.name %> Spells (<%= classSpellCount %>)</a>
          <% classSpellLevels.forEach((level) => { %>
            <a href="/dnd/5e/srd/spells/level/<%= level %>"><%= level === 0 ? 'Cantrips' : 'Level ' + level %></a>
          <% }) %>
        </div>
      </div>

      <% if (classSpellSchoolOptions.length) { %>
        <div class="srd-filter-group">
          <div class="srd-filter-label">Popular Schools In The <%= classData.name %> Spell List</div>
          <div class="srd-filter-pills">
            <% classSpellSchoolOptions.forEach((opt) => { %>
              <a href="/dnd/5e/srd/spells/school/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <% if (classSpellDamageTypeOptions.length) { %>
        <div class="srd-filter-group">
          <div class="srd-filter-label">Common Damage Types In The <%= classData.name %> Spell List</div>
          <div class="srd-filter-pills">
            <% classSpellDamageTypeOptions.forEach((opt) => { %>
              <a href="/dnd/5e/srd/spells/damage/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
            <% }) %>
          </div>
        </div>
      <% } %>
    <% } %>

    <% if (relatedSpellcastingClasses.length) { %>
      <div class="srd-see-also">
        <h3>Other <%= spellcastingAbilityLabel %> Spellcasters</h3>
        <ul>
          <% relatedSpellcastingClasses.forEach((relatedClass) => { %>
            <li><a href="/dnd/5e/srd/classes/<%= relatedClass.index %>"><%= relatedClass.name %></a></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <hr class="w-75" />
    <section class="srd-faq">
      <p class="srd-faq-label">Frequently Asked Questions</p>
      <% classFaqs.forEach((faq) => { %>
        <details>
          <summary><%= faq.q %></summary>
          <p><%= faq.a %></p>
        </details>
      <% }) %>
    </section>

    <hr class="w-75" />

    <% if (tablePartial) { %>
      <h2>Progression Table</h2>
      <div style="overflow-x:auto;">
        <%- include(tablePartial) %>
      </div>
      <hr class="w-75" />
    <% } %>

    <h2 id="proficiencies">Starting Proficiencies</h2>
    <ul>
      <% (classData.proficiencies || []).forEach((prof) => { 
        const profName = String(prof.name || '').replace(/^Skill:\s*/, '');
        let href = '';
        if (String(prof.index || '').startsWith('skill-')) {
          href = '/dnd/5e/srd/skills#' + String(prof.index).replace('skill-', '');
        } else if (profName.toLowerCase().includes('armor')) {
          href = '/dnd/5e/srd/equipment#armor';
        } else if (profName.toLowerCase().includes('weapon')) {
          href = '/dnd/5e/srd/equipment#weapon';
        } else if (profName.toLowerCase().includes('tool')) {
          href = '/dnd/5e/srd/equipment#tools';
        }
      %>
        <li>
          <% if (href) { %>
            <a href="<%= href %>"><%= profName %></a>
          <% } else { %>
            <%= profName %>
          <% } %>
        </li>
      <% }) %>
    </ul>

    <% if ((classData.proficiency_choices || []).length) { %>
      <h3>Proficiency Choices</h3>
      <% classData.proficiency_choices.forEach((choice) => { %>
        <p><%= choice.desc %></p>
      <% }) %>
    <% } %>

    <hr class="w-75" />

    <h2 id="equipment">Starting Equipment</h2>
    <ul>
      <% (classData.starting_equipment || []).forEach((entry) => { %>
        <li>
          <a href="/dnd/5e/srd/equipment/<%= entry.equipment.index %>"><%= entry.equipment.name %></a>
          <% if (entry.quantity > 1) { %> (x<%= entry.quantity %>) <% } %>
        </li>
      <% }) %>
    </ul>

    <% if ((classData.starting_equipment_options || []).length) { %>
      <h3>Equipment Options</h3>
      <ul>
        <% classData.starting_equipment_options.forEach((option) => { %>
          <li><%= option.desc %></li>
        <% }) %>
      </ul>
    <% } %>

    <% if (classData.spellcasting) { %>
      <hr class="w-75" />
      <h2 id="spellcasting">Spellcasting</h2>
      <div class="inline-div">
        <b>Spellcasting Ability:</b>
        <a href="/dnd/5e/srd/ability-scores#<%= String(classData.spellcasting.spellcasting_ability.index || '').toLowerCase() %>"><%= classData.spellcasting.spellcasting_ability.name %></a>
      </div>

      <% (classData.spellcasting.info || []).forEach((block) => { %>
        <h3><%= block.name %></h3>
        <% (block.desc || []).forEach((paragraph) => { %>
          <p><%= paragraph %></p>
        <% }) %>
      <% }) %>
    <% } %>

    <hr class="w-75" />
    <h2 id="core-features">Core Features</h2>
    <% if (!baseFeatures.length) { %>
      <p>No standalone class feature entries were found in the SRD dataset for this class.</p>
    <% } %>
    <% baseFeatures.forEach((feature) => { %>
      <div id="<%= feature.index %>">
        <h3>
          Level <%= feature.level %> -
          <a href="/dnd/5e/srd/features/<%= feature.index %>"><%= feature.name %></a>
        </h3>
        <% (feature.desc || []).forEach((paragraph) => { %>
          <p><%= paragraph %></p>
        <% }) %>
      </div>
    <% }) %>

    <% if (subclassFeatures.length) { %>
      <hr class="w-75" />
      <h2 id="subclass-features">Subclass Features</h2>
      <% subclassFeatures.forEach((group) => { %>
        <h3><%= group.name %></h3>
        <% group.features.forEach((feature) => { %>
          <div id="<%= feature.index %>">
            <h4>
              Level <%= feature.level %> -
              <a href="/dnd/5e/srd/features/<%= feature.index %>"><%= feature.name %></a>
            </h4>
            <% (feature.desc || []).forEach((paragraph) => { %>
              <p><%= paragraph %></p>
            <% }) %>
          </div>
        <% }) %>
      <% }) %>
    <% } %>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
