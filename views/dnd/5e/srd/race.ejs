<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <%
    const raceAbilityBonuses = (race.ability_bonuses || [])
      .map((bonus) => `${bonus.ability_score.name} +${bonus.bonus}`);
    const raceLanguages = (race.languages || []).map((lang) => lang.name);
    const hasSubraces = Boolean(subraceDetails.length);
    const raceTitle = `${race.name} 5e Race: Traits, Ability Scores, and Languages`;
    const raceMetaDesc = `${race.name} in D&D 5e: ${race.size} race with speed ${race.speed} ft.${raceAbilityBonuses.length ? ` Ability bonuses: ${raceAbilityBonuses.join(', ')}.` : ''}${raceLanguages.length ? ` Languages: ${raceLanguages.join(', ')}.` : ''}${hasSubraces ? ' Includes subraces and racial traits.' : ' Includes racial traits and rules.'}`.substring(0, 160);
    const raceSummary = `${race.name} is a ${race.size.toLowerCase()} D&D 5e race with a speed of ${race.speed} feet.${raceAbilityBonuses.length ? ` Its SRD ability bonuses are ${raceAbilityBonuses.join(', ')}.` : ''}${raceLanguages.length ? ` It typically speaks ${raceLanguages.join(' and ')}.` : ''}`;
    const raceFaqs = [
      {
        q: `What ability bonuses does the ${race.name} get in D&D 5e?`,
        a: raceAbilityBonuses.length
          ? `The ${race.name} gets the following ability bonuses in D&D 5e: ${raceAbilityBonuses.join(', ')}.`
          : `See the ability bonus section on this page for the ${race.name}'s D&D 5e racial bonuses.`
      },
      {
        q: `What languages does the ${race.name} speak in D&D 5e?`,
        a: raceLanguages.length
          ? `The ${race.name} speaks ${raceLanguages.join(' and ')} in D&D 5e.`
          : `See the language section on this page for the ${race.name}'s D&D 5e languages.`
      },
      {
        q: `What size and speed is the ${race.name} in D&D 5e?`,
        a: `The ${race.name} is ${race.size.toLowerCase()} and has a speed of ${race.speed} feet in D&D 5e.`
      }
    ];
    if (hasSubraces) {
      raceFaqs.push({
        q: `Does the ${race.name} have subraces in D&D 5e?`,
        a: `Yes. The ${race.name} has ${subraceDetails.length} subrace option${subraceDetails.length === 1 ? '' : 's'} in this SRD page: ${subraceDetails.map((subrace) => subrace.name).join(', ')}.`
      });
    }
  %>
  <title><%= raceTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= raceMetaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/races/<%= race.index %>" />

  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/races/<%= race.index %>" />
  <meta property="og:title" content="<%= raceTitle %>" />
  <meta property="og:description" content="<%= raceMetaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= raceTitle %>" />
  <meta name="twitter:description" content="<%= raceMetaDesc %>" />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "<%= race.name %>",
      "name": "<%= raceTitle %>",
      "description": "<%= raceMetaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/races/<%= race.index %>"
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": <%- JSON.stringify(raceFaqs.map((faq) => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": { "@type": "Answer", "text": faq.a }
      }))) %>
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: `${race.name} 5E Race`,
      srdPageSummary: raceSummary
    }) %>
    <br />

    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/races">Races</a>
      <span class="separator">→</span>
      <span class="current"><%= race.name %></span>
    </div>
    <hr />

    <h1><%= race.name %></h1>
    <p><%= raceSummary %></p>

    <div class="inline-div">
      <b>Size:</b>
      <span><%= race.size %></span>
    </div>
    <div class="inline-div">
      <b>Speed:</b>
      <span><%= race.speed %> ft.</span>
    </div>

    <% if ((race.ability_bonuses || []).length) { %>
      <div class="inline-div">
        <b>Ability Bonuses:</b>
        <span>
          <% race.ability_bonuses.forEach((bonus, idx) => { %>
            <a href="/dnd/5e/srd/ability-scores#<%= bonus.ability_score.index %>"><%= bonus.ability_score.name %></a> +<%= bonus.bonus %><%= idx < race.ability_bonuses.length - 1 ? ', ' : '' %>
          <% }) %>
        </span>
      </div>
    <% } %>

    <% if ((race.languages || []).length) { %>
      <div class="inline-div">
        <b>Languages:</b>
        <span>
          <% race.languages.forEach((lang, idx) => { %>
            <a href="/dnd/5e/srd/languages#<%= lang.index %>"><%= lang.name %></a><%= idx < race.languages.length - 1 ? ', ' : '' %>
          <% }) %>
        </span>
      </div>
    <% } %>

    <hr class="w-75" />
    <section class="srd-faq">
      <p class="srd-faq-label">Frequently Asked Questions</p>
      <% raceFaqs.forEach((faq) => { %>
        <details>
          <summary><%= faq.q %></summary>
          <p><%= faq.a %></p>
        </details>
      <% }) %>
    </section>

    <hr class="w-75" />

    <% if (race.size_description) { %>
      <h2>Size Description</h2>
      <p><%= race.size_description %></p>
    <% } %>

    <% if (race.age) { %>
      <h2>Age</h2>
      <p><%= race.age %></p>
    <% } %>

    <% if (race.alignment) { %>
      <h2>Alignment</h2>
      <p><%= race.alignment %></p>
    <% } %>

    <% if (race.language_desc) { %>
      <h2>Language Description</h2>
      <p><%= race.language_desc %></p>
    <% } %>

    <hr class="w-75" />
    <h2>Racial Traits</h2>
    <% if (!traitDetails.length) { %>
      <p>No detailed trait entries were found for this race in the SRD dataset.</p>
    <% } %>
    <% traitDetails.forEach((trait) => { %>
      <div id="<%= trait.index %>">
        <h3><%= trait.name %></h3>
        <% (trait.desc || []).forEach((paragraph) => { %>
          <p><%= paragraph %></p>
        <% }) %>

        <% if ((trait.proficiencies || []).length) { %>
          <h4>Proficiencies</h4>
          <ul>
            <% trait.proficiencies.forEach((prof) => { %>
              <li>
                <% if (String(prof.index || '').startsWith('skill-')) { %>
                  <a href="/dnd/5e/srd/skills#<%= String(prof.index).replace('skill-', '') %>"><%= prof.name %></a>
                <% } else { %>
                  <%= prof.name %>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>

        <% if (trait.trait_specific && trait.trait_specific.spell_options) { %>
          <h4>Spell Options</h4>
          <p>Choose <%= trait.trait_specific.spell_options.choose %>:</p>
          <ul>
            <% ((trait.trait_specific.spell_options.from || {}).options || []).forEach((option) => { %>
              <% if (option.item && option.item.index) { %>
                <li><a href="/dnd/5e/srd/spells/<%= option.item.index %>"><%= option.item.name %></a></li>
              <% } %>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% }) %>

    <% if (subraceDetails.length) { %>
      <hr class="w-75" />
      <h2>Subraces</h2>
      <% subraceDetails.forEach((subrace) => { %>
        <div id="<%= subrace.index %>">
          <h3><%= subrace.name %></h3>
          <% if (subrace.desc) { %>
            <p><%= subrace.desc %></p>
          <% } %>

          <% if ((subrace.ability_bonuses || []).length) { %>
            <div class="inline-div">
              <b>Ability Bonuses:</b>
              <span>
                <% subrace.ability_bonuses.forEach((bonus, idx) => { %>
                  <a href="/dnd/5e/srd/ability-scores#<%= bonus.ability_score.index %>"><%= bonus.ability_score.name %></a> +<%= bonus.bonus %><%= idx < subrace.ability_bonuses.length - 1 ? ', ' : '' %>
                <% }) %>
              </span>
            </div>
          <% } %>

          <% if (subrace.traitDetails && subrace.traitDetails.length) { %>
            <h4>Subrace Traits</h4>
            <% subrace.traitDetails.forEach((trait) => { %>
              <div id="<%= trait.index %>">
                <h5><%= trait.name %></h5>
                <% (trait.desc || []).forEach((paragraph) => { %>
                  <p><%= paragraph %></p>
                <% }) %>
              </div>
            <% }) %>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <div class="srd-back-link">
      <a href="/dnd/5e/srd/races">&larr; All Races</a>
      &ensp;&middot;&ensp;
      <a href="/dnd/5e/srd/classes">Classes</a>
      &ensp;&middot;&ensp;
      <a href="/dnd/5e/srd/backgrounds">Backgrounds</a>
    </div>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
