<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D | 5e | SRD | Features | Far Reach Co.</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Features</span>
    </div>
    <hr />
    <h2>Features</h2>
    <ul>
      <% data.forEach(function(features){ %>
      <li>
        <a href="#<%= features.index %>"><%= features.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(feature){ %>
    <div class="inline-div" id="<%= feature.index %>">
      <h3><%= feature.name %></h3>
      </span>
      <div class="indent">
        <div class="breadcrumbs">
          <h4>Class:</h4>
          <p><%= feature.class.name %></p>
          </span>
          <% if (feature.subclass) { %>
          <div class="breadcrumbs">
            <h4>Sub Class:</h4>
            <p><%= feature.subclass.name %></p>
            </span>
            <% } %> <% feature.desc.forEach((str, index) => { %>
            <p><%= str %></p>
            <% }) %>
            <br />
            </span>
            <br />
            <% }); %>
            </span>
            <%- include('../../../partials/footer') %>
</body>

</html>