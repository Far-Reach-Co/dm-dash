<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Damage Types Reference | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E damage types reference including Acid, Bludgeoning, Cold, Fire, Force, Lightning, Necrotic, Piercing, Poison, Psychic, Radiant, Slashing, and Thunder damage with descriptions." />
  <meta name="keywords" content="D&D 5E damage types, acid damage, fire damage, cold damage, lightning damage, necrotic damage, radiant damage, psychic damage, force damage" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/damage-types" />
  <meta property="og:title" content="D&D 5E Damage Types Reference" />
  <meta property="og:description" content="Complete D&D 5E damage types reference with descriptions." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Damage Types Reference",
      "url": "https://farreachco.com/dnd/5e/srd/damage-types",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Damage Types",
            "item": "https://farreachco.com/dnd/5e/srd/damage-types"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Damage Types</span>
    </div>
    <hr />
    <h2>Damage Types</h2>
    <ul>
      <% data.forEach(function(dType){ %>
      <li>
        <a href="#<%= dType.index %>"><%= dType.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(dType){ %>
    <div class="inline-div" id="<%= dType.index %>">
      <h3><%= dType.name %></h3>
      </span>
      <div class="indent">
        <% dType.desc.forEach((str, index) => { %>
        <p><%= str %></p>
        <% }) %>
        </span>
        <br />
        <% }); %>
        </span>
        <%- include('../../../partials/footer') %>
</body>

</html>