<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Backgrounds - SRD Index | Far Reach Co.</title>
  <meta name="description" content="Browse D&D 5E SRD backgrounds with standalone pages for proficiencies, starting equipment, feature text, and roleplay traits." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/backgrounds" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/backgrounds" />
  <meta property="og:title" content="D&D 5E Backgrounds - SRD Index" />
  <meta property="og:description" content="Standalone SRD pages for D&D 5E backgrounds." />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Backgrounds - SRD Index" />
  <meta name="twitter:description" content="Standalone SRD pages for D&D 5E backgrounds." />

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />

    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Backgrounds</span>
    </div>
    <hr />

    <h2>Backgrounds</h2>
    <p>Each background now has a standalone URL for easier sharing and clearer indexing.</p>

    <ul class="srd-col-list-2">
      <% data.forEach((background) => { %>
      <li>
        <a href="/dnd/5e/srd/backgrounds/<%= background.index %>"><%= background.name %></a>
      </li>
      <% }) %>
    </ul>

    <div class="srd-see-also">
      <h3>Also See</h3>
      <ul>
        <li><a href="/dnd/5e/srd/races">Races</a></li>
        <li><a href="/dnd/5e/srd/classes">Classes</a></li>
      </ul>
    </div>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
