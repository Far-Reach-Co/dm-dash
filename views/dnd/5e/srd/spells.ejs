<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Spells - Complete SRD Spell List | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes including Bard, Cleric, Druid, Paladin, Ranger, Sorcerer, Warlock, and Wizard. Full spell descriptions, components, and casting details." />
  <meta name="keywords" content="D&D 5E spells, spell list, wizard spells, cleric spells, sorcerer spells, warlock spells, druid spells, bard spells, paladin spells, ranger spells, cantrips, magic schools" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/spells" />
  <meta property="og:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta property="og:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells. Full descriptions and casting details." />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta name="twitter:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "D&D 5E Spells Reference",
    "description": "Complete spell reference for D&D 5th Edition with over <%= spellsData.length %> spells",
    "url": "https://farreachco.com/dnd/5e/srd/spells",
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://farreachco.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "D&D 5E SRD",
          "item": "https://farreachco.com/dnd/5e/srd/contents"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Spells",
          "item": "https://farreachco.com/dnd/5e/srd/spells"
        }
      ]
    },
    "about": {
      "@type": "Game",
      "name": "Dungeons & Dragons 5th Edition",
      "gamePlatform": "Tabletop"
    }
  }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="inline-div">
      <small>
        <a href="/dnd/5e/srd/contents">Contents</a> ->
        <div class="text-green">Spells</div>
      </small>
    </div>
    <hr />
    <h2>Spells</h2>
    <p>Browse our complete collection of <%= spellsData.length %> spells from the D&D 5E SRD. Click any spell to view full details including casting time, components, and effects.</p>
    <ul style="column-count: 3; column-gap: 20px;">
      <% spellsData.sort((a, b) => a.name.localeCompare(b.name)).forEach(spell => { %>
      <li>
        <a href="/dnd/5e/srd/spells/<%= spell.index %>"><%= spell.name %></a>
      </li>
      <% }); %>
    </ul>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
