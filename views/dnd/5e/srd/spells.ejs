<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Spells - Complete SRD Spell List | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes including Bard, Cleric, Druid, Paladin, Ranger, Sorcerer, Warlock, and Wizard. Full spell descriptions, components, and casting details." />
  <meta name="keywords" content="D&D 5E spells, spell list, wizard spells, cleric spells, sorcerer spells, warlock spells, druid spells, bard spells, paladin spells, ranger spells, cantrips, magic schools" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/spells" />
  <meta property="og:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta property="og:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells. Full descriptions and casting details." />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta name="twitter:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes." />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Spells Reference",
      "description": "Complete spell reference for D&D 5th Edition with over <%= spellsData.length %> spells",
      "url": "https://farreachco.com/dnd/5e/srd/spells",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Spells",
            "item": "https://farreachco.com/dnd/5e/srd/spells"
          }
        ]
      },
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition",
        "gamePlatform": "Tabletop"
      }
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro') %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <div class="text-green">Spells</div>
    </div>
    <hr />
    <h2>Spells</h2>
    <p>Browse our complete collection of <%= spellsData.length %> spells from the D&D 5E SRD. Click any spell to view full details including casting time, components, and effects.</p>

    <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 8px;">
      <span style="font-size: 0.85rem; color: var(--light-gray); margin-right: 4px;">School</span>
      <div class="quick-links" id="school-filter" style="margin-bottom: 0;">
        <a href="#" data-school="all" class="active">All</a>
        <a href="#" data-school="abjuration">Abjuration</a>
        <a href="#" data-school="conjuration">Conjuration</a>
        <a href="#" data-school="divination">Divination</a>
        <a href="#" data-school="enchantment">Enchantment</a>
        <a href="#" data-school="evocation">Evocation</a>
        <a href="#" data-school="illusion">Illusion</a>
        <a href="#" data-school="necromancy">Necromancy</a>
        <a href="#" data-school="transmutation">Transmutation</a>
      </div>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 8px;">
      <span style="font-size: 0.85rem; color: var(--light-gray); margin-right: 4px;">Level</span>
      <div class="quick-links" id="level-filter" style="margin-bottom: 0;">
        <a href="#" data-level="all" class="active">All</a>
        <a href="#" data-level="0">Cantrip</a>
        <a href="#" data-level="1">1st</a>
        <a href="#" data-level="2">2nd</a>
        <a href="#" data-level="3">3rd</a>
        <a href="#" data-level="4">4th</a>
        <a href="#" data-level="5">5th</a>
        <a href="#" data-level="6">6th</a>
        <a href="#" data-level="7">7th</a>
        <a href="#" data-level="8">8th</a>
        <a href="#" data-level="9">9th</a>
      </div>
    </div>

    <p id="spell-count" style="font-size: 0.9rem; color: var(--light-gray);"></p>

    <ul id="spell-list" style="column-count: 3; column-gap: 20px;">
      <% spellsData.sort((a, b) => a.name.localeCompare(b.name)).forEach(spell => { %>
      <li data-school="<%= spell.school.index %>" data-level="<%= spell.level %>">
        <a href="/dnd/5e/srd/spells/<%= spell.index %>"><%= spell.name %></a>
        <span class="spell-meta"><%= spell.level === 0 ? 'Cantrip' : 'Lvl ' + spell.level %> · <%= spell.school.name %></span>
      </li>
      <% }); %>
    </ul>

    <script>
      (function() {
        var schoolFilter = document.getElementById('school-filter');
        var levelFilter = document.getElementById('level-filter');
        var items = document.querySelectorAll('#spell-list li');
        var countEl = document.getElementById('spell-count');
        var total = items.length;
        var activeSchool = 'all';
        var activeLevel = 'all';

        function update() {
          var shown = 0;
          for (var i = 0; i < items.length; i++) {
            var schoolMatch = activeSchool === 'all' || items[i].dataset.school === activeSchool;
            var levelMatch = activeLevel === 'all' || items[i].dataset.level === activeLevel;
            var show = schoolMatch && levelMatch;
            items[i].style.display = show ? '' : 'none';
            if (show) shown++;
          }
          var filtering = activeSchool !== 'all' || activeLevel !== 'all';
          countEl.textContent = filtering
            ? shown + ' of ' + total + ' spells'
            : '';
        }

        function bindFilter(container, setActive) {
          container.addEventListener('click', function(e) {
            if (e.target.tagName !== 'A') return;
            e.preventDefault();
            var links = container.querySelectorAll('a');
            for (var i = 0; i < links.length; i++) links[i].classList.remove('active');
            e.target.classList.add('active');
            setActive(e.target.dataset.school || e.target.dataset.level);
            update();
          });
        }

        bindFilter(schoolFilter, function(v) { activeSchool = v; });
        bindFilter(levelFilter, function(v) { activeLevel = v; });
      })();
    </script>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>