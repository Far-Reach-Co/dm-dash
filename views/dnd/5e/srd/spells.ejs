<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Spells - Complete SRD Spell List | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes including Bard, Cleric, Druid, Paladin, Ranger, Sorcerer, Warlock, and Wizard. Browse by level, school, class, damage type, and casting details." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/spells" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/spells" />
  <meta property="og:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta property="og:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells. Browse by level, school, class, damage type, and casting details." />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Spells - Complete SRD Spell List" />
  <meta name="twitter:description" content="Complete D&D 5E spell reference with <%= spellsData.length %>+ spells for all classes." />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "D&D 5E Spells Reference",
      "description": "Complete spell reference for D&D 5th Edition with over <%= spellsData.length %> spells",
      "url": "https://farreachco.com/dnd/5e/srd/spells"
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Spells',
      srdPageSummary: 'Browse the full D&D 5E SRD spell list with filters by level, school, class, and damage type.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <div class="text-green">Spells</div>
    </div>
    <hr />
    <h2>Spells</h2>
    <p>Browse our complete collection of <%= spellsData.length %> spells from the D&D 5E SRD. Click any spell to view full details including casting time, components, and effects.</p>

    <h3>Browse Spell Index Pages</h3>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By Level</div>
      <div class="srd-filter-pills">
        <% spellLevelOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/spells/level/<%= opt.value %>"><%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By School</div>
      <div class="srd-filter-pills">
        <% spellSchoolOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/spells/school/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <div class="srd-filter-group">
      <div class="srd-filter-label">By Class</div>
      <div class="srd-filter-pills">
        <% spellClassOptions.forEach((opt) => { %>
          <a href="/dnd/5e/srd/spells/class/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
        <% }) %>
      </div>
    </div>

    <% if (spellDamageTypeOptions && spellDamageTypeOptions.length) { %>
      <div class="srd-filter-group">
        <div class="srd-filter-label">By Damage Type</div>
        <div class="srd-filter-pills">
          <% spellDamageTypeOptions.forEach((opt) => { %>
            <a href="/dnd/5e/srd/spells/damage/<%= opt.index %>"><%= opt.label %> (<%= opt.count %>)</a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <hr />

    <div class="srd-filter-row">
      <span class="srd-filter-label">School</span>
      <div class="quick-links" id="school-filter">
        <a href="#" data-school="all" class="active">All</a>
        <% spellSchoolOptions.forEach((opt) => { %>
          <a href="#" data-school="<%= opt.index %>"><%= opt.label %></a>
        <% }) %>
      </div>
    </div>

    <div class="srd-filter-row">
      <span class="srd-filter-label">Level</span>
      <div class="quick-links" id="level-filter">
        <a href="#" data-level="all" class="active">All</a>
        <% spellLevelOptions.forEach((opt) => { %>
          <a href="#" data-level="<%= opt.value %>"><%= opt.value === 0 ? 'Cantrip' : opt.value + (opt.value === 1 ? 'st' : opt.value === 2 ? 'nd' : opt.value === 3 ? 'rd' : 'th') %></a>
        <% }) %>
      </div>
    </div>

    <p id="spell-count" style="font-size: 0.9rem; color: var(--light-gray);"></p>

    <ul id="spell-list" class="srd-col-list-3">
      <% spellsData.forEach(spell => { %>
      <li data-school="<%= spell.school.index %>" data-level="<%= spell.level %>">
        <a href="/dnd/5e/srd/spells/<%= spell.index %>"><%= spell.name %></a>
        <span class="spell-meta"><%= spell.level === 0 ? 'Cantrip' : 'Lvl ' + spell.level %> · <%= spell.school.name %></span>
      </li>
      <% }); %>
    </ul>

    <script>
      (function() {
        var schoolFilter = document.getElementById('school-filter');
        var levelFilter = document.getElementById('level-filter');
        var items = document.querySelectorAll('#spell-list li');
        var countEl = document.getElementById('spell-count');
        var total = items.length;
        var activeSchool = 'all';
        var activeLevel = 'all';

        function update() {
          var shown = 0;
          for (var i = 0; i < items.length; i++) {
            var schoolMatch = activeSchool === 'all' || items[i].dataset.school === activeSchool;
            var levelMatch = activeLevel === 'all' || items[i].dataset.level === activeLevel;
            var show = schoolMatch && levelMatch;
            items[i].style.display = show ? '' : 'none';
            if (show) shown++;
          }
          var filtering = activeSchool !== 'all' || activeLevel !== 'all';
          countEl.textContent = filtering ? shown + ' of ' + total + ' spells' : '';
        }

        function bindFilter(container, setActive) {
          container.addEventListener('click', function(e) {
            if (e.target.tagName !== 'A') return;
            e.preventDefault();
            var links = container.querySelectorAll('a');
            for (var i = 0; i < links.length; i++) links[i].classList.remove('active');
            e.target.classList.add('active');
            setActive(e.target.dataset.school || e.target.dataset.level);
            update();
          });
        }

        bindFilter(schoolFilter, function(v) { activeSchool = v; });
        bindFilter(levelFilter, function(v) { activeLevel = v; });
      })();
    </script>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
