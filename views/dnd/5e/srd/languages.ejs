<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Languages',
      srdPageSummary: 'Browse D&D 5E SRD languages with script, speaker, and lore notes where available.'
