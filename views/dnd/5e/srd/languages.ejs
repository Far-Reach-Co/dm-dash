<% if (typeof srdEdition !== 'undefined' && srdEdition === '2024') { %>
<%- include('partials/edition-page') %>
<% } else { %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Languages List: Standard and Exotic Languages | Far Reach Co.</title>
  <meta name="description" content="Full D&D 5E languages list, including Standard and Exotic languages like Common, Elvish, Draconic, Infernal, and Undercommon, plus typical speakers and scripts." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/languages" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/languages" />
  <meta property="og:title" content="D&D 5E Languages List: Standard and Exotic Languages" />
  <meta property="og:description" content="Full D&D 5E language list with Standard and Exotic languages, typical speakers, and scripts." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Languages List: Standard and Exotic Languages",
      "url": "https://farreachco.com/dnd/5e/srd/languages",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Languages",
            "item": "https://farreachco.com/dnd/5e/srd/languages"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E Languages List',
      srdPageSummary: 'Use this D&D 5E language list to browse every Standard and Exotic SRD language, plus scripts, speakers, and quick lore notes.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Languages</span>
    </div>
    <hr />
    <h2>Full List of D&D 5E Languages</h2>
    <p>D&D 5e includes <strong>16 languages</strong> split into two categories. <strong>Standard languages</strong> (Common, Dwarvish, Elvish, Giant, Gnomish, Goblin, Halfling, Orc) are spoken by common races and are the most likely to be encountered in everyday play. <strong>Exotic languages</strong> (Abyssal, Celestial, Draconic, Deep Speech, Infernal, Primordial, Sylvan, Undercommon) are associated with monsters, outsiders, and ancient cultures. Most characters start with Common plus any languages granted by their race or background.</p>
    <p>When people search for D&D languages, they usually want the full language list first, then who speaks each language and what script it uses. This page is built to answer that directly.</p>
    <div class="inline-div">
      <b>Standard Languages:</b>
      <div>Common, Dwarvish, Elvish, Giant, Gnomish, Goblin, Halfling, Orc</div>
    </div>
    <div class="inline-div">
      <b>Exotic Languages:</b>
      <div>Abyssal, Celestial, Draconic, Deep Speech, Infernal, Primordial, Sylvan, Undercommon</div>
    </div>
    <ul>
      <% data.forEach(function(language){ %>
      <li>
        <a href="#<%= language.index %>"><%= language.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(language){ %>
    <div id="<%= language.index %>">
      <h3><%= language.name %></h3>
      <div class="indent">
        <% if (language.type) { %><p><i><%= language.type %> language<% if (language.script) { %> &mdash; <%= language.script %> script<% } %></i></p><% } %>
        <h4>Typical Speakers</h4>
        <ul>
          <% language.typical_speakers.forEach(speaker => { %>
          <li><%= speaker %></li>
          <% }) %>
        </ul>
        <% if (language.desc) { %>
        <div class="indent">
          <p><%= language.desc %></p>
        </div>
        <% } %>
      </div>
    </div>
    <br>
    <% }); %>

  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>

<% } %>
