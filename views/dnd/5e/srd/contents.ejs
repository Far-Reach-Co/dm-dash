<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E SRD Contents - Reference Hub | Far Reach Co.</title>
  <meta name="description" content="Complete D&D 5E SRD reference hub with crawlable links to spells, monsters, classes, equipment, and rules lookup tools." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/contents" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/contents" />
  <meta property="og:title" content="D&D 5E SRD Contents - Reference Hub" />
  <meta property="og:description" content="Complete D&D 5E SRD reference hub with spell, monster, class, equipment, and rules links." />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E SRD Contents - Reference Hub" />
  <meta name="twitter:description" content="Complete D&D 5E SRD reference hub with spell, monster, class, equipment, and rules links." />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "D&D 5E SRD Table of Contents",
      "description": "Table of contents for the D&D 5E System Reference Document pages",
      "url": "https://farreachco.com/dnd/5e/srd/contents",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://farreachco.com/dnd/5e/srd/contents?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/marked.min.js" defer></script>
  <script src="/lib/purify.min.js" defer></script>
  <script src="/lib/srdSearch.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Contents',
      srdPageSummary: 'Use this hub to browse the main D&D 5E SRD categories, popular pages, and rules lookup tools.'
    }) %>

    <div class="srd-search">
      <h3>Ask the Archives</h3>
      <p>Ask a question about D&D 5E rules, spells, monsters, and more.</p>
      <form id="srd-search-form" class="srd-search-form">
        <input type="text" id="srd-search-input" placeholder="e.g. What spells deal fire damage at level 3?" autocomplete="off" />
        <button type="submit">Search</button>
      </form>
      <div id="srd-search-results" class="search-results"></div>
      <small class="search-attribution">Powered by <a href="https://mistral.ai" target="_blank" rel="noopener noreferrer">Mistral AI</a></small>
    </div>

    <hr />
    <h2>Table of Contents</h2>
    <ul>
      <li><a href="/dnd/5e/srd/ability-scores">Ability Scores</a></li>
      <li><a href="/dnd/5e/srd/alignments">Alignments</a></li>
      <li><a href="/dnd/5e/srd/backgrounds">Backgrounds</a></li>
      <li><a href="/dnd/5e/srd/classes">Classes</a></li>
      <li><a href="/dnd/5e/srd/conditions">Conditions</a></li>
      <li><a href="/dnd/5e/srd/damage-types">Damage Types</a></li>
      <li><a href="/dnd/5e/srd/equipment">Equipment + Magic Items</a></li>
      <li><a href="/dnd/5e/srd/feats">Feats</a></li>
      <li><a href="/dnd/5e/srd/features">Features</a></li>
      <li><a href="/dnd/5e/srd/languages">Languages</a></li>
      <li><a href="/dnd/5e/srd/monsters">Monsters</a></li>
      <li><a href="/dnd/5e/srd/races">Races</a></li>
      <li><a href="/dnd/5e/srd/skills">Skills</a></li>
      <li><a href="/dnd/5e/srd/spells">Spells</a></li>
      <li><a href="/dnd/5e/srd/weapon-properties">Weapon Properties</a></li>
    </ul>

    <hr />

    <% const popularData = popularPages && Array.isArray(popularPages.sections) ? popularPages : { sections: [] }; %>
    <% const flattenedPopularLinks = []; %>
    <% const seenPopularHrefs = new Set(); %>
    <% (popularData.sections || []).forEach((section) => { %>
      <% (section.links || []).forEach((link) => { %>
        <% if (!link || !link.href || !link.name || seenPopularHrefs.has(link.href)) return; %>
        <% seenPopularHrefs.add(link.href); %>
        <% flattenedPopularLinks.push(link); %>
      <% }) %>
    <% }) %>
    <% flattenedPopularLinks.sort((a, b) => { %>
      <% const aClicks = typeof a.clicks === "number" ? a.clicks : -1; %>
      <% const bClicks = typeof b.clicks === "number" ? b.clicks : -1; %>
      <% if (bClicks !== aClicks) return bClicks - aClicks; %>
      <% const aImpressions = typeof a.impressions === "number" ? a.impressions : -1; %>
      <% const bImpressions = typeof b.impressions === "number" ? b.impressions : -1; %>
      <% return bImpressions - aImpressions; %>
    <% }); %>
    <% const topPopularLinks = flattenedPopularLinks.slice(0, 10); %>
    <h2>Popular Pages</h2>
    <p>Top 10 popular SRD pages.</p>

    <% if (topPopularLinks.length) { %>
      <div class="srd-see-also">
        <ul>
          <% topPopularLinks.forEach((link) => { %>
            <li><a href="<%= link.href %>"><%= link.name %></a></li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <p>No popular pages available yet.</p>
    <% } %>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
