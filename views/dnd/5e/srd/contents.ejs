  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E SRD Table of Contents",
      "description": "Complete table of contents for the D&D 5th Edition System Reference Document",
      "url": "https://farreachco.com/dnd/5e/srd/contents",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          }
        ]
      },
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition",
        "gamePlatform": "Tabletop"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://farreachco.com/dnd/5e/srd/contents?q={search_term_string}",
        "query-input": "required name=search_term_string",
        "description": "AI-powered D&D 5E rules search using Mistral AI"
      }
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
