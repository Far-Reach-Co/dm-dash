<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Races - SRD Index | Far Reach Co.</title>
  <meta name="description" content="Browse D&D 5E SRD races with standalone pages for racial traits, subraces, languages, and ability bonuses." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/races" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/races" />
  <meta property="og:title" content="D&D 5E Races - SRD Index" />
  <meta property="og:description" content="Standalone SRD pages for D&D 5E races and subraces." />
  <meta property="og:site_name" content="Far Reach Co." />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Races - SRD Index" />
  <meta name="twitter:description" content="Standalone SRD pages for D&D 5E races and subraces." />

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "D&D 5E Races",
      "description": "Index of D&D 5E SRD races with standalone race pages",
      "url": "https://farreachco.com/dnd/5e/srd/races"
    }
  </script>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E SRD Races',
      srdPageSummary: 'Browse the D&D 5E SRD races with traits, ability bonuses, and related subrace links.'
    }) %>
    <br />

    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Races</span>
    </div>
    <hr />

    <h2>Races</h2>
    <p>Each race now has a standalone URL for easier sharing and clearer indexing.</p>

    <ul class="srd-col-list-2">
      <% data.forEach((race) => { %>
      <li>
        <a href="/dnd/5e/srd/races/<%= race.index %>"><%= race.name %></a>
      </li>
      <% }) %>
    </ul>

    <div class="srd-see-also">
      <h3>Also See</h3>
      <ul>
        <li><a href="/dnd/5e/srd/classes">Classes</a></li>
        <li><a href="/dnd/5e/srd/backgrounds">Backgrounds</a></li>
        <li><a href="/dnd/5e/srd/spells/class/wizard">Wizard Spells</a></li>
      </ul>
    </div>

    <script>
      (function() {
        var hash = (window.location.hash || "").replace(/^#/, "");
        if (!hash) return;
        if (!/^[a-z0-9-]+$/.test(hash)) return;
        window.location.replace("/dnd/5e/srd/races/" + hash);
      })();
    </script>
  </div>
  <%- include('../../../partials/footer') %>
</body>

</html>
