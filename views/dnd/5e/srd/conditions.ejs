<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>D&D 5E Conditions Reference | Far Reach Co.</title>
    <meta name="description" content="Complete D&D 5E conditions reference including Blinded, Charmed, Deafened, Frightened, Grappled, Incapacitated, Invisible, Paralyzed, Petrified, Poisoned, Prone, Restrained, Stunned, and Unconscious with full descriptions and effects." />
    <meta name="keywords" content="D&D 5E conditions, status effects, blinded, charmed, frightened, paralyzed, stunned, unconscious, grappled, restrained, prone" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/conditions" />
    <meta property="og:title" content="D&D 5E Conditions Reference" />
    <meta property="og:description" content="Complete D&D 5E conditions reference with full descriptions and effects." />
    <meta property="og:site_name" content="Far Reach Co." />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Conditions Reference",
      "url": "https://farreachco.com/dnd/5e/srd/conditions",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://farreachco.com"},
          {"@type": "ListItem", "position": 2, "name": "D&D 5E SRD", "item": "https://farreachco.com/dnd/5e/srd/contents"},
          {"@type": "ListItem", "position": 3, "name": "Conditions", "item": "https://farreachco.com/dnd/5e/srd/conditions"}
        ]
      }
    }
    </script>
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/css/features/info.css" />
    <script src="/lib/MobileNavHandler.js" defer></script>
    <%- include('../../../partials/icons') %>
  </head>
  <%- include('../../../partials/google') %>
  <body>
    <%- include('../../../partials/nav') %>
    <div class="container-fluid p-3 info-container">
      <%- include('../../../partials/dnd/srdintro') %>
      <br />
      <div class="inline-div">
        <small>
          <a href="/dnd/5e/srd/contents">Contents</a> ->
          <div class="text-green">Conditions</div>
        </small>
      </div>
      <hr />
      <h2>Conditions</h2>
      <ul>
        <% data.forEach(function(condition){ %>
        <li>
          <a href="#<%= condition.index %>"><%= condition.name %></a>
        </li>
        <% }); %>
      </ul>
      <br />
      <% data.forEach(function(condition){ %>
      <div class="inline-div" id="<%= condition.index %>">
        <h3><%= condition.name %></h3>
      </div>
      <div class="indent">
        <% condition.desc.forEach((str, index) => { %>
        <p><%= str %></p>
        <% }) %>
        <br />
      </div>
      <br />
      <% }); %>
    </div>
    <%- include('../../../partials/footer') %>
  </body>
</html>
