<% if (typeof srdEdition !== 'undefined' && srdEdition === '2024') { %>
<%- include('partials/edition-page') %>
<% } else { %>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>D&D 5E Conditions List: Effects and Status Rules | Far Reach Co.</title>
  <meta name="description" content="Full D&D 5E conditions list covering Blinded, Charmed, Exhaustion, Grappled, Invisible, Paralyzed, Poisoned, Prone, Restrained, Stunned, Unconscious, and the rest, with each condition's effects and rules." />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/conditions" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/conditions" />
  <meta property="og:title" content="D&D 5E Conditions List: Effects and Status Rules" />
  <meta property="og:description" content="Full D&D 5E conditions list with the rules and effects for each status condition." />
  <meta property="og:site_name" content="Far Reach Co." />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="D&D 5E Conditions List: Effects and Status Rules" />
  <meta name="twitter:description" content="Full D&D 5E conditions list with the rules and effects for Blinded, Grappled, Paralyzed, Restrained, Stunned, and more." />
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "D&D 5E Conditions List: Effects and Status Rules",
      "url": "https://farreachco.com/dnd/5e/srd/conditions",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Conditions",
            "item": "https://farreachco.com/dnd/5e/srd/conditions"
          }
        ]
      }
    }
  </script>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: 'D&D 5E Conditions List',
      srdPageSummary: 'Use this D&D 5E conditions list to check what each condition does, how the main 5E status effects work, and how they change movement, attacks, and saving throws.'
    }) %>
    <br />
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <span class="current">Conditions</span>
    </div>
    <hr />
    <h2>Full List of D&D 5E Conditions</h2>
    <p>D&D 5e has <strong>14 conditions</strong> that alter a creature's capabilities during play: Blinded, Charmed, Deafened, Exhaustion, Frightened, Grappled, Incapacitated, Invisible, Paralyzed, Petrified, Poisoned, Prone, Restrained, Stunned, and Unconscious. Conditions are caused by spells, monster abilities, environmental hazards, and class features. A condition lasts until it is removed — either by the effect that imposed it ending, a saving throw, or a spell like <a href="/dnd/5e/srd/spells/lesser-restoration">Lesser Restoration</a>.</p>
    <p>Conditions are the main <strong>status effects</strong> in D&D 5e. When players ask what <strong>stunned</strong>, <strong>restrained</strong>, <strong>blinded</strong>, or other 5e status effects do, they are usually asking about these official conditions and their exact rules text.</p>
    <ul>
      <% data.forEach(function(condition){ %>
      <li>
        <a href="#<%= condition.index %>"><%= condition.name %></a>
      </li>
      <% }); %>
    </ul>
    <br />
    <% data.forEach(function(condition){ %>
    <div class="inline-div" id="<%= condition.index %>">
      <h3><%= condition.name %></h3>
      <div class="indent">
        <% condition.desc.forEach((str, index) => { %>
        <p><%= str %></p>
        <% }) %>
        <br />
        <br />
      </div>
    </div>
    <% }); %>

  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>

<% } %>
