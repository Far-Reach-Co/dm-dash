<% const classSummary = `${editionEntry.name} is a D&D 5e class with a d${editionEntry.hit_die} hit die and ${(editionEntry.saving_throws || []).map((score) => score.name).join(' and ')} saving throws.`; %>
<p><%= classSummary %></p>

<div class="quick-links" aria-label="<%= editionEntry.name %> page sections">
  <a href="#progression">Progression</a>
  <a href="#proficiencies">Proficiencies</a>
  <a href="#equipment">Equipment</a>
  <a href="#core-features">Core Features</a>
  <% if (editionClassSubclasses.length) { %><a href="#subclass-features">Subclass Features</a><% } %>
</div>

<% if (editionEntry.primary_ability?.desc) { %><div class="inline-div"><b>Primary Ability:</b> <span><%= editionEntry.primary_ability.desc %></span></div><% } %>
<div class="inline-div"><b>Hit Die:</b> <span>d<%= editionEntry.hit_die %></span></div>
<div class="inline-div"><b>Saving Throws:</b> <span><% for (const [index, score] of (editionEntry.saving_throws || []).entries()) { %><a href="/dnd/5e/srd/ability-scores?edition=2024#<%= score.index %>"><%= score.name %></a><%= index < editionEntry.saving_throws.length - 1 ? ', ' : '' %><% } %></span></div>
<% if (editionClassSpellCount) { %><div class="inline-div"><b>Class Spell List:</b> <a href="/dnd/5e/srd/spells/class/<%= editionEntry.index %>?edition=2024"><%= editionEntry.name %> Spells (<%= editionClassSpellCount %>)</a></div><% } %>
<div class="inline-div"><b>Related Pages:</b> <a href="/dnd/5e/srd/classes?edition=2024">Classes</a>, <a href="/dnd/5e/srd/features?edition=2024">Features</a>, <a href="/dnd/5e/srd/equipment?edition=2024">Equipment</a>, <a href="/dnd/5e/srd/skills?edition=2024">Skills</a>, <a href="/dnd/5e/srd/races?edition=2024">Species</a>, <a href="/dnd/5e/srd/backgrounds?edition=2024">Backgrounds</a></div>

<hr class="w-75" />
<% if (editionClassLevels.length) {
  const classColumns = [...new Set(editionClassLevels.flatMap((level) => Object.keys(level.class_specific || {})))];
  const spellColumns = [...new Set(editionClassLevels.flatMap((level) => Object.keys(level.spellcasting || {})))];
  const levelHeading = ['monk', 'paladin'].includes(editionEntry.index) ? 'Level' : `${editionEntry.name} Level`;
  const classHeadings = {
    rage_count: 'Rages', rage_damage_bonus: 'Rage Damage', weapon_mastery: 'Weapon Mastery',
    bardic_inspiration_die: 'Bardic Inspiration Die', channel_divinity_charges: 'Channel Divinity',
    wild_shape_uses: 'Wild Shape Uses', second_wind_uses: 'Second Wind Uses',
    martial_arts_die: 'Martial Arts', focus_points: 'Focus Points',
    unarmored_movement_bonus: 'Unarmored Movement', favored_enemies: 'Favored Enemies',
    sneak_attack: 'Sneak Attack', sorcery_points: 'Sorcery Points',
    eldritch_invocations: 'Invocations Known'
  };
  const spellHeading = (column) => {
    if (column === 'cantrips_known') return 'Cantrips Known';
    if (column === 'prepared_spells') return 'Spells Prepared';
    if (column === 'spells_known') return 'Spells Known';
    const slot = column.match(/^spell_slots_level_(\d+)$/);
    if (slot) return `${slot[1]}${{ 1: 'st', 2: 'nd', 3: 'rd' }[slot[1]] || 'th'}`;
    return editionLabel(column);
  };
%>
  <h2 id="progression">Progression Table</h2>
  <div class="srd-edition-table-scroll"><table>
    <thead><tr><th><%= levelHeading %></th><th>Proficiency Bonus</th><th>Features</th><% for (const column of classColumns) { %><th><%= classHeadings[column] || editionLabel(column) %></th><% } %><% for (const column of spellColumns) { %><th><%= spellHeading(column) %></th><% } %></tr></thead>
    <tbody><% for (const level of editionClassLevels) { %><tr>
      <td><%= level.level %></td><td>+<%= level.prof_bonus %></td>
      <td><% for (const [index, feature] of (level.features || []).entries()) { const href = editionReferenceHref(feature); %><% if (href) { %><a href="<%= href %>"><%= feature.name %></a><% } else { %><%= feature.name %><% } %><%= index < level.features.length - 1 ? ', ' : '' %><% } %></td>
      <% for (const column of classColumns) { const value = level.class_specific?.[column]; %><td><%= value === undefined || value === null ? '—' : value.dice_count && value.dice_value ? `${value.dice_count}d${value.dice_value}` : typeof value === 'object' ? '—' : value %></td><% } %>
      <% for (const column of spellColumns) { const value = level.spellcasting?.[column]; %><td><%= value === undefined || value === null || value === 0 ? '—' : value %></td><% } %>
    </tr><% } %></tbody>
  </table></div>
  <hr class="w-75" />
<% } %>

<h2 id="proficiencies">Starting Proficiencies</h2>
<ul><% for (const proficiency of (editionEntry.proficiencies || [])) { %><li><%= proficiency.name.replace(/^Skill:\s*/, '') %></li><% } %></ul>
<% if (editionEntry.proficiency_choices?.length) { %><h3>Proficiency Choices</h3><% for (const choice of editionEntry.proficiency_choices) { %><p><%= choice.desc %></p><% } %><% } %>

<hr class="w-75" />
<h2 id="equipment">Starting Equipment</h2>
<% if (editionEntry.starting_equipment?.length) { %><ul><% for (const item of editionEntry.starting_equipment) { %><li><%= item.equipment.name %><%= item.quantity > 1 ? ` (x${item.quantity})` : '' %></li><% } %></ul><% } %>
<% if (editionEntry.starting_equipment_options?.length) { %><ul><% for (const option of editionEntry.starting_equipment_options) { %><li><%= option.desc %></li><% } %></ul><% } %>

<hr class="w-75" />
<h2 id="core-features">Core Features</h2>
<% for (const feature of editionClassFeatures) { %>
  <div id="<%= feature.index %>">
    <h3>Level <%= feature.level?.name?.match(/\d+$/)?.[0] || '?' %> - <a href="/dnd/5e/srd/features/<%= feature.index %>?edition=2024"><%= feature.name %></a></h3>
    <%- include('edition-prose', { text: feature.description }) %>
  </div>
<% } %>

<% if (editionClassSubclasses.length) { %>
  <hr class="w-75" />
  <h2 id="subclass-features">Subclass Features</h2>
  <% for (const subclass of editionClassSubclasses) { %>
    <h3><%= subclass.name %></h3>
    <% if (subclass.description) { %><%- include('edition-prose', { text: subclass.description }) %><% } %>
    <% for (const feature of (subclass.features || [])) { %>
      <h4>Level <%= feature.level %> - <%= feature.name %></h4>
      <%- include('edition-prose', { text: feature.description }) %>
    <% } %>
  <% } %>
<% } %>
