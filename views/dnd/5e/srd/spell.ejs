<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <%
    // Helper for level display
    const levelDisplay = level => {
      if (level === 0) return 'Cantrip';
      const suffix = { 1: 'st', 2: 'nd', 3: 'rd' };
      return level + (suffix[level] || 'th') + '-level';
    };
    const levelDisplayShort = level => level === 0 ? 'Cantrip' : 'Level ' + level;
    const componentNames = { V: 'Verbal', S: 'Somatic', M: 'Material' };
    const classesStr = spell.classes.map(c => c.name).join(', ');
    const raceNames = (raceAccess && raceAccess.races) ? raceAccess.races : [];
    const subraceNames = (raceAccess && raceAccess.subraces) ? raceAccess.subraces : [];
    const baseDamageAtCharacterLevel = spell.damage?.damage_at_character_level
      ? Object.values(spell.damage.damage_at_character_level)[0]
      : '';
    const baseDamageAtSlotLevel = spell.damage?.damage_at_slot_level
      ? Object.values(spell.damage.damage_at_slot_level)[0]
      : '';
    const baseDamage = baseDamageAtCharacterLevel || baseDamageAtSlotLevel || '';
    const hasDamage = Boolean(spell.damage && spell.damage.damage_type && baseDamage);
    const spellTitle = hasDamage
      ? `${spell.name} 5e Spell: Damage, Range, and Rules`
      : `${spell.name} 5e Spell: Range, Duration, and Rules`;
    const spellSummary = `${spell.name} is a ${levelDisplay(spell.level)} ${spell.school.name} spell for ${classesStr}. Casting time: ${spell.casting_time}. Range: ${spell.range}. Duration: ${spell.duration}.${hasDamage ? ` It deals ${baseDamage} ${spell.damage.damage_type.name} damage at its base level.` : ''}`;

    // Build FAQ entries from spell data
    const faqs = [];
    if (spell.classes.length) {
      const subclassStr = spell.subclasses && spell.subclasses.length ? ` It is also available to these subclasses: ${spell.subclasses.map(s => s.name).join(', ')}.` : '';
      const raceStr = raceNames.length ? ` SRD races with trait-based access include ${raceNames.join(', ')}.` : '';
      const subraceStr = subraceNames.length ? ` SRD subraces with trait-based access include ${subraceNames.join(', ')}.` : '';
      faqs.push({
        q: `Who can cast ${spell.name} in D&D 5e?`,
        a: `${spell.name} is available to the following classes: ${classesStr}.${subclassStr}${raceStr}${subraceStr}`
      });
    }
    if (raceNames.length || subraceNames.length) {
      const raceParts = [];
      if (raceNames.length) raceParts.push(`races: ${raceNames.join(', ')}`);
      if (subraceNames.length) raceParts.push(`subraces: ${subraceNames.join(', ')}`);
      faqs.push({
        q: `Are there SRD races or subraces that can use ${spell.name} in D&D 5e?`,
        a: `Yes. Trait-based SRD access for ${spell.name} includes ${raceParts.join('; ')}.`
      });
    }
    faqs.push({
      q: `Is ${spell.name} a concentration spell in D&D 5e?`,
      a: spell.concentration
        ? `Yes, ${spell.name} requires concentration and lasts up to ${spell.duration}.`
        : `No, ${spell.name} does not require concentration. It lasts ${spell.duration}.`
    });
    faqs.push({
      q: `What level is ${spell.name} in D&D 5e?`,
      a: spell.level === 0
        ? `${spell.name} is a cantrip (0th-level) ${spell.school.name} spell.`
        : `${spell.name} is a ${levelDisplay(spell.level)} ${spell.school.name} spell.`
    });
    if (hasDamage) {
      const scalingParts = [];
      if (spell.damage.damage_at_character_level) {
        scalingParts.push('Its damage increases with character level.');
      }
      if (spell.damage.damage_at_slot_level) {
        scalingParts.push('Its damage increases when you cast it with a higher-level slot.');
      }
      faqs.push({
        q: `How much damage does ${spell.name} do in D&D 5e?`,
        a: `${spell.name} deals ${baseDamage} ${spell.damage.damage_type.name} damage at its base level in D&D 5th Edition.${scalingParts.length ? ` ${scalingParts.join(' ')}` : ''}`
      });
    }
    faqs.push({
      q: `What is the range and casting time of ${spell.name} in D&D 5e?`,
      a: `${spell.name} has a range of ${spell.range} and a casting time of ${spell.casting_time} in D&D 5th Edition.`
    });
    if (spell.ritual) {
      faqs.push({
        q: `Can ${spell.name} be cast as a ritual in D&D 5e?`,
        a: `Yes, ${spell.name} can be cast as a ritual. Ritual casting takes an extra 10 minutes but does not expend a spell slot.`
      });
    }

    // Build richer meta description
    const damageSnippet = hasDamage ? ` Damage: ${baseDamage} ${spell.damage.damage_type.name}.` : '';
    const spellMetaDesc = `${spell.name} in D&D 5e: ${levelDisplay(spell.level)} ${spell.school.name} spell for ${classesStr}.${damageSnippet} Casting time: ${spell.casting_time}. Range: ${spell.range}.${spell.concentration ? ' Concentration.' : ''}${spell.ritual ? ' Ritual.' : ''}`.substring(0, 160);
  %>

  <title><%= spellTitle %> | Far Reach Co.</title>
  <meta name="description" content="<%= spellMetaDesc %>" />
  <link rel="canonical" href="https://farreachco.com/dnd/5e/srd/spells/<%= spell.index %>" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content="https://farreachco.com/dnd/5e/srd/spells/<%= spell.index %>" />
  <meta property="og:title" content="<%= spellTitle %>" />
  <meta property="og:description" content="<%= spellMetaDesc %>" />
  <meta property="og:site_name" content="Far Reach Co." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= spellTitle %>" />
  <meta name="twitter:description" content="<%= spellMetaDesc %>" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "name": "<%= spellTitle %>",
      "headline": "<%= spell.name %>",
      "description": "<%= spellMetaDesc %>",
      "url": "https://farreachco.com/dnd/5e/srd/spells/<%= spell.index %>",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://farreachco.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "D&D 5E SRD",
            "item": "https://farreachco.com/dnd/5e/srd/contents"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Spells",
            "item": "https://farreachco.com/dnd/5e/srd/spells"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "name": "<%= spell.name %>",
            "item": "https://farreachco.com/dnd/5e/srd/spells/<%= spell.index %>"
          }
        ]
      },
      "about": {
        "@type": "Game",
        "name": "Dungeons & Dragons 5th Edition",
        "gamePlatform": "Tabletop"
      }
    }
  </script>

  <% if (faqs.length > 0) { %>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": <%- JSON.stringify(faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))) %>
    }
  </script>
  <% } %>

  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/info.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('../../../partials/icons') %>
</head>
<%- include('../../../partials/google') %>

<body>
  <%- include('../../../partials/nav') %>
  <div class="container-fluid p-3 info-container">
    <%- include('../../../partials/dnd/srdintro', {
      srdPageHeading: spellTitle,
      srdPageSummary: spellSummary
    }) %>
    <br />
    <!-- Breadcrumb -->
    <div class="breadcrumbs">
      <a href="/dnd/5e/srd/contents">Contents</a>
      <span class="separator">→</span>
      <a href="/dnd/5e/srd/spells">Spells</a>
      <span class="separator">→</span>
      <div class="text-green"><%= spell.name %></div>
    </div>
    <hr />

    <!-- Spell Header -->
    <h2><%= spell.name %></h2>
    <div class="inline-div">
      <i><a href="/dnd/5e/srd/spells/level/<%= spell.level %>"><%= levelDisplay(spell.level) %></a></i>
      <i><a href="/dnd/5e/srd/spells/school/<%= spell.school.index %>"><%= spell.school.name %></a></i>
      <% if (spell.ritual) { %><i class="text-green">(Ritual)</i><% } %>
    </div>

    <!-- Spell Stats -->
    <div class="spell-stat-block">
      <div class="spell-stat-field">
        <span class="spell-stat-label">Casting Time</span>
        <span class="spell-stat-value"><%= spell.casting_time %></span>
      </div>
      <div class="spell-stat-field">
        <span class="spell-stat-label">Range</span>
        <span class="spell-stat-value"><%= spell.range %></span>
      </div>
      <div class="spell-stat-field">
        <span class="spell-stat-label">Components</span>
        <span class="spell-stat-value">
          <%= spell.components.join(', ') %>
          <% if (spell.material) { %><i> (<%= spell.material %>)</i><% } %>
        </span>
      </div>
      <div class="spell-stat-field">
        <span class="spell-stat-label">Duration</span>
        <span class="spell-stat-value">
          <% if (spell.concentration) { %><span class="text-orange">Concentration, </span><% } %><%= spell.duration %>
        </span>
      </div>
    </div>

    <!-- Spell Description -->
    <div class="spell-description">
      <% spell.desc.forEach((paragraph, index) => { %>
      <% if (index > 0) { %>
      <p class="pindent"><%= paragraph %></p>
      <% } else { %>
      <p><%= paragraph %></p>
      <% } %>
      <% }) %>
    </div>

    <!-- Higher Level -->
    <% if (spell.higher_level && spell.higher_level.length) { %>
    <div class="higher-level">
      <b>At Higher Levels:</b>
      <% spell.higher_level.forEach(text => { %>
      <p><%= text %></p>
      <% }) %>
    </div>
    <% } %>

    <hr class="w-75" />

    <!-- Additional Details -->
    <div class="spell-details">
      <% if (spell.damage && spell.damage.damage_type) { %>
      <div class="inline-div">
        <b>Damage Type:</b>
        <a href="/dnd/5e/srd/damage-types/<%= spell.damage.damage_type.index %>"><%= spell.damage.damage_type.name %></a>
        <span>
          &ensp;&middot;&ensp;
          <a href="/dnd/5e/srd/spells/damage/<%= spell.damage.damage_type.index %>"><%= spell.damage.damage_type.name %> Damage Spells</a>
        </span>
      </div>
      <% } %>

      <% if (spell.damage && spell.damage.damage_at_slot_level) { %>
      <div class="inline-div">
        <b>Damage by Slot Level:</b>
      </div>
      <div class="indent">
        <ul>
          <% Object.entries(spell.damage.damage_at_slot_level).forEach(([level, dice]) => { %>
          <li>Level <%= level %>: <%= dice %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (spell.damage && spell.damage.damage_at_character_level) { %>
      <div class="inline-div">
        <b>Damage by Character Level:</b>
      </div>
      <div class="indent">
        <ul>
          <% Object.entries(spell.damage.damage_at_character_level).forEach(([level, dice]) => { %>
          <li>Level <%= level %>: <%= dice %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (spell.heal_at_slot_level) { %>
      <div class="inline-div">
        <b>Healing by Slot Level:</b>
      </div>
      <div class="indent">
        <ul>
          <% Object.entries(spell.heal_at_slot_level).forEach(([level, dice]) => { %>
          <li>Level <%= level %>: <%= dice %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (spell.dc) { %>
      <div class="inline-div">
        <b>Saving Throw:</b>
        <div><%= spell.dc.dc_type.name %></div>
        <% if (spell.dc.dc_success) { %>
        <i>(On success: <%= spell.dc.dc_success.toLowerCase().replace('_', ' ') %>)</i>
        <% } %>
      </div>
      <% } %>

      <% if (spell.area_of_effect) { %>
      <div class="inline-div">
        <b>Area of Effect:</b>
        <div><%= spell.area_of_effect.size %> ft. <%= spell.area_of_effect.type %></div>
      </div>
      <% } %>
    </div>

    <hr class="w-75" />

    <!-- Classes -->
    <div class="spell-classes">
      <b>Classes:</b>
      <div class="indent">
        <% spell.classes.forEach((cls, idx) => { %>
        <a href="/dnd/5e/srd/classes/<%= cls.index %>"><%= cls.name %></a><%= idx < spell.classes.length - 1 ? ', ' : '' %>
        <% }) %>
      </div>
    </div>

    <% if (spell.subclasses && spell.subclasses.length) { %>
    <div class="spell-subclasses">
      <b>Subclasses:</b>
      <div class="indent">
        <% spell.subclasses.forEach((sub, idx) => { %>
        <span><%= sub.name %></span><%= idx < spell.subclasses.length - 1 ? ', ' : '' %>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (raceNames.length || subraceNames.length) { %>
    <div class="spell-subclasses">
      <b>SRD Race Access:</b>
      <div class="indent">
        <% if (raceNames.length) { %>
          <span>Races: <%= raceNames.join(', ') %></span>
        <% } %>
        <% if (raceNames.length && subraceNames.length) { %><br /><% } %>
        <% if (subraceNames.length) { %>
          <span>Subraces: <%= subraceNames.join(', ') %></span>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (faqs.length > 0) { %>
    <hr class="w-75" />
    <section class="srd-faq">
      <p class="srd-faq-label">Frequently Asked Questions</p>
      <% faqs.forEach(faq => { %>
      <details>
        <summary><%= faq.q %></summary>
        <p><%= faq.a %></p>
      </details>
      <% }) %>
    </section>
    <% } %>

    <div class="srd-back-link">
      <a href="/dnd/5e/srd/spells">&larr; Back to Spell List</a>
    </div>
  </div>
  <%- include('../../../partials/dnd/srddisclosure') %>
  <%- include('../../../partials/footer') %>
</body>

</html>
