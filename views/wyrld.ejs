<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Wyrlds</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script type="module" src="/components/Calendar.js" defer></script>
  <script src="/components/modal.js" type="module"></script>
  <script src="/lib/newResourceModals.js" type="module"></script>
  <script type="module" src="/components/loadingWithMessage.js"></script>
  <script src="/lib/searchDashElements.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
  <script src="/lib/clipboard.js" type="module" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <% const formatDate = (value) => value ? new Date(value).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A"; %>
  <div class="mt-5 px-2 dashboard-shell">
    <aside class="dashboard-sidebar">
      <div class="dashboard-sidebar-card">
        <div class="dashboard-sidebar-title"><%= project.title %></div>
        <div class="dashboard-nav">
          <a class="dashboard-nav-link <%= section === 'overview' ? 'active' : '' %>" href="/wyrld?id=<%= project.id %>">Overview</a>
          <a class="dashboard-nav-link <%= section === 'tables' ? 'active' : '' %>" href="/wyrld/tables?id=<%= project.id %>">Tables</a>
          <a class="dashboard-nav-link <%= section === 'records' ? 'active' : '' %>" href="/wyrld/records?id=<%= project.id %>">Records</a>
          <a class="dashboard-nav-link <%= section === 'sheets' ? 'active' : '' %>" href="/wyrld/sheets?id=<%= project.id %>">Character Sheets</a>
          <a class="dashboard-nav-link <%= section === 'calendars' ? 'active' : '' %>" href="/wyrld/calendars?id=<%= project.id %>">Calendars</a>
          <a class="dashboard-nav-link <%= section === 'community' ? 'active' : '' %>" href="/wyrld/community?id=<%= project.id %>">Community</a>
          <a class="dashboard-nav-link <%= section === 'settings' ? 'active' : '' %>" href="/wyrld/settings?id=<%= project.id %>">Settings</a>
        </div>
      </div>
      <% if (projectAuth) { %>
      <div class="dashboard-sidebar-card dashboard-sidebar-card-spaced library-card">
        <div class="dashboard-sidebar-title">Image Library</div>
        <small>Browse, organize, and manage all your uploaded images in one place.</small>
        <a class="library-link" href="/library?wyrld=<%= project.id %>">
          <span class="library-link-text">Open Library</span>
          <span class="library-link-count"><%= imageCount %> images</span>
          <span class="library-link-arrow">&rarr;</span>
        </a>
      </div>
      <% } %>
    </aside>
    <main class="dashboard-main">
      <% if (section !== 'community') { %>
      <div
        class="p-3 wyrld-status mx-2 <%= project.is_pro && projectBannerSrc ? 'wyrld-status--with-banner' : '' %>"
      >
        <% if (project.is_pro && projectBannerSrc) { %>
        <img class="wyrld-status-banner-media" src="<%= projectBannerSrc %>" alt="" aria-hidden="true" />
        <div class="wyrld-status-banner-overlay" aria-hidden="true"></div>
        <% } %>
        <h1 class="wyrld-title"><%= project.title %></h1>
        <% if (projectAuth) { %>
        <div class="invite-section mt-3" id="invite-section">
          <% if (inviteLink) { %>
          <%- include('./partials/wyrld_invite_display', { inviteLink, inviteId }) %>
          <% } else { %>
          <%- include('./partials/wyrld_invite_button', { projectId: project.id }) %>
          <% } %>
        </div>
        <% } %>
      </div>
      <% } %>

      <% if (section === 'overview') { %>
      <div class="dashboard-highlights">
        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Tables</h2>
            <a href="/wyrld/tables?id=<%= project.id %>">View all</a>
          </div>
          <small>Shared tables for this wyrld.</small>
          <div class="dashboard-list">
            <% if (recentTables.length === 0) { %>
            <small>No tables yet...</small>
            <% } else { %>
            <% recentTables.forEach(function(table) { %>
            <div class="dash-detail-row" onclick="handleTableClick('<%= table.uuid %>', '<%= project.id %>')" title="Open table in new tab">
              <div class="dash-detail-title"><%= table.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Records</h2>
            <a href="/wyrld/records?id=<%= project.id %>">View all</a>
          </div>
          <small>Shared records and lore.</small>
          <div class="dashboard-list">
            <% if (recentRecords.length === 0) { %>
            <small>No records yet...</small>
            <% } else { %>
            <% recentRecords.forEach(function(record) { %>
            <div class="dash-detail-row" onclick="handleRecordClick('<%= record.id %>', '<%= project.id %>')" title="Open record in new tab">
              <div class="dash-detail-title"><%= record.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Character Sheets</h2>
            <a href="/wyrld/sheets?id=<%= project.id %>">View all</a>
          </div>
          <small>Characters linked to this wyrld.</small>
          <div class="dashboard-list">
            <% if (recentSheets.length === 0) { %>
            <small>No sheets yet...</small>
            <% } else { %>
            <% recentSheets.forEach(function(sheet) { %>
            <div class="dash-detail-row" onclick="handleSheetClick('<%= sheet.id %>', '<%= project.id %>')" title="Open character sheet in new tab">
              <div class="dash-detail-title"><%= sheet.name %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Calendars</h2>
            <a href="/wyrld/calendars?id=<%= project.id %>">View all</a>
          </div>
          <small>Custom timekeeping for your wyrld.</small>
          <div class="dashboard-list">
            <% if (recentCalendars.length === 0) { %>
            <small>No calendars yet...</small>
            <% } else { %>
            <% recentCalendars.forEach(function(calendar) { %>
            <div class="dash-detail-row" onclick="openCalendar('<%= calendar.id %>')" title="Open calendar">
              <div class="dash-detail-title"><%= calendar.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>
      </div>
      <% } %>

      <% if (section === 'tables') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Wyrld Tables</h2>
          <% if (projectAuth) { %>
          <a onclick="openNewWyrldTableModal('<%= project.id %>')" title="Create a new virtual table" style="cursor:pointer">+ New Wyrld Table</a>
          <% } %>
        </div>
        <small>These tables are shared by the members of the wyrld. Wyrld managers can upload images and manage the map layer.</small>
        <hr />
        <% if (tablesSorted.length === 0) { %>
        <small>No tables yet...</small>
        <% } else { %>
        <input id="search-table-elements-input" type="text" placeholder="Search Tables">
        <br>
        <div id="table-elements-list" class="dashboard-list">
          <% tablesSorted.forEach(function(table) { %>
          <div class="dash-detail-row" onclick="handleTableClick('<%= table.uuid %>', '<%= project.id %>')" title="Open table in new tab">
            <div class="dash-detail-title"><%= table.title %></div>
            <div class="dash-detail-meta"><%= table.mode === 'sandbox' ? 'Sandbox' : 'Standard' %> - <%= table.is_public ? 'Public' : 'Private' %> - <%= formatDate(table.date_created) %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'records') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Records</h2>
          <% if (projectAuth) { %>
          <a href="/newwyrldrecord?id=<%= project.id %>" title="Create a new wyrld record">+ New Wyrld Record</a>
          <% } %>
        </div>
        <small>Resource pages for lore, notes, monster stat blocks and other useful data.</small>
        <hr />
        <% if (recordsSorted.length === 0) { %>
        <small>No records yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% recordsSorted.forEach(function(record) { %>
          <div class="dash-detail-row" onclick="handleRecordClick('<%= record.id %>', '<%= project.id %>')" title="Open record in new tab">
            <div class="dash-detail-title"><%= record.title %></div>
            <div class="dash-detail-meta"><%= record.is_public ? 'Public' : 'Private' %> - <%= formatDate(record.created_at) %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'sheets') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Player Character Sheets</h2>
          <a onclick="openNewSheetModal('<%= project.id %>', '<%= encodeURIComponent(project.title) %>')" title="Create a new character sheet for this wyrld" style="cursor:pointer">+ New Character Sheet</a>
        </div>
        <small>We currently offer Dungeons and Dragons 5e sheets. Only the creator of the sheet and the wyrld managers are allowed to view these sheets.</small>
        <hr />
        <% if (sheetsSorted.length === 0) { %>
        <small>No sheets have been connected to this wyrld yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% sheetsSorted.forEach(function(sheet) { %>
          <div class="dash-detail-row" onclick="handleSheetClick('<%= sheet.id %>', '<%= project.id %>')" title="Open character sheet in new tab">
            <div class="dash-detail-title"><%= sheet.name %></div>
            <div class="dash-detail-meta"><%= sheet.class || 'Class TBD' %> - Level <%= sheet.level ?? 'N/A' %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'calendars') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Calendars</h2>
          <% if (projectAuth) { %>
          <a href="/newwyrldcalendar?id=<%= project.id %>" title="Create a new calendar">+ New Calendar</a>
          <% } %>
        </div>
        <small>Custom calendars allow for general time-keeping of the various cultures in the wyrld.</small>
        <hr />
        <% if (calendarsSorted.length === 0) { %>
        <small>No calendars yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% calendarsSorted.forEach(function(calendar) { %>
          <div class="dash-detail-row" onclick="openCalendar('<%= calendar.id %>')" title="Open calendar">
            <div class="dash-detail-title" id="calendar-title-<%= calendar.id %>"><%= calendar.title %></div>
            <div class="dash-detail-meta">Created <%= formatDate(calendar.created_at) %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'community') { %>
      <div class="community-forum">
        <section class="dashboard-card community-sidebar">
          <div class="dashboard-card-header">
            <h2>Community Discussion</h2>
            <a id="community-open-create-modal" title="Start a new discussion thread" style="cursor:pointer">+ New Thread</a>
          </div>
          <small>Browse current threads and open one to join the discussion.</small>
          <hr />
          <% if (!discussionThreads.length) { %>
            <small>No threads yet. Start the first discussion.</small>
          <% } else { %>
            <div class="dashboard-list community-thread-list">
              <% discussionThreads.forEach(function(thread) { %>
                <% const isSelectedThread = selectedDiscussionThread && Number(selectedDiscussionThread.id) === Number(thread.id); %>
                <div
                  class="dash-detail-row community-thread-row <%= isSelectedThread ? 'community-thread-row-selected' : '' %>"
                  onclick="openDiscussionThread('<%= thread.id %>')"
                  title="Open discussion thread"
                >
                  <div class="dash-detail-title community-thread-list-title">
                    <%= thread.is_pinned ? '[Pinned] ' : '' %><%= thread.title %>
                  </div>
                  <div class="dash-detail-meta community-thread-meta">
                    <span><%= thread.reply_count %> replies</span>
                    <% if (thread.is_locked) { %>
                      <span>&bull;</span>
                      <span>Locked</span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </section>

        <section class="dashboard-card community-main">
          <% if (!selectedDiscussionThread) { %>
            <h2>Thread</h2>
            <small>Select a thread from the left to view and reply.</small>
          <% } else { %>
            <div class="dashboard-card-header community-main-header">
              <h2 class="community-thread-title"><%= selectedDiscussionThread.title %></h2>
              <small class="community-thread-state"><%= selectedDiscussionThread.is_locked ? 'Locked' : 'Open' %></small>
            </div>
            <small class="community-thread-author-line">
              Started by <%= selectedDiscussionThread.creator_username %> on
              <%= formatDate(selectedDiscussionThread.created_at) %>
            </small>
            <div class="mt-2 community-thread-body"><%= selectedDiscussionThread.body %></div>

            <div class="settings-form-row mt-2 community-thread-actions">
              <% const canModerateThread = projectAuth; %>
              <% const canDeleteThread = canModerateThread || String(selectedDiscussionThread.creator_user_id) === String(auth); %>
              <% if (canModerateThread) { %>
                <button
                  class="modal-form-button"
                  type="button"
                  onclick="toggleDiscussionThreadLock('<%= selectedDiscussionThread.id %>')"
                >
                  <%= selectedDiscussionThread.is_locked ? 'Unlock Thread' : 'Lock Thread' %>
                </button>
              <% } %>
              <% if (canDeleteThread) { %>
                <button
                  class="btn-red"
                  type="button"
                  onclick="deleteDiscussionThread('<%= selectedDiscussionThread.id %>')"
                >
                  Delete Thread
                </button>
              <% } %>
            </div>

            <hr />
            <h3>Replies</h3>
            <% if (!selectedDiscussionPosts.length) { %>
              <small>No replies yet.</small>
            <% } else { %>
              <div class="dashboard-list community-post-list">
                <% selectedDiscussionPosts.forEach(function(post) { %>
                  <% const canDeletePost = projectAuth || String(post.user_id) === String(auth); %>
                  <div class="community-post-row">
                    <div class="community-post-header">
                      <div class="community-post-author"><%= post.username %></div>
                      <div class="dash-detail-meta community-post-header-actions">
                        <span><%= formatDate(post.created_at) %></span>
                        <% if (canDeletePost) { %>
                          <button
                            class="settings-remove-btn community-delete-reply-btn"
                            type="button"
                            title="Delete reply"
                            onclick="deleteDiscussionPost('<%= post.id %>')"
                          >&times;</button>
                        <% } %>
                      </div>
                    </div>
                    <div class="community-post-content"><%= post.content %></div>
                  </div>
                <% }); %>
              </div>
            <% } %>

            <% if (!selectedDiscussionThread.is_locked || projectAuth) { %>
              <hr />
              <div class="settings-form-row community-compose">
                <textarea
                  id="community-reply-content"
                  class="settings-input"
                  rows="4"
                  maxlength="4000"
                  placeholder="Write a reply..."
                ></textarea>
              </div>
              <div class="settings-form-row mt-2">
                <button
                  class="modal-form-button"
                  id="community-reply-submit"
                  data-thread-id="<%= selectedDiscussionThread.id %>"
                >
                  Post Reply
                </button>
                <small class="success-message" id="community-reply-msg"></small>
              </div>
            <% } else { %>
              <hr />
              <small>This thread is locked. Managers can unlock it to allow new replies.</small>
            <% } %>
          <% } %>
        </section>
      </div>

      <script>
        (function() {
          var projectId = '<%= project.id %>';
          var openCreateThreadModalButton = document.getElementById('community-open-create-modal');
          var replyButton = document.getElementById('community-reply-submit');
          var replyMessageElem = document.getElementById('community-reply-msg');

          function setCommunityMessage(elem, message, isError) {
            if (!elem) return;
            elem.textContent = message;
            elem.style.color = isError ? 'var(--red)' : 'var(--green)';
            if (message) {
              setTimeout(function() { elem.textContent = ''; }, 3000);
            }
          }

          async function submitDiscussionThread(title, body) {
            var res = await fetch('/api/add_project_discussion_thread/' + projectId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ title: title, body: body }),
            });
            var data = await res.json().catch(function() { return null; });
            if (!res.ok || (data && data.error)) {
              throw new Error((data && data.error && data.error.message) || 'Failed to create thread');
            }
            return data;
          }

          function openCreateThreadModal() {
            if (!window.modal) return;

            var container = document.createElement('div');
            container.className = 'modal-form';

            var heading = document.createElement('h2');
            heading.textContent = 'Create Discussion Thread';
            container.appendChild(heading);

            var titleInput = document.createElement('input');
            titleInput.type = 'text';
            titleInput.className = 'modal-form-input';
            titleInput.maxLength = 140;
            titleInput.placeholder = 'Thread title';
            titleInput.required = true;
            container.appendChild(titleInput);

            var bodyInput = document.createElement('textarea');
            bodyInput.className = 'modal-form-input';
            bodyInput.rows = 6;
            bodyInput.maxLength = 5000;
            bodyInput.placeholder = 'Start the discussion...';
            bodyInput.required = true;
            container.appendChild(bodyInput);

            var messageElem = document.createElement('small');
            messageElem.className = 'success-message';
            container.appendChild(messageElem);

            var submitButton = document.createElement('button');
            submitButton.type = 'button';
            submitButton.className = 'modal-form-button';
            submitButton.textContent = 'Post Thread';
            submitButton.addEventListener('click', async function() {
              var title = titleInput.value.trim();
              var body = bodyInput.value.trim();
              if (!title || !body) {
                setCommunityMessage(messageElem, 'Title and content are required', true);
                return;
              }

              submitButton.disabled = true;
              submitButton.textContent = 'Posting...';
              try {
                var data = await submitDiscussionThread(title, body);
                window.location.href = (data && data.redirect) || ('/wyrld/community?id=' + projectId);
              } catch (err) {
                setCommunityMessage(messageElem, (err && err.message) || 'Failed to create thread', true);
                submitButton.disabled = false;
                submitButton.textContent = 'Post Thread';
              }
            });
            container.appendChild(submitButton);

            window.modal.show(container);
            titleInput.focus();
          }

          if (openCreateThreadModalButton) {
            openCreateThreadModalButton.addEventListener('click', function() {
              openCreateThreadModal();
            });
          }

          if (replyButton) {
            replyButton.addEventListener('click', async function() {
              var threadId = replyButton.dataset.threadId;
              var replyInput = document.getElementById('community-reply-content');
              var content = replyInput ? replyInput.value.trim() : '';
              if (!threadId) return;

              try {
                var res = await fetch('/api/add_project_discussion_post/' + threadId, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ content: content }),
                });
                var data = await res.json().catch(function() { return null; });
                if (!res.ok || (data && data.error)) {
                  throw new Error((data && data.error && data.error.message) || 'Failed to post reply');
                }
                window.location.reload();
              } catch (err) {
                setCommunityMessage(replyMessageElem, (err && err.message) || 'Failed to post reply', true);
              }
            });
          }

          window.openDiscussionThread = function(threadId) {
            if (!threadId) return;
            window.location.href = '/wyrld/community?id=' + projectId + '&thread=' + threadId;
          };

          window.toggleDiscussionThreadLock = async function(threadId) {
            if (!threadId) return;
            try {
              var res = await fetch('/api/toggle_project_discussion_thread_lock/' + threadId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({}),
              });
              var data = await res.json().catch(function() { return null; });
              if (!res.ok || (data && data.error)) {
                throw new Error((data && data.error && data.error.message) || 'Failed to update thread');
              }
              window.location.reload();
            } catch (err) {
              window.alert((err && err.message) || 'Failed to update thread');
            }
          };

          window.deleteDiscussionThread = async function(threadId) {
            if (!threadId) return;
            if (!confirm('Delete this discussion thread and all replies?')) return;
            try {
              var res = await fetch('/api/remove_project_discussion_thread/' + threadId, {
                method: 'DELETE',
              });
              var data = await res.json().catch(function() { return null; });
              if (!res.ok || (data && data.error)) {
                throw new Error((data && data.error && data.error.message) || 'Failed to delete thread');
              }
              window.location.href = '/wyrld/community?id=' + projectId;
            } catch (err) {
              window.alert((err && err.message) || 'Failed to delete thread');
            }
          };

          window.deleteDiscussionPost = async function(postId) {
            if (!postId) return;
            if (!confirm('Delete this reply?')) return;
            try {
              var res = await fetch('/api/remove_project_discussion_post/' + postId, {
                method: 'DELETE',
              });
              var data = await res.json().catch(function() { return null; });
              if (!res.ok || (data && data.error)) {
                throw new Error((data && data.error && data.error.message) || 'Failed to delete reply');
              }
              window.location.reload();
            } catch (err) {
              window.alert((err && err.message) || 'Failed to delete reply');
            }
          };
        })();
      </script>
      <% } %>

      <% if (section === 'settings' && isOwner) { %>
      <div class="settings-grid">
        <section class="dashboard-card settings-card">
          <h2>Edit Title</h2>
          <small>Change the name of your wyrld.</small>
          <hr />
          <div class="settings-form-row">
            <input type="text" id="settings-title-input" class="settings-input" value="<%= project.title %>" placeholder="Wyrld Title" />
            <button class="modal-form-button" id="settings-title-save">Save</button>
          </div>
          <small class="success-message" id="settings-title-msg"></small>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Edit Description</h2>
          <small>Update the summary shown in public discovery.</small>
          <hr />
          <div class="settings-form-row">
            <textarea
              id="settings-description-input"
              class="settings-input"
              rows="4"
              maxlength="1200"
              placeholder="Write a short introduction for your wyrld..."
            ><%= project.description || '' %></textarea>
          </div>
          <div class="settings-form-row">
            <small id="settings-description-count"><%= (project.description || '').length %>/1200</small>
            <button class="modal-form-button" id="settings-description-save">Save</button>
          </div>
          <small class="success-message" id="settings-description-msg"></small>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Wyrld Banner</h2>
          <small>Feature your wyrld with a custom banner image at the top of this dashboard.</small>
          <small>Recommended: 1600x500 (wide landscape). The banner is responsively cropped, so keep key details near the center.</small>
          <hr />
          <% if (!project.is_pro) { %>
          <small>This feature is available on Pro Wyrlds.</small>
          <% } else { %>
          <div id="settings-banner-preview" class="settings-banner-preview">
            <% if (projectBannerSrc) { %>
            <img id="settings-banner-image" src="<%= projectBannerSrc %>" alt="<%= projectBannerName || project.title %> banner" />
            <% } else { %>
            <small id="settings-banner-empty">No banner selected.</small>
            <% } %>
          </div>
          <div class="settings-form-row settings-banner-actions">
            <input type="file" id="settings-banner-upload" class="file-input-hidden" accept="image/*" />
            <label for="settings-banner-upload" class="label-btn" title="Upload banner image">Choose Image</label>
            <button class="btn-red" id="settings-banner-clear" <%= projectBannerSrc ? '' : 'disabled' %>>Clear Banner</button>
          </div>
          <small class="success-message" id="settings-banner-msg"></small>
          <% } %>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Subscription</h2>
          <small>Current plan and data usage for this wyrld.</small>
          <hr />
          <% if (!project.is_pro) { %>
          <div class="wyrld-status-item">
            <h3>Status:</h3>
            <p>Free Tier</p>
          </div>
          <div class="wyrld-status-item">
            <h3>Data Used:</h3>
            <p><%= usedDataFormatted %> / 50MB</p>
          </div>
          <% } else { %>
          <div class="wyrld-status-item">
            <h3>Status:</h3>
            <p>Pro</p>
          </div>
          <div class="wyrld-status-item">
            <h3>Data Used:</h3>
            <p><%= usedDataFormatted %></p>
          </div>
          <% } %>
          <small class="d-block mt-2">-- Subscriptions under Construction --</small>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Manage Users</h2>
          <small>Give an invited user access to edit wyrld resources by making them a manager.</small>
          <hr />
          <div id="settings-users-list">
            <% if (settingsUsers.length === 0) { %>
            <small>No users have joined yet...</small>
            <% } else { %>
            <div class="settings-users-header">
              <small>Username</small>
              <small>Manager</small>
            </div>
            <% settingsUsers.forEach(function(user) { %>
            <div class="settings-user-row" id="settings-user-<%= user.project_user_id %>">
              <div class="settings-user-info">
                <span><%= user.username %></span>
                <button class="settings-remove-btn" data-id="<%= user.project_user_id %>" data-name="<%= user.username %>" title="Remove user">&times;</button>
              </div>
              <label class="settings-toggle">
                <input type="checkbox" data-id="<%= user.project_user_id %>" class="settings-editor-toggle" <%= user.is_editor ? 'checked' : '' %> />
                <span class="settings-toggle-slider"></span>
              </label>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Public Discovery</h2>
          <small>Control whether this wyrld appears in the public directory for logged-in users.</small>
          <small class="d-block mt-1">Use a featured record to introduce your wyrld and onboarding expectations.</small>
          <hr />
          <% if (!project.is_pro) { %>
            <small>Public Discovery is available on Pro Wyrlds.</small>
            <small class="d-block mt-1">Upgrade this wyrld to Pro to list it publicly and feature an onboarding record.</small>
            <small class="d-block mt-2"><a href="/public-wyrlds-admin-guide">Public Wyrlds Setup Guide</a></small>
          <% } else { %>
            <div class="settings-form-row">
              <div class="settings-toggle">
                <input
                  type="checkbox"
                  id="settings-public-listed"
                  <%= project.is_public_listed ? 'checked' : '' %>
                />
                <span class="settings-toggle-slider"></span>
              </div>
              <label class="settings-inline-label" for="settings-public-listed">List this wyrld publicly</label>
            </div>
            <div class="settings-form-row mt-2">
              <label class="settings-inline-label" for="settings-public-join-mode">Join Mode:</label>
              <select id="settings-public-join-mode" class="settings-input">
                <option value="invite_only" <%= project.public_join_mode === 'invite_only' ? 'selected' : '' %>>Invite Only</option>
                <option value="request" <%= project.public_join_mode === 'request' ? 'selected' : '' %>>Request to Join</option>
              </select>
            </div>
            <div class="settings-form-row mt-2">
              <label class="settings-inline-label" for="settings-public-capacity">Capacity:</label>
              <input
                id="settings-public-capacity"
                class="settings-input"
                type="number"
                min="1"
                placeholder="No limit"
                value="<%= project.public_join_capacity ? project.public_join_capacity : '' %>"
              />
              <small>Current members: <%= memberCount %></small>
            </div>
            <div class="settings-form-row mt-2">
              <label class="settings-inline-label" for="settings-featured-record-id">Featured Record:</label>
              <select id="settings-featured-record-id" class="settings-input">
                <option value="">None</option>
                <% recordsSorted.forEach(function(record) { %>
                  <option value="<%= record.id %>" <%= project.featured_record_id === record.id ? 'selected' : '' %>><%= record.title %><%= record.is_public ? '' : ' (private)' %></option>
                <% }); %>
              </select>
            </div>
            <small class="d-block mt-1">Only the selected featured record is exposed in public discovery.</small>
            <button class="modal-form-button mt-2" id="settings-public-save">Save Public Settings</button>
            <small class="success-message" id="settings-public-msg"></small>
            <small class="d-block mt-2"><a href="/wyrlds/public">Open Public Directory</a></small>
            <small class="d-block"><a href="/public-wyrlds-admin-guide">Public Wyrlds Setup Guide</a></small>
          <% } %>
        </section>

        <section class="dashboard-card settings-card">
          <h2>Join Requests</h2>
          <small>Review pending requests from users who want to join this wyrld.</small>
          <hr />
          <div id="settings-join-requests-list">
            <% if (!pendingJoinRequests.length) { %>
              <small>No pending join requests.</small>
            <% } else { %>
              <% pendingJoinRequests.forEach(function(joinRequest) { %>
                <div class="settings-user-row" id="join-request-<%= joinRequest.id %>">
                  <div class="settings-user-info" style="flex-direction: column; align-items: flex-start;">
                    <span><strong><%= joinRequest.requester_username %></strong></span>
                    <% if (joinRequest.message) { %>
                      <small><%= joinRequest.message %></small>
                    <% } else { %>
                      <small>No message provided.</small>
                    <% } %>
                  </div>
                  <div class="settings-form-row">
                    <button class="modal-form-button settings-join-approve" data-id="<%= joinRequest.id %>" type="button">Approve</button>
                    <button class="btn-red settings-join-reject" data-id="<%= joinRequest.id %>" type="button">Reject</button>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
          <small class="success-message" id="settings-join-msg"></small>
        </section>

        <section class="dashboard-card settings-card settings-danger-zone">
          <h2>Danger Zone</h2>
          <small>Permanently delete this wyrld and all associated data.</small>
          <hr />
          <button class="btn-red" id="settings-delete-wyrld">Delete Wyrld</button>
        </section>
      </div>

      <script>
        (function() {
          var projectId = '<%= project.id %>';
          var projectTitle = '<%= project.title.replace(/\x27/g, "\\x27") %>';
          var projectIsPro = <%= project.is_pro ? 'true' : 'false' %>;
          var defaultBannerAlt = '<%= (project.title + " banner").replace(/\x27/g, "\\x27") %>';

          function setSettingsMessage(elemId, message, isError) {
            var msg = document.getElementById(elemId);
            if (!msg) return;
            msg.textContent = message;
            msg.style.color = isError ? 'var(--red)' : 'var(--green)';
            if (message) {
              setTimeout(function() {
                msg.textContent = '';
              }, 3000);
            }
          }

          function showProjectProWarning() {
            if (typeof renderTierLimitWarning === 'function') {
              renderTierLimitWarning('This Wyrld has reached the limit for this feature. Please subscribe to our "Pro Wyrld" package to increase the limit.');
            } else {
              window.alert('This Wyrld feature requires Pro.');
            }
          }

          function renderBannerPreview(src, altText) {
            var preview = document.getElementById('settings-banner-preview');
            if (!preview) return;
            preview.textContent = '';
            if (src) {
              var img = document.createElement('img');
              img.id = 'settings-banner-image';
              img.src = src;
              img.alt = altText || defaultBannerAlt;
              preview.appendChild(img);
            } else {
              var empty = document.createElement('small');
              empty.id = 'settings-banner-empty';
              empty.textContent = 'No banner selected.';
              preview.appendChild(empty);
            }
            var clearButton = document.getElementById('settings-banner-clear');
            if (clearButton) clearButton.disabled = !src;
          }

          async function setProjectBanner(imageId) {
            var res = await fetch('/api/edit_project_banner_image/' + projectId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ image_id: imageId })
            });
            var data = await res.json().catch(function() { return null; });
            if (res.status === 402 && data && data.error && data.error.message === 'PROJECT_IS_NOT_PRO') {
              showProjectProWarning();
              return null;
            }
            if (!res.ok || (data && data.error)) {
              throw new Error((data && data.error && data.error.message) || 'Failed to save banner image');
            }
            return data;
          }

          // Edit Title
          document.getElementById('settings-title-save').addEventListener('click', async function() {
            var title = document.getElementById('settings-title-input').value.trim();
            if (!title) return;
            var res = await fetch('/api/edit_project_title/' + projectId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ title: title })
            });
            if (res.ok) {
              setSettingsMessage('settings-title-msg', 'Saved', false);
            } else {
              setSettingsMessage('settings-title-msg', 'Error saving title', true);
            }
          });

          var settingsDescriptionInput = document.getElementById('settings-description-input');
          var settingsDescriptionCount = document.getElementById('settings-description-count');
          if (settingsDescriptionInput && settingsDescriptionCount) {
            settingsDescriptionInput.addEventListener('input', function() {
              settingsDescriptionCount.textContent = settingsDescriptionInput.value.length + '/1200';
            });
          }

          document.getElementById('settings-description-save').addEventListener('click', async function() {
            var description = document.getElementById('settings-description-input').value.trim();
            var res = await fetch('/api/edit_project_description/' + projectId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ description: description })
            });
            if (res.ok) {
              setSettingsMessage('settings-description-msg', 'Saved', false);
            } else {
              var data = await res.json().catch(function() { return null; });
              setSettingsMessage(
                'settings-description-msg',
                (data && data.error && data.error.message) || 'Error saving description',
                true
              );
            }
          });

          if (projectIsPro) {
            var bannerUploadInput = document.getElementById('settings-banner-upload');
            var bannerClearButton = document.getElementById('settings-banner-clear');

            if (bannerUploadInput) {
              bannerUploadInput.addEventListener('change', async function(event) {
                var file = event.target.files && event.target.files[0];
                if (!file) return;
                bannerUploadInput.disabled = true;
                if (bannerClearButton) bannerClearButton.disabled = true;
                setSettingsMessage('settings-banner-msg', 'Uploading banner...', false);

                try {
                  var formData = new FormData();
                  formData.append('file', file);
                  formData.append('bucket_name', 'wyrld');
                  formData.append('folder_name', 'images');
                  formData.append('project_id', projectId);

                  var uploadRes = await fetch('/api/new_image_for_project', {
                    method: 'POST',
                    body: formData
                  });
                  var uploadData = await uploadRes.json().catch(function() { return null; });

                  if (uploadRes.status === 402 && uploadData && uploadData.error && uploadData.error.message === 'PROJECT_IS_NOT_PRO') {
                    showProjectProWarning();
                    setSettingsMessage('settings-banner-msg', '', false);
                    return;
                  }
                  if (!uploadRes.ok || !uploadData || uploadData.error) {
                    throw new Error((uploadData && uploadData.error && uploadData.error.message) || 'Banner upload failed');
                  }

                  var linkRes = await fetch('/api/add_table_image_by_project', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      project_id: projectId,
                      image_id: uploadData.id,
                      folder_id: null
                    })
                  });
                  var linkData = await linkRes.json().catch(function() { return null; });
                  if (!linkRes.ok || (linkData && linkData.error)) {
                    throw new Error((linkData && linkData.error && linkData.error.message) || 'Failed to link uploaded image to this wyrld');
                  }

                  var bannerData = await setProjectBanner(uploadData.id);
                  if (!bannerData) return;
                  renderBannerPreview(bannerData.src || uploadData.src || null, bannerData.original_name || uploadData.original_name || defaultBannerAlt);
                  setSettingsMessage('settings-banner-msg', 'Banner updated', false);
                } catch (err) {
                  console.log(err);
                  setSettingsMessage('settings-banner-msg', 'Error updating banner', true);
                } finally {
                  bannerUploadInput.disabled = false;
                  bannerUploadInput.value = '';
                  if (bannerClearButton && document.getElementById('settings-banner-image')) {
                    bannerClearButton.disabled = false;
                  }
                }
              });
            }

            if (bannerClearButton) {
              bannerClearButton.addEventListener('click', async function() {
                if (bannerClearButton.disabled) return;
                try {
                  bannerClearButton.disabled = true;
                  var bannerData = await setProjectBanner(null);
                  if (!bannerData) return;
                  renderBannerPreview(null, null);
                  setSettingsMessage('settings-banner-msg', 'Banner removed', false);
                } catch (err) {
                  console.log(err);
                  setSettingsMessage('settings-banner-msg', 'Error clearing banner', true);
                  bannerClearButton.disabled = false;
                }
              });
            }
          }

          var savePublicSettingsBtn = document.getElementById('settings-public-save');
          if (savePublicSettingsBtn) {
            savePublicSettingsBtn.addEventListener('click', async function() {
              var isPublicListed = document.getElementById('settings-public-listed').checked;
              var joinMode = document.getElementById('settings-public-join-mode').value;
              var capacityInput = document.getElementById('settings-public-capacity').value.trim();
              var featuredRecordIdValue = document.getElementById('settings-featured-record-id').value;
              var payload = {
                is_public_listed: isPublicListed,
                public_join_mode: joinMode,
                public_join_capacity: capacityInput ? Number(capacityInput) : null,
                featured_record_id: featuredRecordIdValue ? Number(featuredRecordIdValue) : null,
              };

              try {
                var res = await fetch('/api/edit_project_public_settings/' + projectId, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(payload),
                });
                var data = await res.json().catch(function() { return null; });
                if (res.status === 402 && data && data.error && data.error.message === 'PROJECT_IS_NOT_PRO') {
                  showProjectProWarning();
                  return;
                }
                if (!res.ok || (data && data.error)) {
                  throw new Error((data && data.error && data.error.message) || 'Failed to save public settings');
                }
                setSettingsMessage('settings-public-msg', 'Saved', false);
              } catch (err) {
                console.log(err);
                setSettingsMessage('settings-public-msg', (err && err.message) || 'Error saving public settings', true);
              }
            });
          }

          async function respondJoinRequest(requestId, action) {
            var res = await fetch('/api/respond_project_join_request/' + requestId, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: action }),
            });
            var data = await res.json().catch(function() { return null; });
            if (!res.ok || (data && data.error)) {
              throw new Error((data && data.error && data.error.message) || 'Failed to update join request');
            }
            return data;
          }

          function removeJoinRequestRow(requestId) {
            var row = document.getElementById('join-request-' + requestId);
            if (row) row.remove();
            var remaining = document.querySelectorAll('[id^="join-request-"]');
            if (!remaining.length) {
              var list = document.getElementById('settings-join-requests-list');
              if (list) list.innerHTML = '<small>No pending join requests.</small>';
            }
          }

          document.querySelectorAll('.settings-join-approve').forEach(function(btn) {
            btn.addEventListener('click', async function() {
              var id = btn.dataset.id;
              try {
                await respondJoinRequest(id, 'approve');
                removeJoinRequestRow(id);
                setSettingsMessage('settings-join-msg', 'Request approved', false);
              } catch (err) {
                console.log(err);
                setSettingsMessage('settings-join-msg', (err && err.message) || 'Failed to approve request', true);
              }
            });
          });

          document.querySelectorAll('.settings-join-reject').forEach(function(btn) {
            btn.addEventListener('click', async function() {
              var id = btn.dataset.id;
              try {
                await respondJoinRequest(id, 'reject');
                removeJoinRequestRow(id);
                setSettingsMessage('settings-join-msg', 'Request rejected', false);
              } catch (err) {
                console.log(err);
                setSettingsMessage('settings-join-msg', (err && err.message) || 'Failed to reject request', true);
              }
            });
          });

          // Manage Users — toggle editor
          document.querySelectorAll('.settings-editor-toggle').forEach(function(cb) {
            cb.addEventListener('change', async function() {
              var id = cb.dataset.id;
              await fetch('/api/edit_project_user_is_editor/' + id, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_editor: cb.checked })
              });
            });
          });

          // Manage Users — remove
          document.querySelectorAll('.settings-remove-btn').forEach(function(btn) {
            btn.addEventListener('click', async function() {
              var id = btn.dataset.id;
              var name = btn.dataset.name;
              if (!confirm('Are you sure you want to remove ' + name + '?')) return;
              var res = await fetch('/api/remove_project_user/' + id, {
                method: 'DELETE'
              });
              if (res.ok) {
                var row = document.getElementById('settings-user-' + id);
                if (row) row.remove();
                var remaining = document.querySelectorAll('.settings-user-row');
                if (remaining.length === 0) {
                  var list = document.getElementById('settings-users-list');
                  list.textContent = '';
                  var empty = document.createElement('small');
                  empty.textContent = 'No users have joined yet...';
                  list.appendChild(empty);
                }
              }
            });
          });

          // Delete Wyrld
          document.getElementById('settings-delete-wyrld').addEventListener('click', async function() {
            if (!confirm('Are you sure you want to delete ' + projectTitle + '? This cannot be undone.')) return;
            var res = await fetch('/api/remove_project/' + projectId, {
              method: 'DELETE'
            });
            if (res.ok) {
              var data = await res.json();
              window.location.href = data.redirect || '/dash';
            }
          });
        })();
      </script>
      <% } %>

      <% if (section === 'settings' && !isOwner) { %>
      <div class="settings-grid">
        <section class="dashboard-card settings-card">
          <h2>Member Settings</h2>
          <small>Manage your membership in this wyrld.</small>
          <hr />
          <div class="wyrld-status-item">
            <h3>Your Role:</h3>
            <p><%= projectAuth ? 'Manager' : 'Member' %></p>
          </div>
          <div class="wyrld-status-item">
            <h3>Join Mode:</h3>
            <p><%= project.public_join_mode === 'request' ? 'Request to Join' : 'Invite Only' %></p>
          </div>
        </section>

        <section class="dashboard-card settings-card settings-danger-zone">
          <h2>Leave Wyrld</h2>
          <small>Leave this wyrld and remove your member access.</small>
          <hr />
          <button class="btn-red" id="settings-leave-wyrld">Leave Wyrld</button>
          <small class="success-message" id="settings-leave-msg"></small>
        </section>
      </div>

      <script>
        (function() {
          var projectId = '<%= project.id %>';
          var projectTitle = '<%= project.title.replace(/\x27/g, "\\x27") %>';
          var leaveBtn = document.getElementById('settings-leave-wyrld');
          var leaveMsg = document.getElementById('settings-leave-msg');

          function setLeaveMessage(message, isError) {
            if (!leaveMsg) return;
            leaveMsg.textContent = message;
            leaveMsg.style.color = isError ? 'var(--red)' : 'var(--green)';
          }

          if (leaveBtn) {
            leaveBtn.addEventListener('click', async function() {
              if (!confirm('Leave ' + projectTitle + '? You will lose access to this wyrld.')) return;
              leaveBtn.disabled = true;
              setLeaveMessage('Leaving wyrld...', false);
              try {
                var res = await fetch('/api/leave_project/' + projectId, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({}),
                });
                var data = await res.json().catch(function() { return null; });
                if (!res.ok || (data && data.error)) {
                  throw new Error((data && data.error && data.error.message) || 'Failed to leave wyrld');
                }
                window.location.href = (data && data.redirect) || '/dash/wyrlds';
              } catch (err) {
                setLeaveMessage((err && err.message) || 'Failed to leave wyrld', true);
                leaveBtn.disabled = false;
              }
            });
          }
        })();
      </script>
      <% } %>
    </main>
  </div>
</body>
<script>
  function handleSheetClick(id, projectID) {
    window.open(`/5eplayer?id=${id}&project=${projectID}`, "_blank").focus();
  }

  function handleTableClick(uuid, projectID) {
    window.open(`/vtt?uuid=${uuid}&project=${projectID}`, "_blank").focus();
  }

  function handleRecordClick(id, projectID) {
    window.open(`/record?id=${id}&project_id=${projectID}`, "_blank").focus();
  }

  const projectAuth = <%= projectAuth %>;

  async function openCalendar(id) {
    modal.show(renderLoadingWithMessage(""));
    const res = await fetch(`/api/get_calendar/${id}`)
    if (res.status === 200) {
      const calendar = await res.json();
      if (calendar) {
        const elem = document.createElement("div");
        elem.className = "p-3 calendar";

        new Calendar({
          domComponent: elem,
          projectAuth,
          id: calendar.id,
          projectId: calendar.project_id,
          year: calendar.year,
          currentMonthId: calendar.current_month_id,
          currentDay: calendar.current_day,
          title: calendar.title,
          months: calendar.months,
          daysOfTheWeek: calendar.days_of_the_week
        })
        // show in modal
        modal.show(elem)
      }
    } else modal.hide()
  }
</script>

</html>
