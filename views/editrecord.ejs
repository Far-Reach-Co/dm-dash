<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Edit <%= record.title %></title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/record.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container page-form p-3">

    <h1 class="record-form-title">Edit <%= record.title %></h1>
    <span class="record-badge record-form-subtitle">Record</span>

    <fieldset>
      <div class="input-container">
        <label for="title">Title</label>
        <input id="title" name="title" placeholder="Record Title" value="<%= record.title %>" />
      </div>

      <div class="input-container">
        <label for="description">Description</label>
        <textarea class="w-100" id="description" name="description" required><%= record.description %></textarea>
      </div>

      <% if (imageUrls && Object.keys(imageUrls).length) { %>
      <div class="form-section">
        <small><b class="text-orange">Attached Images</b></small>
        <div class="record-edit-images" id="images-list">
          <% Object.entries(imageUrls).forEach(([key, value]) => { %>
          <div class="record-image-item">
            <img id="img-<%= key %>" src="<%= value %>" alt="">
            <span class="record-remove-btn" title="Remove image" data-remove-image="<%= key %>">✕</span>
          </div>
          <% }) %>
        </div>
      </div>
      <% } else { %>
      <div id="images-list"></div>
      <% } %>

      <div class="form-section">
        <small><b class="text-orange">Upload Images</b></small>
        <small class="hint">*These will also be available for use on your tables</small>
        <input id="image" name="image" class="file-input-hidden" type="file" accept="image/*" multiple>
        <label for="image" class="label-btn mt-2" title="Upload Image">Choose Images</label>
        <div class="d-flex flex-column mt-1" id="files-list"></div>
      </div>

      <div class="form-section">
        <div class="d-flex align-items-center gap-2">
          <input id="is_public" type="checkbox" name="is_public" <%= record.is_public ? 'checked' : '' %> />
          <div>
            <small><b class="text-orange">Make Public</b></small>
            <small class="hint">*Allow this page to be viewed by others.</small>
          </div>
        </div>
      </div>

      <button id="save">Save</button>
      <hr style="margin: var(--space-xl) 0; border: none; height: 1px; background: linear-gradient(90deg, transparent, var(--blue), transparent);" />
      <button id="delete-record-btn" type="button" class="btn-red">
        Delete Record
      </button>
    </fieldset>

  </div>
</body>

<script type="module">
  import toast from "/components/Toast.js";
  import {
    apiDelete,
    apiPost,
  } from "/lib/apiUtils.js";
  import { handleApiFailure } from "/lib/apiUiFeedback.js";
  import createElement from "/components/createElement.js";
  import {
    uploadUserImage,
    uploadProjectImage
  } from "/lib/imageUtils.js";

  const searchParams = new URLSearchParams(window.location.search);
  const recordId = searchParams.get("id");
  const projectId = searchParams.get("project_id");

  function throwHandled(result, fallbackMessage) {
    const handled = handleApiFailure(result, {
      fallbackMessage,
      includeResultMessage: true,
    });
    const err = new Error(result?.error || fallbackMessage);
    err.handled = handled;
    throw err;
  }

  // image event listener
  document.getElementById("image").addEventListener("change", async (e) => {
    if (e.target.files.length) {
      const filesListElem = document.getElementById("files-list");
      const fileNameElemList = [];
      for (const file of e.target.files) {
        const fileNameElem = createElement("small", {}, `- ${file.name}`);
        fileNameElemList.push(fileNameElem)
      }
      filesListElem.append(...fileNameElemList)
    }
  })

  document.getElementById("save").addEventListener("click", async (e) => {
    e.preventDefault();

    // loading state
    e.target.disabled = true;
    document.body.style.cursor = "wait";

    const titleInput = document.getElementById("title");
    const descInput = document.getElementById("description");
    const checkbox = document.getElementById("is_public");

    const data = {
      title: titleInput.value.trim(),
      description: descInput.value.trim(),
      is_public: checkbox.checked
    }

    try {
      const res = await apiPost(`/api/edit_record/${recordId}`, data);
      if (!res.ok) {
        throwHandled(res, "Failed to save record");
      }


      const imagesInput = document.getElementById("image");
      if (imagesInput.files.length) {
        if (imagesInput.files.length > 1) {
          // multiple
          await Promise.all(
            Array.from(imagesInput.files).map(async (file) => {
              const newImage = await uploadImage(file);
              if (!newImage) return;

              // create new record image
              const recordImageResult = await apiPost(`/api/add_record_image`, {
                record_id: recordId,
                image_id: newImage.id
              });
              if (!recordImageResult.ok) {
                throwHandled(recordImageResult, "Failed to attach image");
              }
            })
          );
        } else {
          const newImage = await uploadImage(imagesInput.files[0]);
          if (!newImage) {
            throw new Error("Failed to upload image");
          }
          // create new record image
          const recordImageResult = await apiPost(`/api/add_record_image`, {
            record_id: recordId,
            image_id: newImage.id
          });
          if (!recordImageResult.ok) {
            throwHandled(recordImageResult, "Failed to attach image");
          }
        }
      }

      toast.show("Saved");
      e.target.disabled = false;
      document.body.style.cursor = "default";
      if (projectId) {
        window.location.href = `/record?id=${recordId}&project_id=${projectId}`;
      } else {
        window.location.href = `/record?id=${recordId}`;
      }
    } catch (error) {
      console.log(error);
      if (!error?.handled) {
        window.customAlertError(error && error.message ? error.message : String(error));
      }
      e.target.disabled = false;
      document.body.style.cursor = "default";
    }
  })

  document.getElementById("delete-record-btn").addEventListener("click", async (e) => {
    e.preventDefault();
    const titleInput = document.getElementById("title");
    const recordTitle = (titleInput?.value || "<%= record.title %>").trim() || "<%= record.title %>";
    const confirmed = await window.customConfirm(
      `Are you sure you want to delete ${recordTitle}?`,
      { confirmText: "Delete", danger: true }
    );
    if (!confirmed) return;

    e.target.disabled = true;
    try {
      const res = await fetch(`/api/remove_record/${recordId}`, { method: "DELETE" });
      if (!res.ok) {
        throw new Error("Failed to delete record");
      }
      window.location.href = "/dash";
    } catch (error) {
      console.log(error);
      window.customAlertError(error && error.message ? error.message : "Failed to delete record");
      e.target.disabled = false;
    }
  });

  async function uploadImage(file) {
    // if its for a wyrld or public
    if (projectId) {
      const newImage = await uploadProjectImage(file, projectId, false);
      if (newImage) {
        // create new table image
        const tableImageResult = await apiPost(`/api/add_table_image_by_project`, {
          project_id: projectId,
          image_id: newImage.id,
          folder_id: null
        });
        if (!tableImageResult.ok) {
          handleApiFailure(tableImageResult, {
            fallbackMessage: "Failed to attach uploaded image to library",
            includeResultMessage: true,
          });
          return null;
        }
        return newImage;
      }
    } else {
      const newImage = await uploadUserImage(file, false);
      if (newImage) {
        // create new table image
        const tableImageResult = await apiPost(`/api/add_table_image_by_user`, {
          image_id: newImage.id,
          folder_id: null
        });
        if (!tableImageResult.ok) {
          handleApiFailure(tableImageResult, {
            fallbackMessage: "Failed to attach uploaded image to library",
            includeResultMessage: true,
          });
          return null;
        }
        return newImage;
      }
    }
    return null;
  }

  // remove image handlers
  document.querySelectorAll("[data-remove-image]").forEach(elem => {
    elem.addEventListener("click", async e => {
      e.preventDefault();
      const imageId = e.currentTarget.dataset.removeImage;
      console.log("Remove image:", imageId);
      const result = await apiDelete(`/api/remove_record_image_by_image/${imageId}`);
      if (!result.ok) {
        handleApiFailure(result, {
          fallbackMessage: "Failed to remove image from record",
          includeResultMessage: true,
        });
        return;
      }
      e.currentTarget.parentElement.remove();
    });
  });
</script>

</html>
