<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Edit <%= record.title %></title>
  <link rel="stylesheet" href="/style.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container p-3">
    <div>
      <h1>Edit <%= record.title %></h1>
      <small>- Record</small>
    </div>
    <br />
    <div class="input-container">
      <label for="title">Title</label>
      <input id="title" name="title" placeholder="Record Title" value="<%= record.title %>" />
    </div>
    <br />
    <div class="input-container w-100">
      <label for="description">Description</label>
      <textarea class="w-100" id="description" name="description" required><%= record.description %></textarea>
    </div>
    <div id="images-list">
      <% if (imageUrls && Object.keys(imageUrls).length) { %>
      <% Object.entries(imageUrls).forEach(([key, value]) => { %>
      <div class="d-flex align-items-baseline">
        <img class="my-2" style="max-width: 90%;" id="img-<%= key %>" src="<%= value %>">
        <div style="color: var(--red1); margin-left: var(--main-distance); cursor: pointer; font-size: 20px" title="Remove image" data-remove-image="<%= key %>">ⓧ</div>
      </div>
      <% }) %>
      <% } %>
    </div>
    <br />
    <div class=" w-25">
      <small><b style="color: var(--orange2);">Upload Images</b></small>
      <br />
      <small class="hint">*These will also be available for use on your tables</small>
      <br />
      <input id="image" name="image" type="file" accept="image/*" style="display: none" multiple>
      <label for="image" class="label-btn" title="Upload Image">Choose Images</label>
      <div class="d-flex flex-column" id="files-list"></div>
    </div>
    <br />
    <div class="w-25">
      <small><b style="color: var(--orange2)">Make Public</b></small>
      <br />
      <small class="hint">*Allow this page to viewed by others.</small>
      <input type="checkbox" id="is_public" name="is_public" <%= record.is_public ? 'checked' : '' %> />
    </div>
    <br />
    <br />
    <button id="save">Save</button>
    <hr>
    <button class="btn-red" hx-delete="/api/remove_record/<%= record.id %>" hx-swap="none" hx-confirm="Are you sure you want to delete <%= record.title %>?">
      Delete Record
    </button>
    <!-- Toast -->
    <div id="toast-custom"></div>
    <!-- The Modal -->
    <div id="modal-custom" class="modal-custom">
      <!-- Modal content -->
      <div class="modal-custom-container">
        <div id="close-custom-modal" class="close-custom-modal">&times;</div>
        <div id="modal-custom-content" class="modal-custom-content"></div>
      </div>
    </div>
  </div>
</body>

<script type="module">
  import toast from "/components/Toast.js";
  import {
    postThing,
    deleteThing,
  } from "/lib/apiUtils.js";
  import createElement from "/components/createElement.js";
  import {
    uploadUserImage,
    uploadProjectImage
  } from "/lib/imageUtils.js";

  const searchParams = new URLSearchParams(window.location.search);
  const recordId = searchParams.get("id");
  const projectId = searchParams.get("project_id");

  // image event listener
  document.getElementById("image").addEventListener("change", async (e) => {
    if (e.target.files.length) {
      const filesListElem = document.getElementById("files-list");
      const fileNameElemList = [];
      for (const file of e.target.files) {
        const fileNameElem = createElement("small", {}, `- ${file.name}`);
        fileNameElemList.push(fileNameElem)
      }
      filesListElem.append(...fileNameElemList)
    }
  })

  document.getElementById("save").addEventListener("click", async (e) => {
    e.preventDefault();

    // loading state
    e.target.disabled = true;
    document.body.style.cursor = "wait";

    const titleInput = document.getElementById("title");
    const descInput = document.getElementById("description");
    const checkbox = document.getElementById("is_public");

    const data = {
      title: titleInput.value.trim(),
      description: descInput.value.trim(),
      is_public: checkbox.checked
    }

    try {
      const res = await postThing(`/api/edit_record/${recordId}`, data);


      const imagesInput = document.getElementById("image");
      if (imagesInput.files.length) {
        if (imagesInput.files.length > 1) {
          // multiple
          await Promise.all(
            Array.from(imagesInput.files).map(async (file) => {
              const newImage = await uploadImage(file);

              // create new record image
              await postThing(`/api/add_record_image`, {
                record_id: recordId,
                image_id: newImage.id
              })
            })
          );
        } else {
          const newImage = await uploadImage(imagesInput.files[0]);
          // create new record image
          await postThing(`/api/add_record_image`, {
            record_id: recordId,
            image_id: newImage.id
          })
        }
      }

      toast.show("Saved");
      e.target.disabled = false;
      document.body.style.cursor = "default";
      if (projectId) {
        window.location.href = `/record?id=${recordId}&project_id=${projectId}`;
      } else {
        window.location.href = `/record?id=${recordId}`;
      }
    } catch (error) {
      console.log(error);
      window.alert(error);
      e.target.disabled = false;
      document.body.style.cursor = "default";
    }
  })

  async function uploadImage(file) {
    // if its for a wyrld or public
    if (projectId) {
      const newImage = await uploadProjectImage(file, projectId, false);
      if (newImage) {
        // create new table image
        await postThing(`/api/add_table_image_by_project`, {
          project_id: projectId,
          image_id: newImage.id,
          folder_id: null
        });
        return newImage;
      }
    } else {
      const newImage = await uploadUserImage(file, false);
      if (newImage) {
        // create new table image
        await postThing(`/api/add_table_image_by_user`, {
          image_id: newImage.id,
          folder_id: null
        });
        return newImage;
      }
    }
  }

  // remove image handlers
  document.querySelectorAll("[data-remove-image]").forEach(elem => {
    elem.addEventListener("click", async e => {
      e.preventDefault();
      const imageId = e.currentTarget.dataset.removeImage;
      console.log("Remove image:", imageId);
      e.currentTarget.parentElement.remove();
      await deleteThing(`/api/remove_record_image_by_image/${imageId}`);
    });
  });
</script>

</html>