<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Dash</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/searchDashElements.js" defer></script>
  <script src="/components/modal.js" type="module"></script>
  <script src="/lib/newResourceModals.js" type="module"></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <% const formatDate = (value) => value ? new Date(value).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A"; %>
  <div class="mt-5 px-2 dashboard-shell">
    <aside class="dashboard-sidebar">
      <div class="dashboard-sidebar-card">
        <div class="dashboard-sidebar-title">Dashboard</div>
        <div class="dashboard-nav">
          <a class="dashboard-nav-link <%= section === 'overview' ? 'active' : '' %>" href="/dash">Overview</a>
          <a class="dashboard-nav-link <%= section === 'tables' ? 'active' : '' %>" href="/dash/tables">Tables</a>
          <a class="dashboard-nav-link <%= section === 'records' ? 'active' : '' %>" href="/dash/records">Records</a>
          <a class="dashboard-nav-link <%= section === 'sheets' ? 'active' : '' %>" href="/dash/sheets">Character Sheets</a>
          <a class="dashboard-nav-link <%= section === 'wyrlds' ? 'active' : '' %>" href="/dash/wyrlds">Wyrlds</a>
        </div>
      </div>
      <div class="dashboard-sidebar-card dashboard-sidebar-card-spaced library-card">
        <div class="dashboard-sidebar-title">Image Library</div>
        <small>Browse, organize, and manage all your uploaded images in one place.</small>
        <a class="library-link" href="/library">
          <span class="library-link-text">Open Library</span>
          <span class="library-link-count"><%= imageCount %> images</span>
          <span class="library-link-arrow">&rarr;</span>
        </a>
      </div>
      <div class="dashboard-sidebar-card dashboard-sidebar-card-spaced radio-card">
        <div class="dashboard-sidebar-title">FRC Radio</div>
        <small>Stream background music for your tabletop sessions.</small>
        <a class="radio-link" href="https://radio.farreachco.com" target="_blank" rel="noopener">
          <span class="radio-link-text">Host a Channel</span>
          <span class="radio-link-icon">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
            </svg>
          </span>
          <span class="radio-link-arrow">&rarr;</span>
        </a>
      </div>
    </aside>
    <main class="dashboard-main">
      <% if (section === 'overview') { %>
      <div class="dashboard-highlights">
        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Tables</h2>
            <a href="/dash/tables">View all</a>
          </div>
          <small>Virtual tables you have created.</small>
          <div class="dashboard-list">
            <% if (recentTables.length === 0) { %>
            <small>No tables yet...</small>
            <% } else { %>
            <% recentTables.forEach(function(table) { %>
            <div class="dash-detail-row" onclick="handleTableClick('<%= table.uuid %>')" title="Open table in new tab">
              <div class="dash-detail-title"><%= table.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Records</h2>
            <a href="/dash/records">View all</a>
          </div>
          <small>Notes, lore, and stat blocks.</small>
          <div class="dashboard-list">
            <% if (recentRecords.length === 0) { %>
            <small>No records yet...</small>
            <% } else { %>
            <% recentRecords.forEach(function(record) { %>
            <div class="dash-detail-row" onclick="handleRecordClick('<%= record.id %>')" title="Open record in new tab">
              <div class="dash-detail-title"><%= record.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Character Sheets</h2>
            <a href="/dash/sheets">View all</a>
          </div>
          <small>Player characters created or shared with you.</small>
          <div class="dashboard-list">
            <% if (recentSheets.length === 0) { %>
            <small>No sheets yet...</small>
            <% } else { %>
            <% recentSheets.forEach(function(sheet) { %>
            <div class="dash-detail-row" onclick="handleSheetClick('<%= sheet.id %>')" title="Open character sheet in new tab">
              <div class="dash-detail-title"><%= sheet.name %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>

        <section class="dashboard-card">
          <div class="dashboard-card-header">
            <h2>Recent Wyrlds</h2>
            <a href="/dash/wyrlds">View all</a>
          </div>
          <small>Campaign spaces you created or joined.</small>
          <div class="dashboard-list">
            <% if (recentWyrlds.length === 0) { %>
            <small>No Wyrlds yet...</small>
            <% } else { %>
            <% recentWyrlds.forEach(function(project) { %>
            <div class="dash-detail-row" onclick="handleWyrldClick('<%= project.id %>')" title="Open wyrld dashboard">
              <div class="dash-detail-title"><%= project.title %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </section>
      </div>
      <% } %>

      <% if (section === 'tables') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Tables</h2>
          <a onclick="openNewTableModal()" title="Create a new virtual table" style="cursor:pointer">+ New Table</a>
        </div>
        <small>Real-time virtual tables that support images and drawing. Invite others to join your table by copying the share link.</small>
        <small class="d-block mt-1"><a href="/sandbox-mode-guide">Sandbox Mode Guide</a></small>
        <hr />
        <% if (tablesSorted.length === 0) { %>
        <small>No tables yet...</small>
        <% } else { %>
        <input id="search-table-elements-input" type="text" placeholder="Search Tables">
        <br>
        <div id="table-elements-list" class="dashboard-list">
          <% tablesSorted.forEach(function(table) { %>
          <div class="dash-detail-row" onclick="handleTableClick('<%= table.uuid %>')" title="Open table in new tab">
            <div class="dash-detail-title"><%= table.title %></div>
            <div class="dash-detail-meta"><%= table.mode === 'sandbox' ? 'Sandbox' : 'Standard' %> - <%= table.is_public ? 'Public' : 'Private' %> - <%= formatDate(table.date_created) %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'records') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Records</h2>
          <a href="/newrecord" title="Create a new record">+ New Record</a>
        </div>
        <small>Resource pages for lore, notes, monster stat blocks and other useful data.</small>
        <hr />
        <% if (recordsSorted.length === 0) { %>
        <small>No records yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% recordsSorted.forEach(function(record) { %>
          <div class="dash-detail-row" onclick="handleRecordClick('<%= record.id %>')" title="Open record in new tab">
            <div class="dash-detail-title"><%= record.title %></div>
            <div class="dash-detail-meta"><%= record.is_public ? 'Public' : 'Private' %> - <%= formatDate(record.created_at) %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'sheets') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Player Character Sheets</h2>
          <a onclick="openNewSheetModal()" title="Create a new player character sheet" style="cursor:pointer">+ New Sheet</a>
        </div>
        <small>We currently offer Dungeons and Dragons 5e sheets. You can invite others to view/edit your character sheet from the settings tab.</small>
        <hr />
        <h3>Created</h3>
        <% if (sheetsSorted.length === 0) { %>
        <small>No sheets yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% sheetsSorted.forEach(function(sheet) { %>
          <div class="dash-detail-row" onclick="handleSheetClick('<%= sheet.id %>')" title="Open character sheet in new tab">
            <div class="dash-detail-title"><%= sheet.name %></div>
            <div class="dash-detail-meta"><%= sheet.class || 'Class TBD' %> - Level <%= sheet.level ?? 'N/A' %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
        <h3>Shared With You</h3>
        <% if (sharedSheetsSorted.length === 0) { %>
        <small>No shared sheets yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% sharedSheetsSorted.forEach(function(sheet) { %>
          <div class="dash-detail-row" onclick="handleSheetClick('<%= sheet.id %>')" title="Open character sheet in new tab">
            <div class="dash-detail-title"><%= sheet.name %></div>
            <div class="dash-detail-meta"><%= sheet.class || 'Class TBD' %> - Level <%= sheet.level ?? 'N/A' %></div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>

      <% if (section === 'wyrlds') { %>
      <section class="dashboard-card">
        <div class="dashboard-card-header">
          <h2>Wyrlds</h2>
          <a onclick="openNewWyrldModal()" title="Create a new wyrld" style="cursor:pointer">+ Wyrld</a>
        </div>
        <small>A Wyrld is a contained environment that associates tables and character sheets to create a more organized experience.</small>
        <small class="d-block mt-1"><a href="/wyrlds/public">Browse Public Wyrlds</a></small>
        <hr />
        <h3>Created</h3>
        <% if (projectsSorted.length === 0) { %>
        <small>No Wyrlds yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% projectsSorted.forEach(function(project) { %>
          <div class="dash-detail-row" onclick="handleWyrldClick('<%= project.id %>')" title="Open wyrld dashboard">
            <div class="dash-detail-title"><%= project.title %></div>
            <div class="dash-detail-actions">
              <button class="dash-inline-action" type="button" onclick="event.stopPropagation(); handleWyrldSettingsClick('<%= project.id %>')">Settings</button>
              <div class="dash-detail-meta">Created <%= formatDate(project.date_created) %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
        <h3>Shared</h3>
        <% if (sharedProjectsSorted.length === 0) { %>
        <small>No Shared Wyrlds yet...</small>
        <% } else { %>
        <div class="dashboard-list">
          <% sharedProjectsSorted.forEach(function(project) { %>
          <div class="dash-detail-row" onclick="handleWyrldClick('<%= project.id %>')" title="Open wyrld dashboard">
            <div class="dash-detail-title"><%= project.title %></div>
            <div class="dash-detail-actions">
              <button class="dash-inline-action" type="button" onclick="event.stopPropagation(); handleSharedWyrldSettingsClick('<%= project.id %>')">Settings</button>
              <div class="dash-detail-meta">Created <%= formatDate(project.date_created) %></div>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>
      </section>
      <% } %>
    </main>
  </div>
</body>
<script>
  function handleSheetClick(id) {
    window.open(`/5eplayer?id=${id}`, "_blank").focus();
  }

  function handleTableClick(uuid) {
    window.open(`/vtt?uuid=${uuid}`, "_blank").focus();
  }

  function handleRecordClick(id) {
    window.open(`/record?id=${id}`, "_blank").focus();
  }

  function handleWyrldClick(id) {
    window.location.href = `/wyrld?id=${id}`;
  }

  function handleWyrldSettingsClick(id) {
    window.location.href = `/wyrld/settings?id=${id}`;
  }

  function handleSharedWyrldSettingsClick(id) {
    window.location.href = `/wyrld/settings?id=${id}`;
  }
</script>

</html>
