<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Dash</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/searchDashElements.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="mt-5 d-flex flex-wrap px-2">
    <div class="d-flex flex-column p-3 dash-column">
      <h2>Tables</h2>
      <small>Real-time virtual tables that support images and drawing. Invite others to
        join your table by copying the share link. Get started by using our <a href="/resources#free-assets">free asset pack</a>.</small>
      <a href="/newtable" title="Create a new virtual table">+ New Table</a>
      <hr />
      <% if (tables.length === 0) { %>
      <small>No tables yet...</small>
      <% } else { %>
      <input id="search-table-elements-input" type="text" placeholder="Search Tables">
      <br>
      <div id="table-elements-list">
        <% tables.forEach(function(table) { %>
        <div class="d-flex justify-content-between dash-list-title-container" onclick="handleTableClick('<%= table.uuid %>')" title="Open table in new tab">
          <div class="dash-list-title"><%= table.title %></div>
          <span>↗</span>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
    <div class="d-flex flex-column p-3 dash-column">
      <h2>Records</h2>
      <small>Resource pages which you can use for lore, notes, monster stat blocks and other useful data. By connecting or uploading images you can view this data on a virtual table from the sidebar.</small>
      <a href="/newrecord" title="Create a new record">+ New Record</a>
      <hr />
      <% if (records.length === 0) { %>
      <small>No records yet...</small>
      <% } else { %>
      <% records.forEach(function(record) { %>
      <div class="d-flex justify-content-between dash-list-title-container" onclick="handleRecordClick('<%= record.id %>')" title="Open record in new tab">
        <div class="dash-list-title"><%= record.title %></div>
        <span>↗</span>
      </div>
      <% }); %>
      <% } %>
    </div>
    <div class="d-flex flex-column p-3 dash-column">
      <h2>Player Character Sheets</h2>
      <small>We currently offer Dungeons and Dragons 5e sheets. You can invite
        others to view/edit your character sheet from the settings tab.</small>
      <a href="/newsheet" title="Create a new player character sheet">+ New Sheet</a>
      <hr />
      <h3>Created</h3>
      <% if (sheets.length === 0) { %>
      <small>No sheets yet...</small>
      <% } else { %> <% sheets.forEach(function(sheet) { %>
      <div class="d-flex justify-content-between dash-list-title-container" onclick="handleSheetClick('<%= sheet.id %>')" title="Open character sheet in new tab">
        <div class="dash-list-title"><%= sheet.name %></div>
        <span>↗</span>
      </div>
      <% }); %> <% } %>
      <h3>Shared With You</h3>
      <% if (sharedSheets.length === 0) { %>
      <small>No shared sheets yet...</small>
      <% } else { %> <% sharedSheets.forEach(function(sheet) { %>
      <div class="d-flex justify-content-between dash-list-title-container" onclick="handleSheetClick('<%= sheet.id %>')" title="Open character sheet in new tab">
        <div class="dash-list-title"><%= sheet.name %></div>
        <span>↗</span>
      </div>
      <% }); %> <% } %>
    </div>
    <div class="d-flex flex-column p-3 dash-column">
      <h2>Wyrlds</h2>
      <small>A Wyrld is a contained environment that associates tables and
        character sheets to create a more organized experience.
        <ul>
          <li>Add users with invite links.</li>
          <li>Link player character sheets.</li>
          <li>Allow users to manage tables.</li>
          <li>Create customized calendars.</li>
        </ul>
      </small>
      <a href="/newwyrld" title="Create a new wyrld">+ Wyrld</a>
      <hr />
      <h3>Created</h3>
      <% if (projects.length === 0) { %>
      <small>No Wyrlds yet...</small>
      <% } else { %> <% projects.forEach(function(project) { %>
      <div class="d-flex align-items-center">
        <img class="icon gear me-2" src="/assets/gears.svg" alt="" title="Open wyrld settings" onclick="handleWyrldSettingsClick('<%= project.id %>')" />
        <div class="d-flex justify-content-between dash-list-title-container flex-1" onclick="handleWyrldClick('<%= project.id %>')" title="Open wyrld dashboard">
          <div class="dash-list-title"><%= project.title %></div>
          <span>→</span>
        </div>
      </div>
      <% }); %> <% } %>
      <h3>Shared</h3>
      <% if (sharedProjects.length === 0) { %>
      <small>No Shared Wyrlds yet...</small>
      <% } else { %> <% sharedProjects.forEach(function(project) { %>
      <div class="d-flex align-items-center">
        <img class="icon gear me-2" src="/assets/gears.svg" alt="" title="Open wyrld settings" onclick="handleSharedWyrldSettingsClick('<%= project.id %>')" />
        <div class="d-flex justify-content-between dash-list-title-container flex-1" onclick="handleWyrldClick('<%= project.id %>')" title="Open wyrld dashboard">
          <div class="dash-list-title"><%= project.title %></div>
          <span>→</span>
        </div>
      </div>
      <% }); %> <% } %>
    </div>
  </div>
</body>
<script>
  function handleSheetClick(id) {
    window.open(`/5eplayer?id=${id}`, "_blank").focus();
  }

  function handleTableClick(uuid) {
    window.open(`/vtt?uuid=${uuid}`, "_blank").focus();
  }

  function handleRecordClick(id) {
    window.open(`/record?id=${id}`, "_blank").focus();
  }

  function handleWyrldClick(id) {
    window.location.href = `/wyrld?id=${id}`;
  }

  function handleWyrldSettingsClick(id) {
    window.location.href = `/wyrldsettings?id=${id}`;
  }

  function handleSharedWyrldSettingsClick(id) {
    window.location.href = `/sharedwyrldsettings?id=${id}`;
  }
</script>

</html>