  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
          "@type": "Question",
          "name": "How do I find online DnD campaigns to join?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browse Public Wyrlds, read each campaign summary and featured onboarding record, then request to join campaigns that match your style."
          }
        },
        {
          "@type": "Question",
          "name": "Can beginners play Dungeons and Dragons online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. New players can join beginner-friendly campaigns by reading campaign expectations, sending a short intro request, and starting with session-zero focused groups."
          }
        },
        {
          "@type": "Question",
          "name": "Can I run my own online DnD campaign as a DM or GM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Create a Wyrld, publish a public listing, set join mode and capacity, and manage your campaign with tables, records, discussion threads, and linked character sheets."
          }
        }
      ]
    }
  </script>
