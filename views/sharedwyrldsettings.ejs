<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Wyrld Settings</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container page-form p-3">
    <h1>Wyrld Settings</h1>
    <small>Manage important settings for your wyrld.</small>

    <div class="form-section" style="margin-top: var(--space-xl);">
      <h2 class="text-green"><%= project.title %></h2>
      <button class="btn-red mt-3" onclick="removeProjectUser('<%= projectUserId %>')">
        Leave Wyrld
      </button>
    </div>
  </div>
  <%- include('./partials/footer') %>
  <script>
    async function removeProjectUser(id) {
      const confirmed = await window.customConfirm(
        "Are you sure you want to leave <%= project.title %>?",
        { confirmText: "Leave Wyrld", danger: true },
      );
      if (!confirmed) return;

      await fetch(`/api/remove_project_user/${id}`, {
        method: "DELETE",
      });
      window.location.href = "/dash";
    }
  </script>
</body>

</html>
