  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do my players need accounts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Only the host needs to sign in."
      }
    },
    {
      "@type": "Question",
      "name": "Does the music stop if I close the host panel?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Streaming continues while listeners are connected. The stream goes idle after ten minutes without listeners."
      }
    },
    {
      "@type": "Question",
      "name": "Can someone else take over the music?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Another signed-in user can open the host panel using the same channel name and control playback."
      }
