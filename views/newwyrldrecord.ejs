<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Create Wyrld Record</title>
  <link rel="stylesheet" href="/style.css" />
  <link rel="stylesheet" href="/css/features/record.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container page-form p-3">
    <h1 class="record-form-title">Create Wyrld Record</h1>

    <fieldset>
      <div class="input-container">
        <label for="title">Title</label>
        <input id="title" name="title" placeholder="Record Title" required />
      </div>

      <div class="input-container">
        <label for="description">Description</label>
        <textarea id="description" name="description" required></textarea>
      </div>

      <div class="form-section">
        <small><b class="text-orange">Upload Images</b></small>
        <small class="hint">*These will also be available for use on your tables</small>
        <input id="image" name="image" class="file-input-hidden" type="file" accept="image/*" multiple>
        <label for="image" class="label-btn mt-2" title="Upload Image">Choose Images</label>
        <div class="d-flex flex-column mt-1" id="files-list"></div>
      </div>

      <div class="form-section">
        <div class="d-flex align-items-center gap-2">
          <input id="is_public" type="checkbox" name="is_public" />
          <div>
            <small><b class="text-orange">Make Public</b></small>
            <small class="hint">*Allow this page to be viewed by anyone in your wyrld.</small>
          </div>
        </div>
      </div>

      <button id="create">Create</button>
    </fieldset>
  </div>
</body>
<script type="module">
  import createElement from "/lib/salt-lib/createElement.js";
  import {
    apiPost
  } from "/lib/apiUtils.js";
  import { handleApiFailure } from "/lib/apiUiFeedback.js";
  import {
    uploadProjectImage
  } from "/lib/imageUtils.js";

  const searchParams = new URLSearchParams(window.location.search);
  const projectId = searchParams.get("id");

  // image event listener
  document.getElementById("image").addEventListener("change", async (e) => {
    if (e.target.files.length) {
      const filesListElem = document.getElementById("files-list");
      const fileNameElemList = [];
      for (const file of e.target.files) {
        const fileNameElem = createElement("small", {}, `- ${file.name}`);
        fileNameElemList.push(fileNameElem)
      }
      filesListElem.append(...fileNameElemList)
    }
  })

  // create event listen
  document.getElementById("create").addEventListener("click", async (e) => {
    e.preventDefault();

    // loading state
    e.target.disabled = true;
    document.body.style.cursor = "wait";

    const titleInput = document.getElementById("title");
    const descInput = document.getElementById("description");
    const checkbox = document.getElementById("is_public");

    const data = {
      title: titleInput.value.trim(),
      description: descInput.value.trim(),
      is_public: checkbox.checked
    }

    function throwHandled(result, fallbackMessage) {
      const handled = handleApiFailure(result, {
        fallbackMessage,
        includeResultMessage: true,
      });
      const err = new Error(result?.error || fallbackMessage);
      err.handled = handled;
      throw err;
    }

    try {
      // create a new record
      const newRecordResult = await apiPost(`/api/add_record_by_project/${projectId}`, data);
      if (!newRecordResult.ok || !newRecordResult.data) {
        throwHandled(newRecordResult, "Failed to create record");
      }
      const newRecord = newRecordResult.data;

      // upload images
      const imagesInput = document.getElementById("image");
      if (imagesInput.files.length) {
        if (imagesInput.files.length > 1) {
          // multiple
          await Promise.all(
            Array.from(imagesInput.files).map(async (file) => {
              const newImage = await uploadImage(file);
              if (!newImage) return;

              // create new record image
              const recordImageResult = await apiPost(`/api/add_record_image`, {
                record_id: newRecord.id,
                image_id: newImage.id
              });
              if (!recordImageResult.ok) {
                throwHandled(recordImageResult, "Failed to attach image");
              }
            })
          );
        } else {
          const newImage = await uploadImage(imagesInput.files[0]);
          if (!newImage) {
            throw new Error("Failed to upload image");
          }
          // create new record image
          const recordImageResult = await apiPost(`/api/add_record_image`, {
            record_id: newRecord.id,
            image_id: newImage.id
          });
          if (!recordImageResult.ok) {
            throwHandled(recordImageResult, "Failed to attach image");
          }
        }
      }

      window.location.href = `/wyrld?id=${projectId}`
    } catch (error) {
      console.log(error)
      if (!error?.handled) {
        window.customAlertError(
          error && error.message ? error.message : "Failed to create record",
        );
      }
      e.target.disabled = false;
      document.body.style.cursor = "default";
    }

  })

  async function uploadImage(file) {
    const newImage = await uploadProjectImage(file, projectId, false);
    if (newImage) {
      // create new table image
      const tableImageResult = await apiPost(`/api/add_table_image_by_project`, {
        project_id: projectId,
        image_id: newImage.id,
        folder_id: null
      });
      if (!tableImageResult.ok) {
        handleApiFailure(tableImageResult, {
          fallbackMessage: "Failed to attach uploaded image to library",
          includeResultMessage: true,
        });
        return null;
      }
      return newImage;
    }
    return null;
  }
</script>

</html>
