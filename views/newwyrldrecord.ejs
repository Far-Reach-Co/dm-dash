<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Create Wyrld Record</title>
  <link rel="stylesheet" href="/style.css" />
  <%- include('./partials/icons') %>
  <script src="/lib/MobileNavHandler.js" defer></script>
  <script src="/lib/htmx.min.js"></script>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="container-fluid info-container p-3">
    <h1>Create Wyrld Record</h1>
    <br>
    <br>
    <div class="input-container">
      <label for="title">Title</label>
      <input id="title" name="title" placeholder="Record Title" required />
    </div>
    <br />
    <div class="input-container w-100">
      <label for="description">Description</label>
      <textarea class="w-100" id="description" name="description" required></textarea>
    </div>
    <br />
    <div class="w-25">
      <small><b class="text-orange">Upload Images</b></small>
      <br />
      <small class="hint">*These will also be available for use on your tables</small>
      <br />
      <input id="image" name="image" type="file" accept="image/*" style="display: none" multiple>
      <label for="image" class="label-btn" title="Upload Image">Choose Images</label>
      <div class="d-flex flex-column" id="files-list"></div>
    </div>
    <br />
    <div class="w-25">
      <small><b class="text-orange">Make Public</b></small>
      <br />
      <small class="hint">*Allow this page to viewed by anyone others in your wyrld.</small>
      <input id="is_public" type="checkbox" name="is_public" />
    </div>
    <br />
    <br />
    <button id="create">Create</button>
  </div>
</body>
<script type="module">
  import createElement from "/components/createElement.js";
  import {
    postThing
  } from "/lib/apiUtils.js";
  import {
    uploadProjectImage
  } from "/lib/imageUtils.js";

  const searchParams = new URLSearchParams(window.location.search);
  const projectId = searchParams.get("id");

  // image event listener
  document.getElementById("image").addEventListener("change", async (e) => {
    if (e.target.files.length) {
      const filesListElem = document.getElementById("files-list");
      const fileNameElemList = [];
      for (const file of e.target.files) {
        const fileNameElem = createElement("small", {}, `- ${file.name}`);
        fileNameElemList.push(fileNameElem)
      }
      filesListElem.append(...fileNameElemList)
    }
  })

  // create event listen
  document.getElementById("create").addEventListener("click", async (e) => {
    e.preventDefault();

    // loading state
    e.target.disabled = true;
    document.body.style.cursor = "wait";

    const titleInput = document.getElementById("title");
    const descInput = document.getElementById("description");
    const checkbox = document.getElementById("is_public");

    const data = {
      title: titleInput.value.trim(),
      description: descInput.value.trim(),
      is_public: checkbox.checked
    }

    try {
      // create a new record
      const newRecord = await postThing(`/api/add_record_by_project/${projectId}`, data);

      // upload images
      const imagesInput = document.getElementById("image");
      if (imagesInput.files.length) {
        if (imagesInput.files.length > 1) {
          // multiple
          await Promise.all(
            Array.from(imagesInput.files).map(async (file) => {
              const newImage = await uploadImage(file);

              // create new record image
              await postThing(`/api/add_record_image`, {
                record_id: newRecord.id,
                image_id: newImage.id
              })
            })
          );
        } else {
          const newImage = await uploadImage(imagesInput.files[0]);
          // create new record image
          await postThing(`/api/add_record_image`, {
            record_id: newRecord.id,
            image_id: newImage.id
          })
        }
      }

      window.location.href = `/wyrld?id=${projectId}`
    } catch (error) {
      console.log(error)
      e.target.disabled = false;
      document.body.style.cursor = "default";
    }

  })

  async function uploadImage(file) {
    const newImage = await uploadProjectImage(file, projectId, false);
    if (newImage) {
      // create new table image
      await postThing(`/api/add_table_image_by_project`, {
        project_id: projectId,
        image_id: newImage.id,
        folder_id: null
      });
      return newImage;
    }
  }
</script>

</html>