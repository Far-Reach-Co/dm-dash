<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Affiliate Admin | Far Reach Co.</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <% function formatAdminDate(value) { %>
  <% if (!value) { %>
  <% return "N/A"; %>
  <% } %>
  <% const date = new Date(value); %>
  <% if (Number.isNaN(date.getTime())) { %>
  <% return String(value); %>
  <% } %>
  <% return date.toISOString().replace("T", " ").replace("Z", " UTC"); %>
  <% } %>
  <div class="account-card affiliate-admin-card">
    <h1 class="account-title">Affiliate Admin</h1>

    <div class="form-section">
      <small>Allowed admins only. Current user: <%= adminUser.email %></small>
      <small class="d-block mt-1"><a href="/account">Back to Account</a></small>
      <% if (status === "code_created") { %>
      <small class="success-message d-block mt-2">Affiliate code created.</small>
      <% } %>
      <% if (status === "code_enabled") { %>
      <small class="success-message d-block mt-2">Affiliate code enabled.</small>
      <% } %>
      <% if (status === "code_disabled") { %>
      <small class="success-message d-block mt-2">Affiliate code disabled.</small>
      <% } %>
      <% if (status === "commission_paid") { %>
      <small class="success-message d-block mt-2">Commission marked as paid.</small>
      <% } %>
    </div>

    <div class="form-section">
      <h2>Create Affiliate Code</h2>
      <form method="post" action="/api/admin/affiliates/codes">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="input-container">
          <h3>Code</h3>
          <input type="text" name="code" required maxlength="32" placeholder="JANE5" />
          <small class="d-block mt-1">Format: uppercase letters, numbers, underscore, dash (3-32 chars).</small>
        </div>
        <div class="input-container mt-2">
          <h3>Collaborator</h3>
          <input type="text" name="collaborator_name" required maxlength="255" placeholder="Jane Doe" />
        </div>
        <div class="input-container mt-2">
          <h3>Notes</h3>
          <textarea name="notes" rows="3" maxlength="2000" placeholder="Optional notes"></textarea>
        </div>
        <div class="form-actions mt-2">
          <button type="submit">Create Code</button>
        </div>
      </form>
    </div>

    <div class="form-section">
      <h2>Affiliate Codes</h2>
      <% if (!codes.length) { %>
      <small>No affiliate codes yet.</small>
      <% } else { %>
      <% codes.forEach(function(code) { %>
      <% const referralPath = "/checkout?ref=" + encodeURIComponent(code.code); %>
      <div class="status-row">
        <h3><%= code.code %></h3>
        <p><%= code.collaborator_name %> · <%= code.is_active ? "Active" : "Disabled" %></p>
      </div>
      <small class="d-block">Referral link: <a href="<%= referralPath %>" target="_blank" rel="noopener noreferrer"><%= publicBaseUrl %><%= referralPath %></a></small>
      <small class="d-block">Pending payout: $<%= ((pendingByCode[code.id] || 0) / 100).toFixed(2) %></small>
      <% if (code.notes) { %>
      <small class="d-block"><%= code.notes %></small>
      <% } %>
      <form method="post" action="/api/admin/affiliates/codes/<%= code.id %>/toggle" class="mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="is_active" value="<%= code.is_active ? 'false' : 'true' %>" />
        <button type="submit"><%= code.is_active ? "Disable Code" : "Enable Code" %></button>
      </form>
      <hr />
      <% }); %>
      <% } %>
    </div>

    <div class="form-section">
      <h2>Commissions</h2>
      <% if (!commissions.length) { %>
      <small>No commission records yet.</small>
      <% } else { %>
      <% commissions.forEach(function(commission) { %>
      <% const scopeLabel = commission.scope === "project" ? "Pro Wyrld" : "Pro User"; %>
      <% const commissionTypeLabel = commission.scope === "project" ? "One-time Pro Wyrld signup" : "One-time Pro User signup"; %>
      <div class="status-row">
        <h3><%= commission.affiliate_code %></h3>
        <p>$<%= (commission.amount_cents / 100).toFixed(2) %> · <%= commission.status.toUpperCase() %></p>
      </div>
      <small class="d-block">Commission ID: <%= commission.id %></small>
      <small class="d-block">Collaborator: <%= commission.collaborator_name %></small>
      <small class="d-block">Type: <%= commissionTypeLabel %></small>
      <small class="d-block">Buyer: <%= commission.buyer_username || ("User #" + commission.user_id) %></small>
      <small class="d-block">Scope: <%= scopeLabel %><%= commission.project_title ? " (" + commission.project_title + ")" : "" %></small>
      <small class="d-block">Created: <%= formatAdminDate(commission.created_at) %></small>
      <small class="d-block">Updated: <%= formatAdminDate(commission.updated_at) %></small>
      <% if (commission.paid_at) { %>
      <small class="d-block">Paid: <%= formatAdminDate(commission.paid_at) %></small>
      <% } %>
      <small class="d-block">Subscription: <%= commission.stripe_subscription_id %></small>
      <% if (commission.stripe_invoice_id) { %>
      <small class="d-block">Invoice: <%= commission.stripe_invoice_id %></small>
      <% } %>
      <% if (commission.status === "pending") { %>
      <form method="post" action="/api/admin/affiliates/commissions/<%= commission.id %>/pay" class="mt-1">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <textarea name="payout_note" rows="2" maxlength="2000" placeholder="Payout note (optional)"></textarea>
        <div class="form-actions mt-1">
          <button type="submit">Mark Paid</button>
        </div>
      </form>
      <% } else if (commission.payout_note) { %>
      <small class="d-block">Note: <%= commission.payout_note %></small>
      <% } %>
      <hr />
      <% }); %>
      <% } %>
    </div>
  </div>
  <%- include('./partials/footer') %>
</body>

</html>
