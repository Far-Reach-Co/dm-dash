<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Login</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="auth-card">
    <form id="login-form">
      <fieldset>
        <legend>Login</legend>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="input-container">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" placeholder="name@whatever.com" required />
        </div>
        <div class="input-container">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" placeholder="password" required />
        </div>
        <button type="submit">Login</button>
      </fieldset>
    </form>
    <div class="auth-links">
      <p>Don't have an account? <a id="register-link" href="/register">Register</a></p>
      <p>Forgot your password? <a href="/forgotpassword">Reset it</a></p>
    </div>
  </div>
  <%- include('./partials/footer') %>
</body>
<script>
  function isAllowedRedirect(url) {
    try {
      var parsed = new URL(url, window.location.origin);
      if (parsed.origin === window.location.origin) return true;
      if (parsed.hostname === "farreachco.com" || parsed.hostname.endsWith(".farreachco.com")) {
        return parsed.protocol === "https:";
      }
      return false;
    } catch (e) {
      return false;
    }
  }

  (function() {
    var params = new URLSearchParams(window.location.search);
    params.delete("_csrf");
    var qs = params.toString();
    if (qs) document.getElementById("register-link").href = "/register?" + qs;
  })();

  document.getElementById("login-form").addEventListener("submit", login);
  async function login(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const formProps = Object.fromEntries(formData);
    try {
      const res = await fetch(`/api/login`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify(formProps),
      });
      const resData = await res.json();
      if (res.status === 200) {
        if (resData.message) console.log(resData.message);
        var searchParams = new URLSearchParams(window.location.search);
        var inviteUUID = searchParams.get("invite");
        var redirectUrl = searchParams.get("redirect");
        if (inviteUUID) {
          return (window.location.pathname = "/invite");
        }
        if (redirectUrl && isAllowedRedirect(redirectUrl)) {
          return (window.location.href = redirectUrl);
        }
        window.location.pathname = "/dash";
      } else if (res.status === 400) {
        alert(resData.message);
      } else if (res.status === 403) {
        alert(resData.error.message);
      } else if (res.status === 429) {
        alert(resData.message);
      } else {
        throw resData.error;
      }
    } catch (err) {
      alert("Failed to login");
      console.log(err);
    }
  }
</script>

</html>
