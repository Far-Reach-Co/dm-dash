<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Far Reach Co. | Reset</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/lib/MobileNavHandler.js" defer></script>
  <%- include('./partials/icons') %>
</head>
<%- include('./partials/google') %>

<body>
  <%- include('./partials/nav') %>
  <div class="auth-card">
    <form id="reset-form">
      <fieldset>
        <legend>Reset Password</legend>
        <small>Please enter your new password</small>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="input-container" style="margin-top: var(--space-xl);">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" placeholder="password" required />
        </div>
        <button type="submit">Reset</button>
      </fieldset>
    </form>
    <div class="auth-links">
      <a href="/login"><small>Return to login</small></a>
    </div>
  </div>
  <%- include('./partials/footer') %>
</body>
<script>
  var searchParams = new URLSearchParams(window.location.search);
  let token = null;
  if (searchParams.get("token")) token = searchParams.get("token");

  document.getElementById("reset-form").addEventListener("submit", reset);
  async function reset(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const formProps = Object.fromEntries(formData);
    formProps.token = token;
    try {
      const res = await fetch(`/api/user/reset_password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formProps),
      });
      const resData = await res.json();
      if (res.status === 200) {
        window.customAlert("Password has been successfully updated!");
        window.location.pathname = "/account";
      } else if (res.status === 400) {
        window.customAlertError(resData.message);
      } else if (res.status === 403) {
        window.customAlertError(resData.error.message);
      } else {
        throw resData.error;
      }
    } catch (err) {
      window.customAlertError("Failed to reset password");
      console.log(err);
    }
  }
</script>

</html>
