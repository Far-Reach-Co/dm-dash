  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Far Reach Co. Virtual Tabletop",
      "url": "https://farreachco.com/simple-virtual-tabletop-no-player-accounts",
      "description": "Simple virtual tabletop with no player accounts required. Players join by link, no install, no signup. Persistent campaigns and free shared tabletop music.",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Invite-link joining with no player accounts required",
        "No install - runs in any browser",
        "Persistent campaign management",
        "Free shared tabletop music via Far Reach Radio"
      ],
      "author": {
        "@type": "Organization",
        "name": "Far Reach Co."
      }
    }
